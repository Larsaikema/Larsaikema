  },
  {
    "name": "Contact & bedrijf",
    "settings": [
      { "type": "paragraph", "content": "Deze gegevens verschijnen in de header, de footer, de contactpagina en in de structured data. Vul alleen in wat klopt." },
      { "type": "text", "id": "company_name", "label": "Bedrijfsnaam", "default": "Klapklaar" },
      { "type": "text", "id": "phone", "label": "Telefoon", "info": "Bv. 038 123 45 67. Leeg = niet tonen." },
      { "type": "text", "id": "whatsapp", "label": "WhatsApp-nummer", "info": "Internationaal zonder + en spaties, bv. 31612345678." },
      { "type": "text", "id": "email", "label": "E-mailadres", "default": "hallo@klapklaar.nl" },
      { "type": "text", "id": "kvk", "label": "KvK-nummer" },
      { "type": "text", "id": "btw_nummer", "label": "Btw-nummer" },
      { "type": "textarea", "id": "address", "label": "Adres" },
      { "type": "textarea", "id": "openingstijden", "label": "Openingstijden klantenservice", "default": "ma–vr 08:30–17:00\nza op afspraak" },
      { "type": "text", "id": "response_time", "label": "Reactietijd", "default": "We reageren binnen één werkdag." }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram", "info": "https://instagram.com/…" },
      { "type": "text", "id": "social_facebook", "label": "Facebook" },
      { "type": "text", "id": "social_linkedin", "label": "LinkedIn" },
      { "type": "text", "id": "social_youtube", "label": "YouTube" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok" },
      { "type": "text", "id": "social_pinterest", "label": "Pinterest" }
    ]
  },
  {
    "name": "Zakelijk",
    "settings": [
      { "type": "text", "id": "b2b_customer_tag", "label": "Klant-tag voor zakelijke klanten", "default": "zakelijk", "info": "Klanten met deze tag zien prijzen standaard excl. btw." },
      { "type": "checkbox", "id": "b2b_excl_first", "label": "Zakelijke klanten zien excl. btw eerst", "default": true },
