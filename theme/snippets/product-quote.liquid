{%- comment -%}
  Inline offerte form on the product page (feature product.quote-form): a {% form 'contact' %} with the product and the
  chosen variant prefilled (variant-picker.js keeps [data-quote-variant] in step), company, KvK and btw fields, delivery
  country (with the btw-verlegd note for EU companies abroad), quantity (default: the Zakelijk nudge quantity) and a delivery date. It sits in an accordion like the other tabs; the Zakelijk
  nudge links to it (#ProductQuote). After sending, the page reloads with the accordion open and the confirmation.
  Params: product, block, section_id, current_variant.
{%- endcomment -%}
{%- liquid
  assign quote_id = 'ProductQuote-' | append: section_id
  assign heading = block.settings.heading | default: 'Offerte voor dit product'
  assign variant_label = ''
  assign msg_required = 'forms.error_required' | t
  assign msg_email = 'forms.error_email' | t
  # the visible line leaves out options with one value: the size of '… Premium 3 × 3 m' is in the title already
  assign q_skip = ''
  assign q_parts = ''
  unless product.has_only_default_variant
    assign variant_label = current_variant.title
    for option in product.options_with_values
      if option.values.size == 1
        assign q_skip = q_skip | append: forloop.index0 | append: ','
      else
        assign q_parts = q_parts | append: current_variant.options[forloop.index0] | append: '|'
      endif
    endfor
  endunless
  assign q_text = q_parts | split: '|' | join: ' / '
-%}
{%- form 'contact', id: quote_id, class: 'pdp-quote', data-quote-form: '', data-msg-required: msg_required, data-msg-email: msg_email -%}
  {%- comment -%} contact[id]: only this form's own post opens it (the stock-alert form posts to /contact too) {%- endcomment -%}
  <input type="hidden" name="contact[id]" value="{{ quote_id }}">
  {%- assign quote_posted = false -%}
  {%- assign quote_ok = false -%}
  {%- assign quote_errors = false -%}
  {%- if form.id == quote_id -%}
    {%- if form.posted_successfully? -%}{%- assign quote_ok = true -%}{%- endif -%}
    {%- if form.errors -%}{%- assign quote_errors = true -%}{%- endif -%}
  {%- endif -%}
  {%- if quote_ok or quote_errors -%}{%- assign quote_posted = true -%}{%- endif -%}
  <details class="accordion product__tab pdp-quote__details" id="ProductQuote" {{ block.shopify_attributes }}{% if quote_posted %} open{% endif %}>
    <summary><span>{{ heading }}</span>{%- render 'icon', icon: 'plus' -%}</summary>
    <div class="accordion__body">
      {%- if quote_ok -%}
        <p class="notice notice--success" role="status" tabindex="-1" data-form-success>{%- render 'icon', icon: 'check' -%}<span><strong>{{ 'product.quote_success' | t }}</strong></span></p>
      {%- else -%}
        {%- if quote_errors -%}<div class="notice notice--error" role="alert">{%- render 'icon', icon: 'alert' -%}<span><strong>{{ 'forms.error_heading' | t }}</strong>{% render 'form-errors', form: form %}</span></div>{%- endif -%}
        {%- if block.settings.text != blank -%}<p class="text-sm muted">{{ block.settings.text }}</p>{%- endif -%}
        <input type="hidden" name="contact[Onderwerp]" value="{{ 'quote.subject_product' | t: title: product.title | escape }}">
        <input type="hidden" name="contact[Product]" value="{{ product.title | escape }}">
        <input type="hidden" name="contact[Uitvoering]" value="{{ variant_label | escape }}" data-quote-variant>
        <input type="hidden" name="contact[Productlink]" value="{{ shop.url }}{{ product.url }}">
        <p class="pdp-quote__product"><strong>{{ product.title | replace: ' x ', ' × ' }}</strong> <span data-quote-variant-text data-skip="{{ q_skip }}">{{ q_text | replace: ' x ', ' × ' }}</span></p>
        <div class="form-grid form-grid--2">
          <div class="field"><label class="field__label" for="PQ-qty-{{ section_id }}">{{ 'quote.line_qty' | t }} <span class="required" aria-hidden="true">*</span></label><input class="input" id="PQ-qty-{{ section_id }}" type="number" min="1" inputmode="numeric" name="contact[Aantal]" value="{{ settings.b2b_nudge_qty | default: 10 }}" required data-msg-required="{{ 'forms.error_required_qty' | t | escape }}"></div>
          <div class="field"><label class="field__label" for="PQ-date-{{ section_id }}">{{ 'quote.delivery_date' | t }}</label><input class="input" id="PQ-date-{{ section_id }}" type="date" name="contact[Gewenste leverdatum]"></div>
          <div class="field"><label class="field__label" for="PQ-company-{{ section_id }}">{{ 'forms.company' | t }}</label><input class="input" id="PQ-company-{{ section_id }}" name="contact[Bedrijfsnaam]" autocomplete="organization"></div>
          <div class="field"><label class="field__label" for="PQ-name-{{ section_id }}">{{ 'forms.contact_person' | t }} <span class="required" aria-hidden="true">*</span></label><input class="input" id="PQ-name-{{ section_id }}" name="contact[name]" autocomplete="name" required data-msg-required="{{ 'forms.error_required_name' | t | escape }}"></div>
          <div class="field"><label class="field__label" for="PQ-email-{{ section_id }}">{{ 'forms.email' | t }} <span class="required" aria-hidden="true">*</span></label><input class="input" id="PQ-email-{{ section_id }}" type="email" name="contact[email]" autocomplete="email" pattern="[^@\s]+@[^@\s]+\.[^@\s]+" required data-msg-required="{{ 'forms.error_required_email' | t | escape }}"></div>
          <div class="field"><label class="field__label" for="PQ-phone-{{ section_id }}">{{ 'forms.phone' | t }}</label><input class="input" id="PQ-phone-{{ section_id }}" type="tel" name="contact[phone]" autocomplete="tel"></div>
          <div class="field"><label class="field__label" for="PQ-kvk-{{ section_id }}">{{ 'forms.kvk' | t }}</label><input class="input" id="PQ-kvk-{{ section_id }}" name="contact[KvK-nummer]" inputmode="numeric"></div>
          <div class="field"><label class="field__label" for="PQ-btw-{{ section_id }}">{{ 'forms.btw' | t }}</label><input class="input" id="PQ-btw-{{ section_id }}" name="contact[Btw-nummer]"></div>
          {%- comment -%}
            Delivery country: the shop's markets (localization.available_countries, the visitor's own preselected) plus 'Ander
            land'. Outside the home country the note on btw verlegd (intracommunautaire levering, block setting vat_note, a claim
            in docs/claims-to-confirm.md) shows; CSS only (:has), so it costs no JS.
          {%- endcomment -%}
          {%- assign q_home = shop.address.country_code | default: 'NL' -%}
          <div class="field"><label class="field__label" for="PQ-country-{{ section_id }}">{{ 'forms.country' | t }}</label>
            <select class="select" id="PQ-country-{{ section_id }}" name="contact[Land]" autocomplete="country-name"{% if block.settings.vat_note != blank %} aria-describedby="PQ-vat-{{ section_id }}"{% endif %}>
              {%- for c in localization.available_countries -%}<option value="{{ c.name | escape }}"{% if c.iso_code == q_home %} data-home-country{% endif %}{% if c.iso_code == localization.country.iso_code %} selected{% endif %}>{{ c.name }}</option>{%- endfor -%}
              <option value="{{ 'forms.country_other' | t | escape }}">{{ 'forms.country_other' | t }}</option>
            </select>
          </div>
          {%- if block.settings.vat_note != blank -%}
            <p class="pdp-quote__vat" id="PQ-vat-{{ section_id }}">{%- render 'icon', icon: 'info', class: 'icon--sm' -%}<span>{{ block.settings.vat_note }}</span></p>
          {%- endif -%}
          <div class="field field--full"><label class="field__label" for="PQ-body-{{ section_id }}">{{ 'quote.notes' | t }}</label><textarea class="textarea" id="PQ-body-{{ section_id }}" name="contact[body]" rows="3" placeholder="{{ 'quote.notes_placeholder' | t | escape }}"></textarea></div>
        </div>
        <div class="form-actions"><button type="submit" class="btn">{{ 'quote.submit' | t }}</button></div>
        {%- if shop.privacy_policy -%}<p class="form-note">{{ 'forms.privacy_note_html' | t: url: shop.privacy_policy.url }}</p>{%- endif -%}
      {%- endif -%}
    </div>
  </details>
{%- endform -%}
