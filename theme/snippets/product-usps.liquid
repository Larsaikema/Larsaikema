{%- comment -%}
  USP checklist under the buy area: custom.usps (or the block's fallback lines), custom.garantie and the 'Past op' links
  (custom.past_op). Params: product, block, is_discontinued, avail_status, current_variant.
{%- endcomment -%}
{%- assign usps = product.metafields.custom.usps.value -%}
{%- assign past_op = product.metafields.custom.past_op.value -%}
{%- comment -%}
  The fallback list holds shop promises (levering, bedenktijd). They contradict 'Binnenkort leverbaar',
  'Permanent uitverkocht' or sold out, so they only show while the product can be ordered.
{%- endcomment -%}
{%- assign usp_fallback = block.settings.fallback -%}
{%- if product.available == false or is_discontinued or avail_status == 'binnenkort' -%}
  {%- assign usp_fallback = blank -%}
{%- endif -%}
{%- if usps != blank or usp_fallback != blank or past_op != blank or product.metafields.custom.garantie != blank -%}
  <div class="product__usps" {{ block.shopify_attributes }}>
    <ul class="checklist" role="list">
      {%- if usps != blank -%}
        {%- comment -%}
          A ticked line about something the box does not hold ('Zijwanden 3 × 3 m in dezelfde 7 kleuren' next to 'Niet
          inbegrepen: zijwanden') reads as included: lines that start with the first word of a custom.excluded item are
          left out here; 'Wat zit erin' and the add-ons already cover them.
        {%- endcomment -%}
        {%- assign u_skip = '' -%}
        {%- for x in product.metafields.custom.excluded.value -%}{%- assign xw = x | downcase | split: ' ' | first -%}{%- assign u_skip = u_skip | append: xw | append: '|' -%}{%- endfor -%}
        {%- assign u_skip = u_skip | split: '|' -%}
        {%- for u in usps -%}
          {%- assign uw = u | downcase | split: ' ' | first -%}
          {%- if u_skip contains uw -%}{%- continue -%}{%- endif -%}
          <li>{%- render 'icon', icon: 'check' -%}<span>{{ u }}</span></li>
        {%- endfor -%}
      {%- else -%}
        {%- assign fb = usp_fallback | newline_to_br | split: '<br />' -%}
        {%- for u in fb -%}{%- assign us = u | strip -%}{%- if us != blank -%}<li>{%- render 'icon', icon: 'check' -%}<span>{{ us }}</span></li>{%- endif -%}{%- endfor -%}
      {%- endif -%}
      {%- comment -%} a commercial guarantee comes on top of the statutory one (art. 7:6a BW): said so, linked to the garantie page {%- endcomment -%}
      {%- if product.metafields.custom.garantie != blank -%}
        {%- assign g_line = 'product.warranty_line' | t: text: product.metafields.custom.garantie.value -%}
        {%- assign g_head = g_line | split: ':' | first -%}
        <li>{%- render 'icon', icon: 'shield' -%}<span>{% if pages['garantie'].url != blank and g_head != g_line %}<a class="link" href="{{ pages['garantie'].url }}">{{ g_head }}</a>{{ g_line | remove_first: g_head }}{% else %}{{ g_line }}{% endif %}</span></li>
      {%- endif -%}
    </ul>
    {%- comment -%}
      Service under the buy area (brand 8.5): the bedenktijd (settings.return_days [claim]; not for print or maatwerk,
      which have their own notice) and the payment methods that are switched on in Shopify. Only while orderable. The
      icons' title ids get a 'pdp-' prefix: the footer shows the same icons, and ids must be unique (WCAG 4.1.1).
    {%- endcomment -%}
    {%- assign show_service = false -%}
    {%- assign sv = current_variant | default: product.selected_or_first_available_variant -%}
    {%- if usp_fallback != blank or usps != blank -%}{%- if sv.available and is_discontinued == false and avail_status != 'binnenkort' -%}{%- assign show_service = true -%}{%- endif -%}{%- endif -%}
    {%- comment -%} per variant (data-dynamic="service"): a sold-out variant shows no bedenktijd / payment row under its disabled button {%- endcomment -%}
    <div data-dynamic="service">
    {%- if show_service -%}
      {%- assign no_return = false -%}
      {%- if product.tags contains 'bedrukbaar' or product.metafields.custom.bedrukbaar.value == true or product.metafields.custom.maatwerk.value == true or product.metafields.custom.configurator != blank -%}{%- assign no_return = true -%}{%- endif -%}
      <div class="product__service">
        {%- if settings.return_days > 0 and no_return == false -%}
          <p class="product__service-line">{%- render 'icon', icon: 'return', class: 'icon--sm' -%}<span>{{ 'product.returns_short' | t: days: settings.return_days }}</span></p>
        {%- endif -%}
        {%- if shop.enabled_payment_types.size > 0 -%}
          <div class="product__pay">
            <span class="product__pay-label">{%- render 'icon', icon: 'lock', class: 'icon--sm' -%}{{ 'product.pay_secure' | t }}</span>
            <ul class="product__pay-list" role="list">{%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'payment-icon' | replace: 'id="pi-', 'id="pdp-pi-' | replace: 'aria-labelledby="pi-', 'aria-labelledby="pdp-pi-' }}</li>{%- endfor -%}</ul>
          </div>
        {%- endif -%}
        {%- comment -%}
          A person to ask, next to the button (brand 8.5): phone and WhatsApp from the theme settings when filled in, else
          the shop e-mail, with the reply time (settings.response_time). Never a number that is not set.
        {%- endcomment -%}
        {%- assign pu_phone = settings.phone -%}
        {%- assign pu_wa = settings.whatsapp | remove: '+' | remove: ' ' -%}
        {%- assign pu_mail = settings.email | default: shop.email -%}
        {%- if pu_phone != blank or pu_wa != blank or pu_mail != blank -%}
          <p class="product__service-line product__ask">
            {%- if pu_phone != blank or pu_wa != blank -%}{%- render 'icon', icon: 'phone', class: 'icon--sm' -%}{%- else -%}{%- render 'icon', icon: 'mail', class: 'icon--sm' -%}{%- endif -%}
            <span>{{ 'cart.help_question' | t }}
              {%- if pu_phone != blank %} <a class="link" href="{% render 'header-contact-href', number: pu_phone, type: 'tel' %}">{{ 'cart.help_call' | t: phone: pu_phone }}</a>{% endif -%}
              {%- if pu_wa != blank %}{% if pu_phone != blank %} {{ 'cart.help_or' | t }}{% endif %} <a class="link" href="{% render 'header-contact-href', number: pu_wa, type: 'wa' %}" target="_blank" rel="noopener">{{ 'cart.help_app' | t }}<span class="visually-hidden"> ({{ 'general.new_window' | t | downcase }})</span></a>{% endif -%}
              {%- if pu_phone == blank and pu_wa == blank %} <a class="link" href="mailto:{{ pu_mail }}">{{ 'cart.help_mail' | t: email: pu_mail }}</a>{% endif -%}
              {%- if settings.response_time != blank %} <span class="product__ask-time">{{ settings.response_time }}</span>{% endif -%}
            </span>
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}
    </div>
    {%- comment -%}
      'Past op': up to four products as small cards with their photo (a statafelrok names the three statafels it fits,
      which doubles as 'nog geen statafel?'); a part that fits many tents keeps the plain list of links.
    {%- endcomment -%}
    {%- if past_op != blank and past_op.size <= 4 -%}
      <style>.fits{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:12px 0 0;padding:0;list-style:none;font-size:13.5px;& a{display:flex;align-items:center;gap:8px;min-height:40px;padding:3px 10px 3px 3px;border:1px solid var(--pl);border-radius:var(--pri);background:var(--pw);font-weight:var(--p6);text-decoration:none;&:hover{border-color:var(--pi)}}& img{width:32px;height:32px;border-radius:5px}}</style>
      <ul class="fits" role="list" aria-label="{{ 'product.compatible' | t }}">
          <li aria-hidden="true"><strong>{{ 'product.compatible' | t }}:</strong></li>
          {%- for p in past_op -%}
            <li><a href="{{ p.url }}">{%- if p.featured_media -%}{{ p.featured_media.preview_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: '', widths: '40, 80', sizes: '40px' }}{%- endif -%}<span>{{ p.title | replace: ' x ', ' × ' }}</span></a></li>
          {%- endfor -%}
      </ul>
    {%- elsif past_op != blank -%}
      <p class="product__fits text-sm"><strong>{{ 'product.compatible' | t }}:</strong>{% for p in past_op %} <a class="link" href="{{ p.url }}">{{ p.title }}</a>{% unless forloop.last %},{% endunless %}{% endfor %}</p>
    {%- endif -%}
  </div>
{%- endif -%}
