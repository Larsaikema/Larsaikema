{%- comment -%} Lists form errors in Dutch. Params: form {%- endcomment -%}
<ul class="form-errors">
  {%- for field in form.errors -%}
    <li>{% if field == 'form' %}{{ form.errors.messages[field] }}{% elsif field == 'email' %}{{ 'forms.error_email' | t }}{% else %}{{ form.errors.translated_fields[field] | capitalize }}: {{ form.errors.messages[field] }}{% endif %}</li>
  {%- endfor -%}
</ul>
