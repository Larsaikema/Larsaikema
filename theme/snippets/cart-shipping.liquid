{%- comment -%}
  Shipping estimate for the cart (feature cart.shipping-excluded-note, with cart.highest-shipping-only): one shipment,
  and the highest shipping cost in the cart is what it costs. Per line that is the product's own cost
  (custom.verzendkosten_staffel at the line quantity and variant, catalog round 3; else custom.verzendkosten, the same override
  the product page shows, e.g. "€ 12,50" or "Verzendkosten op dit product: € 12,50"; "gratis" = 0) or else its class rate (theme settings shipping_cost_pakket / shipping_cost_pallet, incl.
  btw; custom.verzending = pallet or tag pallet). Parcels are free from free_shipping_threshold (only when the owner set
  one). Only for the Netherlands and only when the owner shows shipping costs; anything it cannot read makes the cart
  say checkout shows the cost. It is an estimate: the cart labels it 'indicatie' and checkout has the final amount.
  Outputs 'cost|class|override|mixed' (cost in cents incl. btw, -1 = unknown; class pakket | pallet; override true | false;
  mixed true when the lines ship on more than one rate (pakket + pallet, or a product with its own custom.verzendkosten
  next to others): Shopify adds up the rates of different shipping profiles, so the cart then calls it an indicatie).
  Use: {%- capture s -%}{% render 'cart-shipping' %}{%- endcapture -%}{%- assign s = s | strip | split: '|' -%}
{%- endcomment -%}
{%- liquid
  assign sh_class = 'pakket'
  assign sh_override = false
  assign sh_cost = -1
  assign sh_src = ''
  assign sh_mixed = false
  assign sh_country = localization.country.iso_code | default: 'NL'
  if settings.show_shipping_cost and cart.requires_shipping and sh_country == 'NL'
    assign sh_free_from = settings.free_shipping_threshold | default: 0 | times: 100
    assign sh_free = false
    if sh_free_from > 0 and cart.total_price >= sh_free_from
      assign sh_free = true
    endif
    assign sh_cost = 0
    for item in cart.items
      if item.requires_shipping == false
        continue
      endif
      assign sh_cls = item.product.metafields.custom.verzending.value | default: 'pakket' | downcase
      if item.product.tags contains 'pallet'
        assign sh_cls = 'pallet'
      endif
      if sh_cls == 'pallet'
        assign sh_class = 'pallet'
      endif
      assign sh_raw = item.product.metafields.custom.verzendkosten.value | strip
      assign sh_key = sh_raw | default: sh_cls
      if sh_src == ''
        assign sh_src = sh_key
      elsif sh_src != sh_key
        assign sh_mixed = true
      endif
      comment
        Catalog round 3: custom.verzendkosten_staffel is the line's own amount at its quantity (CONTRACT): the tiers of the variant's
        per_optie value (else staffel), last tier with vanaf <= quantity; 'per zending' = the amount for the whole line, 'per stuk' =
        amount x quantity (4 x betonblok 1000 kg: 4 x 114,75). Only when it cannot be read does the text of custom.verzendkosten count.
      endcomment
      assign sh_st = item.product.metafields.custom.verzendkosten_staffel.value
      assign sh_tiers = nil
      if sh_st != blank
        assign sh_tiers = sh_st.staffel
        if sh_st.per_optie != blank
          assign sh_opt_val = ''
          for sh_opt in item.product.options
            if sh_opt == sh_st.per_optie.optie
              assign sh_opt_val = item.variant.options[forloop.index0]
            endif
          endfor
          if sh_opt_val != '' and sh_st.per_optie.waarden[sh_opt_val] != blank
            assign sh_tiers = sh_st.per_optie.waarden[sh_opt_val]
          endif
        endif
      endif
      assign sh_amount = nil
      if sh_tiers != blank
        for sh_t in sh_tiers
          if sh_t.vanaf <= item.quantity
            assign sh_amount = sh_t.bedrag
          endif
        endfor
      endif
      if sh_amount != nil
        assign sh_override = true
        assign sh_line = sh_amount | times: 100 | round
        if sh_st.eenheid == 'per stuk'
          assign sh_line = sh_line | times: item.quantity
        endif
      elsif sh_raw != blank
        assign sh_override = true
        assign sh_low = sh_raw | downcase
        if sh_low contains 'gratis'
          assign sh_line = 0
        else
          assign sh_num = sh_raw | split: '€' | last | strip | split: ' ' | first
          if sh_num contains ','
            assign sh_num = sh_num | remove: '.' | replace: ',', '.'
          endif
          assign sh_first = sh_num | slice: 0
          assign sh_line = sh_num | times: 100 | round
          if sh_line <= 0 and sh_first != '0'
            assign sh_line = -1
          endif
        endif
      else
        if sh_cls == 'pallet'
          assign sh_rate = settings.shipping_cost_pallet
        else
          assign sh_rate = settings.shipping_cost_pakket
        endif
        if sh_rate == blank
          assign sh_line = -1
        elsif sh_cls != 'pallet' and sh_free
          assign sh_line = 0
        else
          assign sh_line = sh_rate | strip | replace: ',', '.' | times: 100 | round
        endif
      endif
      if sh_line < 0
        assign sh_cost = -1
        break
      endif
      if sh_line > sh_cost
        assign sh_cost = sh_line
      endif
    endfor
  endif
  echo sh_cost | append: '|' | append: sh_class | append: '|' | append: sh_override | append: '|' | append: sh_mixed
-%}
