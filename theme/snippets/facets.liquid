{%- comment -%}
  Storefront filters (collection.filters / search.filters), feature collection.filters-attributes:
  - list filters as checkboxes with a count (every kind shows its count: list, swatch, pill and switch); colour options (settings.swatch_option_names or presentation 'swatch') as a
    two-column swatch grid; Search & Discovery 'image' presentation with the value's image; size options (Maat, Tafelmaat,
    Diameter, Afmeting, Formaat) as pills, round sizes, rectangles and lengths each in size order (snippets/facet-value-order)
  - price_range: two amount fields that take Dutch notation ('1.000', '279,50'; facets.js sends 1000 / 279.5)
  - a boolean filter with one 'true' value (custom.bedrukbaar: 'Met jouw logo') as a switch
  - tag filter: prefixed tags read as words ('gebruik:horeca' -> 'Horeca'); internal tags in hidden_values are left out
  - a filter that cannot narrow the list is left out: the switch when every product already matches ('Op voorraad 14'
    of 14) or none does ('Op voorraad 0' after Maat and Kleur), a group with at most one value and nothing narrower ('Soort: Easy-up partytent 14'), a product-level group
    whose values all match every product. Option groups with several values stay (a colour also picks the card image).
  - a list group where most values hold a single product (part names in 'Uitvoering' on 'Alle producten', the 8 one-product
    values of 'Uitvoering' on Statafels) is left out: it reads as a product list, not as a choice; on a collection of 5
    products or fewer, so is a size or list group whose values each hold one product
  - scope (optional, section setting): lines 'Filter name: handle, handle' show that filter only on those collections
    ('Past op' belongs on the onderdelen collections, catalog/CONTRACT.md)
  - counts read as '(16 producten)' for screen readers
  Params: results (collection or search), section_id, open_count (groups open on desktop), terms (search only),
  scope (string), handle (the collection handle the scope is checked against),
  hidden_values (comma-separated tags that are not shown; default: the internal tags of catalog/CONTRACT.md),
  filters (optional: results.filters already read by the section), total (optional: number of products shown now;
  without it nothing is left out)
{%- endcomment -%}
{%- liquid
  assign form_id = 'FacetsForm-' | append: section_id
  assign swatch_names = settings.swatch_option_names | downcase | split: ','
  assign size_names = 'maat,tafelmaat,diameter,afmeting,formaat' | split: ','
  assign hidden_raw = hidden_values | default: 'pallet, zakelijk, bedrukbaar, set, badge:nieuw, badge:actie' | downcase | split: ','
  assign hidden_list = ''
  for h in hidden_raw
    assign hs = h | strip
    assign hidden_list = hidden_list | append: '|' | append: hs
  endfor
  assign hidden_list = hidden_list | append: '|'
  assign group_index = 0
  assign f_list = filters | default: results.filters
  assign scope_lines = scope | default: '' | newline_to_br | split: '<br />'
-%}
<form id="{{ form_id }}" class="facets" action="{{ request.path }}" method="get" data-facets-form>
  {%- if terms != blank -%}
    <input type="hidden" name="q" value="{{ terms | escape }}">
    <input type="hidden" name="options[prefix]" value="last">
  {%- endif -%}
  {%- for filter in f_list -%}
    {%- liquid
      # filter.values is read once per filter (each read can rebuild the value list and its counts)
      assign fvals = filter.values
      assign active_count = filter.active_values.size
      if filter.type == 'price_range'
        if filter.min_value.value != nil or filter.max_value.value != nil
          assign active_count = 1
        endif
      endif
      assign f_label = filter.label | downcase | strip
      assign f_kind = 'list'
      # a yes/no metafield filter (type boolean; some setups list it with the values true/false)
      assign tf_only = false
      if fvals.size > 0 and fvals.size <= 2
        assign tf_only = true
        for value in fvals
          assign vr = value.value | append: '' | downcase
          unless vr == 'true' or vr == 'false'
            assign tf_only = false
          endunless
        endfor
      endif
      if filter.type == 'price_range'
        assign f_kind = 'price'
      elsif filter.type == 'boolean' and fvals.size <= 2
        assign f_kind = 'switch'
      elsif tf_only
        assign f_kind = 'switch'
      elsif filter.presentation == 'image'
        assign f_kind = 'image'
      elsif filter.presentation == 'swatch' or swatch_names contains f_label
        assign f_kind = 'swatch'
      else
        for n in swatch_names
          assign nn = n | strip
          if nn == f_label
            assign f_kind = 'swatch'
          endif
        endfor
        if size_names contains f_label
          assign f_kind = 'pills'
        endif
      endif
      # a boolean filter shows one switch for its 'true' value: 'Op voorraad' (availability) or the filter name
      # ('Met jouw logo') when the value itself only says true/yes
      assign switch_value = nil
      if f_kind == 'switch'
        for value in fvals
          assign vr = value.value | append: '' | downcase
          if vr == 'true' or vr == '1'
            assign switch_value = value
          endif
        endfor
        if switch_value == nil
          assign f_kind = 'list'
        else
          assign switch_label = filter.label
          assign sl_raw = switch_value.label | append: '' | downcase | strip
          unless sl_raw == 'true' or sl_raw == 'yes' or sl_raw == 'ja' or sl_raw == '1' or sl_raw == ''
            assign switch_label = switch_value.label
          endunless
          # Shopify counts a variant that sells on without stock (made to order, 'Leverbaar over 2–3 weken') as available:
          # the switch hides what cannot be ordered, so it says 'Alleen leverbaar', not 'Op voorraad'
          if filter.param_name == 'filter.v.availability'
            assign switch_label = 'collection.filter_available' | t
          endif
        endif
      endif
      # display order: sizes by group and real size (snippets/facet-value-order), everything else as Shopify gives it
      capture value_order
        render 'facet-value-order', values: fvals, sizes: f_kind
      endcapture
      assign value_order = value_order | strip | split: ','
      # a long colour list (24 stretch colours) goes by how many products it holds, so Wit, Zwart and Antraciet are in view
      # before the one-off colours (ties keep Shopify's order)
      if f_kind == 'swatch' and fvals.size > 10
        assign sw_order = ''
        for value in fvals
          assign sw_key = 20000 | minus: value.count
          assign vi_pad = forloop.index0 | plus: 1000
          assign sw_order = sw_order | append: sw_key | append: ':' | append: vi_pad | append: ','
        endfor
        assign value_order = sw_order | split: ',' | sort
      endif
      # a product-level value that every product shown holds ('Gebruik: Evenement 14' of 14) cannot narrow the list
      assign p_level = false
      if filter.param_name contains 'filter.p.' and total != blank and active_count == 0
        assign p_level = true
      endif
      # values shown (tag filter without internal tags); how many of them would narrow the list now
      assign shown_count = 0
      assign live_count = 0
      assign narrow_count = 0
      assign one_n = 0
      for value in fvals
        assign vkey = value.value | append: '' | downcase | strip | prepend: '|' | append: '|'
        if p_level and value.count >= total and f_kind == 'list'
          continue
        endif
        unless filter.param_name == 'filter.p.tag' and hidden_list contains vkey
          assign shown_count = shown_count | plus: 1
          if value.count <= 1
            assign one_n = one_n | plus: 1
          endif
          if value.count > 0
            assign live_count = live_count | plus: 1
            if total != blank and value.count < total
              assign narrow_count = narrow_count | plus: 1
            endif
          endif
        endunless
      endfor
      assign f_useless = false
      if total != blank and total > 0 and active_count == 0 and f_kind != 'price'
        if f_kind == 'switch'
          if switch_value.count >= total
            assign f_useless = true
          endif
        elsif narrow_count == 0
          assign f_level = filter.param_name | slice: 0, 9
          if live_count <= 1 or f_level == 'filter.p.'
            assign f_useless = true
          endif
        endif
      endif
      # a switch that matches none of the products shown now cannot narrow the list either ('Op voorraad 0' once Maat and
      # Kleur are chosen): it is left out instead of greyed out (an active one stays, so it can be switched off)
      if f_kind == 'switch' and switch_value.count == 0 and switch_value.active != true
        assign f_useless = true
      endif
      # mostly one-product values make a group a product list, not a choice (one_need: the share of one-product values, in
      # twelfths, that hides it): a list of more than 10 values, two thirds (part names in 'Uitvoering' on 'Alle producten');
      # an option list of more than 8 values, half ('Polyester', 'Houten palen', 'Dak in framekleur' on Partytenten: its
      # sub-collections filter on it), or of 5 or more, three quarters ('Uitvoering' on Statafels: Binnen 1, 110 cm hoog 1,
      # Zwart onderstel 1 …); on a collection of 5 products or fewer (unfiltered), a size or list group whose values all hold
      # one product ('Maat' on Bedrukte statafelhoezen: 7 sizes for 3 products). Colours stay (they pick the card image).
      assign one_need = 13
      if f_kind == 'list'
        if filter.param_name contains 'filter.v.option'
          if shown_count > 8
            assign one_need = 6
          elsif shown_count >= 5
            assign one_need = 9
          endif
        elsif shown_count > 10
          assign one_need = 8
        endif
      endif
      if one_need == 13 and results.all_products_count <= 5 and total == results.all_products_count
        if f_kind == 'list' or f_kind == 'pills'
          assign one_need = 12
        endif
      endif
      assign one_x12 = one_n | times: 12
      assign need_x = shown_count | times: one_need
      if f_useless == false and active_count == 0 and total != blank and shown_count > 1 and one_x12 >= need_x
        assign f_useless = true
      endif
      # scoped filters: only on the collections the setting names for them (an active one always stays, so it can be undone)
      if f_useless == false and active_count == 0 and handle != blank
        for line in scope_lines
          assign sl_parts = line | split: ':'
          if sl_parts.size < 2
            continue
          endif
          assign sl_name = sl_parts.first | strip | downcase
          if sl_name == f_label
            assign sl_handles = sl_parts.last | remove: ' ' | strip | downcase | split: ','
            unless sl_handles contains handle
              assign f_useless = true
            endunless
          endif
        endfor
      endif
    -%}
    {%- if f_useless -%}{%- continue -%}{%- endif -%}
    {%- if f_kind == 'switch' -%}
      {%- assign input_id = 'Filter-' | append: section_id | append: '-' | append: filter.param_name | handleize -%}
      <div class="facet facet--switch" data-param="{{ filter.param_name | escape }}">
        <label class="facet__switch" for="{{ input_id }}">
          <span class="facet__switch-label">{{ switch_label }} <span class="facet__count" aria-hidden="true">{{ switch_value.count }}</span><span class="visually-hidden">({{ 'collection.products_count' | t: count: switch_value.count }})</span></span>
          <input class="facet__switch-input" type="checkbox" role="switch" id="{{ input_id }}" name="{{ switch_value.param_name }}" value="{{ switch_value.value | escape }}"{% if switch_value.active %} checked{% endif %}>
        </label>
      </div>
    {%- elsif shown_count > 0 or f_kind == 'price' -%}
      {%- assign group_index = group_index | plus: 1 -%}
      <details class="facet facet--{{ f_kind }}" data-param="{{ filter.param_name | escape }}"{% if group_index <= open_count or active_count > 0 %} open{% endif %}>
        <summary class="facet__summary">
          <span class="facet__title">{{ filter.label }}{% if active_count > 0 and f_kind != 'price' %} <span class="facet__badge"><span class="visually-hidden">, {{ 'collection.selected' | t: count: active_count }}</span><span aria-hidden="true">{{ active_count }}</span></span>{% endif %}</span>
          {%- render 'icon', icon: 'chevron-down', class: 'icon--sm' -%}
        </summary>
        <div class="facet__body">
          {%- if f_kind == 'price' -%}
            {%- render 'facet-price', filter: filter, section_id: section_id -%}
          {%- else -%}
            {%- assign limit_n = 8 -%}
            {%- if f_kind == 'pills' or f_kind == 'image' -%}{%- assign limit_n = 12 -%}{%- elsif f_kind == 'swatch' -%}{%- assign limit_n = 10 -%}{%- endif -%}
            <fieldset class="facet__fieldset">
              <legend class="visually-hidden">{{ filter.label }}</legend>
              {%- if f_kind == 'image' -%}<style>.facet__img{flex:none;width:32px;height:32px;border-radius:6px;overflow:hidden;background:var(--c-media)}.facet__img img{width:100%;height:100%;object-fit:contain}</style>{%- endif -%}
              <ul class="facet__list facet__list--{{ f_kind }}" role="list">
                {%- assign vi = 0 -%}
                {%- for vo in value_order -%}
                  {%- assign v_i = vo | split: ':' | last | plus: 0 | minus: 1000 -%}
                  {%- assign value = fvals[v_i] -%}
                  {%- assign vkey = value.value | append: '' | downcase | strip | prepend: '|' | append: '|' -%}
                  {%- if filter.param_name == 'filter.p.tag' and hidden_list contains vkey -%}{%- continue -%}{%- endif -%}
                  {%- if p_level and value.count >= total and f_kind == 'list' -%}{%- continue -%}{%- endif -%}
                  {%- assign vi = vi | plus: 1 -%}
                  {%- assign input_id = 'Filter-' | append: section_id | append: '-' | append: filter.param_name | handleize | append: '-' | append: v_i -%}
                  {%- assign disabled = false -%}
                  {%- if value.count == 0 and value.active == false -%}{%- assign disabled = true -%}{%- endif -%}
                  {%- capture v_label -%}{%- render 'facet-value-label', filter: filter, value: value -%}{%- endcapture -%}
                  <li class="facet__item{% if vi > limit_n %} facet__item--more{% endif %}">
                    {%- if f_kind == 'pills' -%}
                      <input class="facet__pill-input visually-hidden" type="checkbox" id="{{ input_id }}" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if disabled %} disabled{% endif %}>
                      <label class="facet__pill{% if disabled %} is-disabled{% endif %}" for="{{ input_id }}"><span class="facet__pill-label">{{ v_label }}</span><span class="facet__count" aria-hidden="true">{{ value.count }}</span><span class="visually-hidden">({{ 'collection.products_count' | t: count: value.count }})</span></label>
                    {%- else -%}
                      <label class="check facet__value{% if disabled %} is-disabled{% endif %}" for="{{ input_id }}">
                        <input type="checkbox" id="{{ input_id }}" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if disabled %} disabled{% endif %}>
                        {%- if f_kind == 'swatch' -%}
                          {%- render 'swatch', value: value, class: 'facet__swatch' -%}
                        {%- elsif f_kind == 'image' -%}
                          {%- comment -%} Search & Discovery 'image' presentation: the value's own image {%- endcomment -%}
                          <span class="facet__img">{%- if value.image -%}{{ value.image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', width: 48, height: 48 }}{%- endif -%}</span>
                        {%- endif -%}
                        <span class="facet__label"{% if f_kind == 'swatch' %} title="{{ v_label | strip_html | strip | escape }}"{% endif %}>{{ v_label }}</span>
                        <span class="facet__count" aria-hidden="true">{{ value.count }}</span><span class="visually-hidden">({{ 'collection.products_count' | t: count: value.count }})</span>
                      </label>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </fieldset>
            {%- if vi > limit_n -%}
              {%- capture more_label -%}{{ 'general.view_all' | t }} ({{ vi }}){%- endcapture -%}
              <button type="button" class="facet__more js-only" data-facet-more aria-expanded="false" data-more="{{ more_label | escape }}" data-less="{{ 'collection.show_less' | t | escape }}">{%- render 'icon', icon: 'plus', class: 'icon--xs facet__more-plus' -%}{%- render 'icon', icon: 'minus', class: 'icon--xs facet__more-minus' -%}<span data-more-label>{{ more_label }}</span></button>
            {%- endif -%}
          {%- endif -%}
        </div>
      </details>
    {%- endif -%}
  {%- endfor -%}
  <noscript><button type="submit" class="btn btn--sm">{{ 'collection.apply' | t }}</button></noscript>
</form>
{%- comment -%} rules only a page without JavaScript needs (all values shown, the phone drawer via :target) {%- endcomment -%}
<noscript>{{ 'section-main-collection-nojs.css' | asset_url | stylesheet_tag }}</noscript>
