{%- comment -%}
  Shared product card (feature collection.card-parity): studio media + hover image, badges, title,
  custom.kenmerk_kort, swatches, price incl/excl (+ vanaf / actie), stock + dispatch line, quick add.
  Params: product (required), sizes (string), priority (bool), heading_tag (default h3), show_quick_add (bool, default setting)
{%- endcomment -%}
{%- liquid
  assign card_sizes = sizes | default: '(min-width: 990px) 320px, (min-width: 750px) 33vw, 50vw'
  assign h_tag = heading_tag | default: 'h3'
  assign first_variant = product.selected_or_first_available_variant
  assign swatch_names = settings.swatch_option_names | downcase | split: ','
  assign is_print = false
  if product.tags contains 'bedrukbaar' or product.metafields.custom.bedrukbaar.value == true
    assign is_print = true
  endif
  assign quick = settings.card_quick_add
  if show_quick_add == false
    assign quick = false
  endif
-%}
<article class="card product-card{% unless product.available %} card--soldout{% endunless %}">
  <a class="card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_media -%}
      {%- assign card_alt = product.featured_media.alt | default: product.title -%}
      {%- render 'image', image: product.featured_media.preview_image, sizes: card_sizes, priority: priority, alt: card_alt, class: 'card__img' -%}
      {%- if settings.card_second_image and product.media[1] -%}
        {%- render 'image', image: product.media[1].preview_image, sizes: card_sizes, alt: '', class: 'card__img2' -%}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>
  <div class="card__badges">
    {%- if product.compare_at_price > product.price -%}
      {%- assign save_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
      <span class="badge badge--actie">{{ 'price.save' | t: percent: save_pct }}</span>
    {%- endif -%}
    {%- if product.tags contains 'badge:nieuw' -%}<span class="badge badge--nieuw">{{ 'card.badge_new' | t }}</span>{%- endif -%}
    {%- if is_print -%}<span class="badge badge--logo">{% render 'icon', icon: 'flag' %}{{ 'card.badge_logo' | t }}</span>{%- endif -%}
    {%- if product.metafields.custom.staffelkorting != blank -%}<span class="badge badge--staffel">{{ 'card.badge_staffel' | t }}</span>{%- endif -%}
    {%- if product.tags contains 'set' -%}<span class="badge badge--staffel">{{ 'card.badge_set' | t }}</span>{%- endif -%}
    {%- unless product.available -%}<span class="badge badge--soldout">{{ 'card.badge_sold_out' | t }}</span>{%- endunless -%}
  </div>
  <div class="card__body">
    {%- if settings.card_vendor -%}<p class="card__vendor">{{ product.vendor }}</p>{%- endif -%}
    <{{ h_tag }} class="card__title"><a href="{{ product.url }}">{{ product.title }}</a></{{ h_tag }}>
    {%- if settings.card_kenmerk and product.metafields.custom.kenmerk_kort != blank -%}
      <p class="card__spec">{{ product.metafields.custom.kenmerk_kort.value }}</p>
    {%- endif -%}
    {%- render 'rating', product: product -%}
    {%- if settings.card_swatches -%}
      {%- for option in product.options_with_values -%}
        {%- assign opt_name = option.name | downcase | strip -%}
        {%- assign is_swatch = false -%}
        {%- for n in swatch_names -%}{%- assign nn = n | strip -%}{%- if nn == opt_name -%}{%- assign is_swatch = true -%}{%- endif -%}{%- endfor -%}
        {%- if is_swatch and option.values.size > 1 -%}
          <div class="swatches" aria-label="{{ 'card.colors_label' | t: count: option.values.size }}" role="img">
            {%- for value in option.values limit: settings.card_swatch_limit -%}
              {%- render 'swatch', value: value, class: 'swatch--sm' -%}
            {%- endfor -%}
            {%- if option.values.size > settings.card_swatch_limit -%}
              {%- assign more_count = option.values.size | minus: settings.card_swatch_limit -%}
              <span aria-hidden="true">{{ 'card.more_colors' | t: count: more_count }}</span>
            {%- endif -%}
          </div>
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    <div class="card__footer">
      <div class="card__price">{%- render 'price', product: product -%}</div>
      {%- if settings.card_stock -%}{%- render 'delivery-promise', product: product, style: 'short' -%}{%- endif -%}
      {%- if quick -%}
        <div class="card__actions card__quick">
          {%- if product.has_only_default_variant and product.available -%}
            {%- form 'product', product, class: 'card__form', data-product-form: '', novalidate: 'novalidate' -%}
              <input type="hidden" name="id" value="{{ first_variant.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" name="add" class="btn btn--secondary btn--sm" aria-label="{{ 'card.quick_add_label' | t: title: product.title | escape }}">
                {%- render 'icon', icon: 'cart', class: 'icon--sm' -%}<span>{{ 'card.quick_add' | t }}</span>
              </button>
            {%- endform -%}
          {%- elsif product.available -%}
            <a class="btn btn--outline btn--sm" href="{{ product.url }}" tabindex="-1">{{ 'card.choose' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</article>
