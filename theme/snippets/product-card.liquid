{%- comment -%}
  Shared product card (feature collection.card-parity): studio media + hover image, badges, title,
  custom.kenmerk_kort, colour swatches (hover previews that colour, click opens it), sizes of the line, price incl/excl
  (+ vanaf / actie), stock + dispatch line and one action (the staffel discount is on the product page and in the
  grid's Zakelijk band, not repeated on every card):
  - 'add'    one variant: added straight from the card (cart.js handles form[data-product-form])
  - 'quick'  several variants: opens the quick-add panel (facets.js + sections/quick-add.liquid); without JS a link
  - 'link'   made to measure or with your logo: to the product page, where the configurator / upload lives
  Params: product (required), sizes (string), priority (true: LCP candidate, eager + fetchpriority high; 'eager': in the first
  row but not the LCP, eager only), heading_tag (default h3), show_quick_add (bool, default setting),
  color (string, optional): an active colour filter value; the card then shows and links that colour's variant, marks that
  swatch (moved to the front when it would sit behind '+N') and, when that colour has no photo of its own, says which
  colour the photo shows ('Foto in rood')
  show_sizes (bool, default true): false leaves out the sizes of the line (collection grid: the other sizes stand next to it)
  The size of a one-size product sits on the photo ('3 × 3 m'), so a row of look-alike renders can be scanned by size. The
  price shows one btw line when the header has the Particulier/Zakelijk switch (the mode the shopper chose), else both.
{%- endcomment -%}
{%- liquid
  assign img_sizes = sizes | default: '(min-width: 990px) 320px, (min-width: 750px) 33vw, 50vw'
  assign h_tag = heading_tag | default: 'h3'
  assign first_variant = product.selected_or_first_available_variant
  assign swatch_names = settings.swatch_option_names | downcase | split: ','
  assign times_nb = ' × '
  assign card_title = product.title | replace: ' x ', times_nb | replace: ' × ', times_nb
  assign is_print = false
  if product.tags contains 'bedrukbaar' or product.metafields.custom.bedrukbaar.value == true
    assign is_print = true
  endif
  assign quick = settings.card_quick_add
  if show_quick_add == false
    assign quick = false
  endif
  assign card_status = product.metafields.custom.availability_status.value | downcase | strip | replace: ' ', '-'
  assign card_cfg = product.metafields.custom.configurator.value
  assign card_unit = ''
  if card_cfg != blank and card_cfg.velden != blank
    assign card_unit = card_cfg.eenheid | default: 'm²'
  endif
  # the first option a shopper can actually choose (more than one value) names the action: 'Kies je kleur'
  assign choose_opt = ''
  for option in product.options_with_values
    if option.values.size > 1
      assign choose_opt = option.name | downcase | strip
      break
    endif
  endfor

  # sizes of a line split per size (custom.andere_maten): '3 maten, van 3 × 3 m tot 3 × 6 m'
  assign card_siblings = product.metafields.custom.andere_maten.value
  assign card_size_line = ''
  if card_siblings != blank and card_siblings.size > 0 and show_sizes != false
    assign size_names_lc = 'maat,tafelmaat,diameter,afmeting,formaat' | split: ','
    capture card_order
      render 'size-siblings-order', product: product, siblings: card_siblings, size_names: size_names_lc
    endcapture
    assign card_idx = card_order | split: ','
    assign first_i = card_idx.first | plus: 0
    assign last_i = card_idx.last | plus: 0
    if first_i == 0
      assign fsp = product
    else
      assign fj = first_i | minus: 1
      assign fsp = card_siblings[fj]
    endif
    if last_i == 0
      assign lsp = product
    else
      assign lj = last_i | minus: 1
      assign lsp = card_siblings[lj]
    endif
    capture size_first
      render 'size-label', p: fsp, size_names: size_names_lc
    endcapture
    capture size_last
      render 'size-label', p: lsp, size_names: size_names_lc
    endcapture
    assign size_first = size_first | strip | replace: ' x ', times_nb
    assign size_last = size_last | strip | replace: ' x ', times_nb
    if size_first != blank and size_last != blank and size_first != size_last
      assign card_size_line = 'card.sizes_range_html' | t: count: card_idx.size, first: size_first, last: size_last
      assign card_size_short = 'card.sizes_count' | t: count: card_idx.size
    endif
  endif

  # the size on the photo: one size only (a line split per size, or a one-size product); several sizes say nothing there
  assign card_size_tag = ''
  assign tag_names = 'maat,tafelmaat,diameter,afmeting,formaat' | split: ','
  for option in product.options_with_values
    assign tag_on = option.name | downcase | strip
    if tag_names contains tag_on
      if option.values.size == 1
        assign card_size_tag = option.values.first.name | default: option.values.first | replace: ' x ', times_nb
      endif
      break
    endif
  endfor
  assign card_secondary = true
  if settings.price_display == 'toggle'
    assign card_secondary = false
  endif

  # the action
  assign cta = 'none'
  if quick and product.available
    if card_unit != ''
      assign cta = 'link'
      assign cta_label = 'card.configure' | t
    elsif is_print
      assign cta = 'link'
      assign cta_label = 'card.design' | t
    elsif product.variants.size == 1
      assign cta = 'add'
      assign cta_label = 'card.quick_add' | t
      # custom.availability_status 'pre-order' (catalog/CONTRACT.md): the same words as the product page's button
      if card_status == 'pre-order'
        assign cta_label = 'product.pre_order' | t
      endif
    else
      assign cta = 'quick'
      if choose_opt != ''
        assign cta_label = 'product.choose' | t: option: choose_opt
      else
        assign cta_label = 'card.choose_options' | t
      endif
    endif
  endif

  # low stock on a one-variant product (feature global.low-stock-badge): real tracked stock only, never invented
  assign low_stock = 0
  if product.variants.size == 1 and first_variant.available and first_variant.inventory_management != blank and first_variant.inventory_policy == 'deny'
    if first_variant.inventory_quantity > 0 and first_variant.inventory_quantity <= settings.low_stock_threshold
      assign low_stock = first_variant.inventory_quantity
    endif
  endif

  # narrowed by filters (Kleur, Maat, Uitvoering, price, availability): the card stands for the matched variants
  # (snippets/card-variant.liquid): their photo, link, cheapest price ('vanaf' when they differ), stock line and size
  assign card_image = product.featured_media.preview_image
  assign card_url = product.url
  assign card_variant = nil
  assign card_price_v = nil
  assign card_from = false
  assign card_img_v = nil
  assign card_photo_color = ''
  capture cv_raw
    render 'card-variant', product: product
  endcapture
  assign cv = cv_raw | strip | split: '|'
  if cv.size > 0
    for v in product.variants
      assign v_id = v.id | append: ''
      if v_id == cv[0]
        assign card_variant = v
      endif
      if v_id == cv[1]
        assign card_img_v = v
      endif
      if v_id == cv[2]
        assign card_price_v = v
      endif
    endfor
    if cv[3] == '1'
      assign card_from = true
    endif
    if cv[4] != blank
      assign card_size_tag = cv[4] | replace: ' x ', times_nb
    endif
  endif
  if card_variant
    assign card_url = card_variant.url
    if card_img_v
      assign card_image = card_img_v.featured_image
    endif
  endif
  # filtered on a colour: the shown variant's colour is marked among the swatches; when no matched variant has a photo of
  # its own the card says which colour the photo shows ('Foto in rood')
  if color != blank and cv[5] != blank
    assign color = cv[5]
    if cv[6] != blank and cv[6] != color
      assign card_photo_color = cv[6]
    endif
  endif
-%}
<article class="card product-card{% unless product.available %} card--soldout{% endunless %}" data-card>
  <div class="card__visual">
  <a class="card__media" href="{{ card_url }}" tabindex="-1" aria-hidden="true">
    {%- if card_image -%}
      {%- assign card_alt = card_image.alt | default: product.title -%}
      {%- if priority == 'eager' -%}
        {{- card_image | image_url: width: 960 | image_tag: widths: '240, 360, 480, 640, 800, 960', sizes: img_sizes, loading: 'eager', alt: card_alt, class: 'card__img', decoding: 'async' -}}
      {%- else -%}
        {%- render 'image', image: card_image, sizes: img_sizes, widths: '240, 360, 480, 640, 800, 960', priority: priority, alt: card_alt, class: 'card__img' -%}
      {%- endif -%}
      {%- if settings.card_second_image and product.media[1] and card_img_v == nil -%}
        {%- render 'image', image: product.media[1].preview_image, sizes: img_sizes, widths: '240, 360, 480, 640, 800, 960', alt: '', class: 'card__img2' -%}
      {%- endif -%}
    {%- else -%}
      {%- comment -%} no photo yet: a quiet tile with the product family's icon, not a generic placeholder (a lamp on a table cover) {%- endcomment -%}
      {%- liquid
        assign ph_kind = product.type | append: ' ' | append: product.title | downcase
        assign ph_icon = 'box'
        if ph_kind contains 'tent' or ph_kind contains 'overkapping' or ph_kind contains 'zijwand'
          assign ph_icon = 'tent'
        elsif ph_kind contains 'tafel' or ph_kind contains 'rok' or ph_kind contains 'hoes' or ph_kind contains 'kleed'
          assign ph_icon = 'table'
        endif
      -%}
      <span class="card__noimg">{%- render 'icon', icon: ph_icon -%}<span>{{ 'card.photo_soon' | t }}</span></span>
    {%- endif -%}
    {%- if card_size_tag != '' or card_photo_color != '' -%}
      <span class="card__tags">
        {%- if card_photo_color != '' -%}{%- assign photo_color_lc = card_photo_color | downcase -%}<span class="card__photo-note">{{ 'card.shown_in' | t: color: photo_color_lc }}</span>{%- endif -%}
        {%- if card_size_tag != '' -%}<span class="card__size">{{ card_size_tag }}</span>{%- endif -%}
      </span>
    {%- endif -%}
  </a>
  {%- comment -%} 'Voordeelset' only when the set really is cheaper than its parts (catalog/CONTRACT.md: bundles) {%- endcomment -%}
  {%- capture card_bundle -%}{%- if product.tags contains 'set' -%}{%- render 'bundle-components', product: product, mode: 'card' -%}{%- endif -%}{%- endcapture -%}
  {%- capture card_badges -%}
    {%- liquid
      # the percentage pairs one variant's price with its own compare-at: the cheapest variant that is on sale (the
      # lowest price and the lowest compare-at of the product can belong to different sizes)
      assign sale_p = 0
      assign sale_cp = 0
      if card_price_v
        # narrowed by filters: the percentage of the variant whose price the card shows
        assign sale_p = card_price_v.price
        assign sale_cp = card_price_v.compare_at_price | default: 0
      elsif product.compare_at_price_max > product.price
        for v in product.variants
          if v.compare_at_price > v.price
            if sale_p == 0 or v.price < sale_p
              assign sale_p = v.price
              assign sale_cp = v.compare_at_price
            endif
          endif
        endfor
      endif
    -%}
    {%- if sale_cp > sale_p -%}
      {%- assign save_pct = sale_cp | minus: sale_p | times: 100.0 | divided_by: sale_cp | round -%}
      <span class="badge badge--actie">{{ 'price.save' | t: percent: save_pct }}</span>
    {%- endif -%}
    {%- if card_status == 'permanent-uitverkocht' -%}
      <span class="badge badge--soldout">{{ 'card.badge_discontinued' | t }}</span>
    {%- elsif card_status == 'binnenkort' and product.available == false -%}
      <span class="badge badge--soldout">{{ 'card.badge_coming' | t }}</span>
    {%- elsif product.available == false -%}
      <span class="badge badge--soldout">{{ 'card.badge_sold_out' | t }}</span>
    {%- endif -%}
    {%- if product.tags contains 'badge:nieuw' -%}<span class="badge badge--nieuw">{{ 'card.badge_new' | t }}</span>{%- endif -%}
    {%- if is_print -%}<span class="badge badge--logo">{% render 'icon', icon: 'upload' %}{{ 'card.badge_logo' | t }}</span>{%- endif -%}
    {%- if card_bundle != blank -%}<span class="badge badge--staffel">{{ 'card.badge_set' | t }}</span>{%- endif -%}
    {%- if card_unit != '' -%}<span class="badge badge--staffel">{{ 'card.badge_custom' | t }}</span>{%- endif -%}
    {%- if low_stock > 0 -%}<span class="badge badge--staffel">{{ 'product.stock_low' | t: count: low_stock }}</span>{%- endif -%}
  {%- endcapture -%}
  {%- if card_badges != blank -%}<div class="card__badges">{{ card_badges }}</div>{%- endif -%}
  </div>
  <div class="card__body">
    {%- if settings.card_vendor -%}<p class="card__vendor">{{ product.vendor }}</p>{%- endif -%}
    <{{ h_tag }} class="card__title"><a href="{{ card_url }}">{{ card_title }}</a></{{ h_tag }}>
    {%- if settings.card_kenmerk and product.metafields.custom.kenmerk_kort != blank -%}
      <p class="card__spec">{{ product.metafields.custom.kenmerk_kort.value }}</p>
    {%- endif -%}
    {%- render 'card-fit', product: product -%}
    {%- render 'rating', product: product -%}
    {%- capture card_meta -%}
      {%- if settings.card_swatches -%}
        {%- for option in product.options_with_values -%}
          {%- assign opt_name = option.name | downcase | strip -%}
          {%- assign is_swatch = false -%}
          {%- for n in swatch_names -%}{%- assign nn = n | strip -%}{%- if nn == opt_name -%}{%- assign is_swatch = true -%}{%- endif -%}{%- endfor -%}
          {%- if is_swatch and option.values.size > 1 -%}
            {%- liquid
              assign opt_idx = option.position | minus: 1
              # the marked swatch and the order (snippets/card-swatch-order: the filtered colour, else the photo's colour first)
              capture sw_raw
                render 'card-swatch-order', product: product, option: option, color: color, variant: card_img_v
              endcapture
              assign sw_raw = sw_raw | strip | split: ';'
              assign sw_chosen = sw_raw[0] | plus: 0
              assign sw_order = sw_raw[1]
              assign sw_order = sw_order | split: ','
            -%}
            <div class="card__swatches swatches">
              <span class="visually-hidden">{{ 'card.colors_label' | t: count: option.values.size }}</span>
              {%- for sw_i in sw_order limit: settings.card_swatch_limit -%}
                {%- assign sw_ix = sw_i | plus: 0 -%}
                {%- assign value = option.values[sw_ix] -%}
                {%- assign sw_variant = nil -%}
                {%- for v in product.variants -%}
                  {%- if v.options[opt_idx] == value.name and v.available -%}{%- assign sw_variant = v -%}{%- break -%}{%- endif -%}
                {%- endfor -%}
                {%- unless sw_variant -%}
                  {%- for v in product.variants -%}{%- if v.options[opt_idx] == value.name -%}{%- assign sw_variant = v -%}{%- break -%}{%- endif -%}{%- endfor -%}
                {%- endunless -%}
                {%- assign sw_img = sw_variant.featured_image -%}
                <a class="card__swatch{% if sw_variant.available == false %} is-unavailable{% endif %}{% if sw_ix == sw_chosen %} is-chosen{% endif %}" href="{{ product.url }}{% if sw_variant %}?variant={{ sw_variant.id }}{% endif %}" tabindex="-1" aria-hidden="true" title="{{ value.name | escape }}"
                  {%- if sw_img %} data-srcset="{{ sw_img | image_url: width: 360 }} 360w, {{ sw_img | image_url: width: 540 }} 540w, {{ sw_img | image_url: width: 720 }} 720w, {{ sw_img | image_url: width: 960 }} 960w" data-alt="{{ sw_img.alt | default: product.title | escape }}"{% endif %}>
                  {%- render 'swatch', value: value, class: 'swatch--card' -%}
                </a>
              {%- endfor -%}
              {%- if option.values.size > settings.card_swatch_limit -%}
                {%- assign more_count = option.values.size | minus: settings.card_swatch_limit -%}
                <span class="card__more card__more--wide" aria-hidden="true">{{ 'card.more_colors' | t: count: more_count }}</span>
              {%- endif -%}
              {%- comment -%} narrow cards (2 columns on a phone) show 4 swatches {%- endcomment -%}
              {%- if option.values.size > 4 and settings.card_swatch_limit > 4 -%}
                {%- assign more_narrow = option.values.size | minus: 4 -%}
                <span class="card__more card__more--narrow" aria-hidden="true">{{ 'card.more_colors' | t: count: more_narrow }}</span>
              {%- endif -%}
            </div>
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if card_size_line != '' -%}<p class="card__sizes" title="{{ card_size_line | strip_html | escape }}"><span class="card__sizes-long">{{ card_size_line }}</span><span class="card__sizes-short">{{ card_size_short }}</span></p>{%- endif -%}
    {%- endcapture -%}
    <div class="card__footer">
      <div class="card__price">
        {%- if card_unit != '' -%}{%- render 'price', product: product, variant: card_price_v, from: card_from, unit: card_unit, secondary: card_secondary -%}{%- else -%}{%- render 'price', product: product, variant: card_price_v, from: card_from, secondary: card_secondary -%}{%- endif -%}
        {{- card_bundle -}}
      </div>
      {%- if settings.card_stock -%}
        {%- capture card_dp -%}{%- render 'delivery-promise', product: product, variant: card_variant, style: 'short' -%}{%- endcapture -%}
        {%- comment -%} a wait line carries its text as a key: the collection grid states the line most of its cards share
          once above the grid ('Leverbaar over 2–3 weken, tenzij anders vermeld') and hides it on those cards {%- endcomment -%}
        {%- if card_dp contains 'stock--later' -%}
          <div class="card__stock" data-lead="{{ card_dp | strip_html | strip | handleize }}">{{ card_dp }}</div>
        {%- else -%}
          {{ card_dp }}
        {%- endif -%}
      {%- endif -%}
    </div>
    {%- comment -%} swatches come last, under price and stock; an empty row keeps the place so prices line up with the cards
      next to it (base.css hides the row in a list where no card has one) {%- endcomment -%}
    <div class="card__meta">{{ card_meta | strip }}</div>
  </div>
  {%- if cta != 'none' -%}
    {%- capture cta_icon -%}
      {%- if cta == 'link' -%}
        {%- render 'icon', icon: 'arrow-right', class: 'icon--sm' -%}
      {%- else -%}
        <svg class="icon icon--sm" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 3.5h2.8l2.3 11.5h11.4l1.2-4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/><path d="M17.5 2.5v6M14.5 5.5h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="9" cy="19.5" r="1.8" fill="currentColor"/><circle cx="17" cy="19.5" r="1.8" fill="currentColor"/></svg>
      {%- endif -%}
    {%- endcapture -%}
    {%- assign cta_aria = 'card.cta_label' | t: action: cta_label, title: card_title -%}
    {%- comment -%} after the body, so Tab reaches the product link before its action; CSS places it on the photo {%- endcomment -%}
    <div class="card__actions">
      {%- if cta == 'add' -%}
        {%- form 'product', product, class: 'card__form', data-product-form: '', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ first_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" name="add" class="card__cta" aria-label="{{ cta_aria | escape }}">{{ cta_icon }}<span class="card__cta-text">{{ cta_label }}</span></button>
        {%- endform -%}
      {%- elsif cta == 'quick' -%}
        <a class="card__cta" href="{{ card_url }}" data-quick-add="{{ card_url }}" aria-haspopup="dialog" aria-label="{{ cta_aria | escape }}">{{ cta_icon }}<span class="card__cta-text">{{ cta_label }}</span></a>
      {%- else -%}
        <a class="card__cta" href="{{ card_url }}" aria-label="{{ cta_aria | escape }}">{{ cta_icon }}<span class="card__cta-text">{{ cta_label }}</span></a>
      {%- endif -%}
    </div>
  {%- endif -%}
</article>
