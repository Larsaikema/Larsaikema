{%- comment -%}
  Design tokens from theme settings -> CSS custom properties. Defaults come from brand/tokens.json (v7): 11 palette
  colours with one meaning each, role colours (cart count, badges, chosen option, Actie label, accent line) as their
  own settings, six colour schemes with buy button / main button / outline in rest and hover, focus and logo tent,
  Figtree only (type_header_font figtree_n8 for display/H1/H2, 700 and 600 via font_modify), radii, spacing, motion.
  No colour role is hard-coded here: a brand version is a change in config/settings_data.json.
{%- endcomment -%}
{%- liquid
  assign header_font = settings.type_header_font
  assign body_font = settings.type_body_font
  assign header_700 = header_font | font_modify: 'weight', '700'
  if header_700 == blank
    assign header_700 = header_font
  endif
  assign body_semibold = body_font | font_modify: 'weight', '600'
  assign body_bold = body_font | font_modify: 'weight', '700'
  assign body_italic = body_font | font_modify: 'style', 'italic'
  if body_bold == blank
    assign body_bold = body_font | font_modify: 'weight', 'bolder'
  endif
-%}
<style>
  {{ header_font | font_face: font_display: 'swap' }}
  {%- if header_700 != header_font -%}{{ header_700 | font_face: font_display: 'swap' }}{%- endif -%}
  {{ body_font | font_face: font_display: 'swap' }}
  {%- if body_semibold -%}{{ body_semibold | font_face: font_display: 'swap' }}{%- endif -%}
  {%- liquid
    assign same_700 = false
    if body_bold.family == header_700.family and body_bold.weight == header_700.weight and body_bold.style == header_700.style
      assign same_700 = true
    endif
  -%}
  {%- if body_bold and same_700 == false -%}{{ body_bold | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if body_italic -%}{{ body_italic | font_face: font_display: 'swap' }}{%- endif -%}

  :root {
    --c-lampion: {{ settings.color_lampion }};
    --c-brand: var(--c-lampion);
    --c-inkt: {{ settings.color_inkt }};
    --c-inkt-rgb: {{ settings.color_inkt.red }}, {{ settings.color_inkt.green }}, {{ settings.color_inkt.blue }};
    --c-zand: {{ settings.color_zand }};
    --c-wit: {{ settings.color_wit }};
    --c-linnen: {{ settings.color_linnen }};
    --c-lijn: {{ settings.color_lijn }};
    --c-kiezel: {{ settings.color_kiezel }};
    --c-zon: {{ settings.color_zon }};
    --c-polder: {{ settings.color_polder }};
    --c-oker: {{ settings.color_oker }};
    --c-bordeaux: {{ settings.color_bordeaux }};
    {%- comment -%} surfaces by role (tokens.json color_semantic): media = beeldvlak, band = rustige band / tabellen {%- endcomment %}
    --c-media: var(--c-linnen);
    --c-band: var(--c-linnen);
    {%- comment -%} hover tints (tokens.json color_derived): 8% Inkt over the surface {%- endcomment %}
    --c-tint-wit: color-mix(in srgb, var(--c-wit) 94%, var(--c-inkt));
    --c-tint-zand: color-mix(in srgb, var(--c-zand) 92%, var(--c-inkt));
    --c-tint-linnen: color-mix(in srgb, var(--c-linnen) 92%, var(--c-inkt));
    {%- comment -%} roles: one setting per role, so a brand version is a settings change, not a code change {%- endcomment %}
    --cart-count-bg: {{ settings.color_cart_count }};
    --cart-count-fg: {{ settings.color_cart_count_label }};
    --badge-new-bg: {{ settings.color_badge_new }};
    --badge-new-fg: {{ settings.color_badge_new_label }};
    --badge-logo-bg: {{ settings.color_badge_logo }};
    --badge-logo-fg: {{ settings.color_badge_logo_label }};
    --deal-bg: var(--c-zon);
    --deal-fg: var(--c-inkt);
    --menu-deal-bg: {{ settings.color_menu_deal }};
    --option-selected: {{ settings.color_option_selected }};
    --accent-line: {{ settings.color_accent_line }};
    --done: var(--c-polder);
    --done-fg: var(--c-wit);
    --logo-tent-zakelijk: {% if settings.logo_zakelijk_mono or settings.logo_tent_mono %}currentColor{% else %}var(--logo-tent){% endif %};
    --logo-tent-mono-zakelijk: {% if settings.logo_zakelijk_mono or settings.logo_tent_mono %}1{% else %}var(--logo-tent-mono){% endif %};

    --font-heading: {{ header_font.family }}, {{ header_font.fallback_families }};
    --font-heading-style: {{ header_font.style }};
    --font-heading-weight: {{ header_700.weight }};
    --font-heading-weight-bold: {{ header_font.weight }};
    --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-body-style: {{ body_font.style }};
    --font-body-weight: {{ body_font.weight }};
    --font-body-weight-semibold: {% if body_semibold %}{{ body_semibold.weight }}{% else %}600{% endif %};
    --font-body-weight-bold: {% if body_bold %}{{ body_bold.weight }}{% else %}700{% endif %};
    --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
    --body-scale: {{ settings.body_scale | divided_by: 100.0 }};

    --page-width: {{ settings.page_width }}px;
    --gutter-mobile: {{ settings.gutter_mobile }}px;
    --gutter-desktop: {{ settings.gutter_desktop }}px;
    --section-gap-desktop: {{ settings.section_spacing }}px;
    --section-gap-mobile: {{ settings.section_spacing | divided_by: 2 | at_least: 40 }}px;

    --radius-card: {{ settings.radius_card }}px;
    --radius-panel: {{ settings.radius_panel }}px;
    --radius-input: {{ settings.radius_input }}px;
    --radius-badge: {{ settings.radius_badge }}px;
    --radius-button: {{ settings.radius_button }}px;
    --button-height: {{ settings.button_size }}px;
    --button-case: {{ settings.button_case }};
    --card-ratio: {{ settings.card_image_ratio }};
    --shadow-pressed: inset 0 2px 0 rgba(0,0,0,.28);
    --dur: {% if settings.animations %}220ms{% else %}0ms{% endif %};
    --dur-fast: {% if settings.animations %}140ms{% else %}0ms{% endif %};
  }

  {% for scheme in settings.color_schemes -%}
  {%- assign scheme_brightness = scheme.settings.background | color_brightness -%}
  .color-{{ scheme.id }}{% if forloop.first %}, :root{% endif %} {
    --bg: {{ scheme.settings.background }};
    --fg: {{ scheme.settings.foreground }};
    --fg-rgb: {{ scheme.settings.foreground.red }}, {{ scheme.settings.foreground.green }}, {{ scheme.settings.foreground.blue }};
    --muted: {{ scheme.settings.muted }};
    --btn-bg: {{ scheme.settings.primary_button }};
    --btn-fg: {{ scheme.settings.primary_button_label }};
    --btn-hover: {{ scheme.settings.primary_button_hover }};
    --btn-hover-fg: {{ scheme.settings.primary_button_hover_label | default: scheme.settings.primary_button_label }};
    --btn-hover-bd: {{ scheme.settings.primary_button_hover_border | default: scheme.settings.primary_button_hover }};
    --btn-active: {{ scheme.settings.primary_button_active | default: scheme.settings.primary_button_hover }};
    --btn2-fg: {{ scheme.settings.secondary_button_label }};
    --btn2-hover: {{ scheme.settings.secondary_button_hover }};
    --buy-bg: {{ scheme.settings.buy_button | default: scheme.settings.primary_button }};
    --buy-fg: {{ scheme.settings.buy_button_label | default: scheme.settings.primary_button_label }};
    --buy-hover-bd: {{ scheme.settings.buy_button_hover_border | default: scheme.settings.foreground }};
    --border: {{ scheme.settings.border }};
    --focus: {{ scheme.settings.focus }};
    --logo-tent: {% if settings.logo_tent_mono %}currentColor{% else %}{{ scheme.settings.logo_tent }}{% endif %};
    --logo-roof: var(--logo-tent);
    {%- assign logo_tent_hex = scheme.settings.logo_tent | color_to_hex -%}
    {%- assign logo_fg_hex = scheme.settings.foreground | color_to_hex %}
    --logo-tent-mono: {% if settings.logo_tent_mono or logo_tent_hex == logo_fg_hex %}1{% else %}0{% endif %};
    {%- if scheme_brightness < 110 %}
    --surface: rgba(255,255,255,.07);
    --disabled: {{ scheme.settings.foreground }};
    --disabled-bd: rgba({{ scheme.settings.foreground.red }}, {{ scheme.settings.foreground.green }}, {{ scheme.settings.foreground.blue }}, .45);
    {%- else %}
    --surface: var(--c-wit);
    --disabled: var(--c-kiezel);
    {%- endif %}
    {%- if scheme.settings.background_gradient != blank %}
    --bg-gradient: {{ scheme.settings.background_gradient }};
    {%- endif %}
  }
  {% endfor %}
</style>
