{%- comment -%}
  One FAQ question of the faq section, layout 'help' (deep-linkable by its handle). Params: q (question block),
  return_days, cutoff (strings for [bedenktijd] and [besteltijd] in the answer). The block's hidden search words go in
  data-faq-keywords for the search in content-pages.js.
{%- endcomment -%}
{%- assign fq_answer = q.settings.answer | replace: '[bedenktijd]', return_days | replace: '[besteltijd]', cutoff -%}
<details class="accordion faq-q" id="{{ q.settings.question | handleize | truncate: 72, '' }}" data-faq-item{% if q.settings.keywords != blank %} data-faq-keywords="{{ q.settings.keywords | escape }}"{% endif %} {{ q.shopify_attributes }}>
  <summary><span>{{ q.settings.question }}</span>{%- render 'icon', icon: 'plus' -%}</summary>
  <div class="accordion__body rte">{{ fq_answer }}</div>
</details>
