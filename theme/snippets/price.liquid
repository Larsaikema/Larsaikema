{%- comment -%}
  Price incl. + excl. btw (feature global.price-incl-excl-btw). Both are always rendered; html[data-vat]
  (set by layout + btw toggle) decides which is the main line. Params:
  - product (required) and optional variant (when given, the variant price is shown, no 'vanaf')
  - size: 'lg' | blank
  - id (string): id on the wrapper (main product uses price-<section id>)
  - quantity (number): multiply (cart totals)
  - unit (string): price per unit, e.g. 'm²' for made-to-measure products
  - note (string, optional): a short addition after the secondary (excl./incl.) line, e.g. the staffel hint on cards;
    without the secondary line (setting off) it gets its own line
  A sale price sits in the Zon label (brand book 4.2); the compare-at price is Kiezel and struck through.
{%- endcomment -%}
{%- liquid
  if variant
    assign p = variant.price
    assign cp = variant.compare_at_price
    assign show_from = false
  else
    assign p = product.price
    assign cp = product.compare_at_price
    assign show_from = product.price_varies
  endif
  # Prices are stored incl. btw when shop.taxes_included (the Dutch default), else excl.: derive the other one.
  assign vat_factor = settings.vat_rate | plus: 100
  assign on_sale = false
  if cp > p
    assign on_sale = true
  endif
  if shop.taxes_included
    assign p_excl = p | times: 100.0 | divided_by: vat_factor | round
    assign cp_excl = cp | times: 100.0 | divided_by: vat_factor | round
  else
    assign p_excl = p
    assign cp_excl = cp
    assign p = p | times: vat_factor | divided_by: 100.0 | round
    assign cp = cp | times: vat_factor | divided_by: 100.0 | round
  endif
  if settings.price_show_currency_code
    assign p_fmt = p | money_with_currency
    assign p_excl_fmt = p_excl | money_with_currency
  else
    assign p_fmt = p | money
    assign p_excl_fmt = p_excl | money
  endif
-%}
<div class="price{% if size == 'lg' %} price--lg{% endif %}{% if on_sale %} price--sale{% endif %}"{% if id %} id="{{ id }}"{% endif %} data-price="{{ p }}" data-price-excl="{{ p_excl }}">
  <div class="price__main" data-vat-mode="incl">
    {%- if show_from -%}<span class="price__from">{{ 'price.from' | t }}</span>{%- endif -%}
    <span class="price__value{% if on_sale %} price__value--sale{% endif %}">{%- if on_sale -%}<span class="visually-hidden">{{ 'price.sale' | t }}</span>{%- endif -%}{{ p_fmt }}</span>
    {%- if unit != blank -%}<span class="price__unit">{{ 'price.per_unit' | t: unit: unit }}</span>{%- endif -%}
    {%- if on_sale -%}<s class="price__compare"><span class="visually-hidden">{{ 'price.regular' | t }}</span>{{ cp | money }}</s>{%- endif -%}
    <span class="price__label">{{ 'price.incl' | t }}</span>
  </div>
  <div class="price__main" data-vat-mode="excl">
    {%- if show_from -%}<span class="price__from">{{ 'price.from' | t }}</span>{%- endif -%}
    <span class="price__value{% if on_sale %} price__value--sale{% endif %}">{%- if on_sale -%}<span class="visually-hidden">{{ 'price.sale' | t }}</span>{%- endif -%}{{ p_excl_fmt }}</span>
    {%- if unit != blank -%}<span class="price__unit">{{ 'price.per_unit' | t: unit: unit }}</span>{%- endif -%}
    {%- if on_sale -%}<s class="price__compare"><span class="visually-hidden">{{ 'price.regular' | t }}</span>{{ cp_excl | money }}</s>{%- endif -%}
    <span class="price__label">{{ 'price.excl' | t }}</span>
  </div>
  {%- if note != blank -%}{%- capture price_note -%}<span class="price__note"><span class="price__note-sep" aria-hidden="true"> · </span>{{ note }}</span>{%- endcapture -%}{%- endif -%}
  {%- if settings.price_show_secondary -%}
    <div class="price__alt" data-vat-mode="incl"><span class="price__value">{{ p_excl_fmt }}</span>&nbsp;{{ 'price.excl' | t }}{{ price_note }}</div>
    <div class="price__alt" data-vat-mode="excl"><span class="price__value">{{ p_fmt }}</span>&nbsp;{{ 'price.incl' | t }}{{ price_note }}</div>
  {%- elsif note != blank -%}
    <div class="price__alt price__alt--note">{{ note }}</div>
  {%- endif -%}
</div>
