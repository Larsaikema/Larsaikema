{%- comment -%}
  Price incl. + excl. btw (feature global.price-incl-excl-btw). Both are always rendered; html[data-vat]
  (set by layout + btw toggle) decides which is the main line. Params:
  - product (required) and optional variant (when given, the variant price is shown, no 'vanaf')
  - size: 'lg' | blank
  - id (string): id on the wrapper (main product uses price-<section id>)
  - quantity (number): multiply (cart totals)
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  if variant
    assign p = variant.price
    assign cp = variant.compare_at_price
    assign show_from = false
  else
    assign p = product.price
    assign cp = product.compare_at_price
    assign show_from = product.price_varies
  endif
  assign vat_factor = settings.vat_rate | plus: 100
  assign p_excl = p | times: 100.0 | divided_by: vat_factor | round
  assign on_sale = false
  if cp > p
    assign on_sale = true
    assign cp_excl = cp | times: 100.0 | divided_by: vat_factor | round
  endif
  if settings.price_show_currency_code
    assign p_fmt = p | money_with_currency
    assign p_excl_fmt = p_excl | money_with_currency
  else
    assign p_fmt = p | money
    assign p_excl_fmt = p_excl | money
  endif
-%}
<div class="price{% if size == 'lg' %} price--lg{% endif %}{% if on_sale %} price--sale{% endif %}"{% if id %} id="{{ id }}"{% endif %} data-price="{{ p }}" data-price-excl="{{ p_excl }}">
  {%- if product.available == false and variant == blank -%}{%- assign sold = true -%}{%- endif -%}
  <div class="price__main" data-vat-mode="incl">
    {%- if show_from -%}<span class="price__from">{{ 'price.from' | t }}</span>{%- endif -%}
    <span class="price__value">{%- if on_sale -%}<span class="visually-hidden">{{ 'price.sale' | t }}</span>{%- endif -%}{{ p_fmt }}</span>
    {%- if on_sale -%}<s class="price__compare"><span class="visually-hidden">{{ 'price.regular' | t }}</span>{{ cp | money }}</s>{%- endif -%}
    <span class="price__label">{{ 'price.incl' | t }}</span>
  </div>
  <div class="price__main" data-vat-mode="excl">
    {%- if show_from -%}<span class="price__from">{{ 'price.from' | t }}</span>{%- endif -%}
    <span class="price__value">{%- if on_sale -%}<span class="visually-hidden">{{ 'price.sale' | t }}</span>{%- endif -%}{{ p_excl_fmt }}</span>
    {%- if on_sale -%}<s class="price__compare"><span class="visually-hidden">{{ 'price.regular' | t }}</span>{{ cp_excl | money }}</s>{%- endif -%}
    <span class="price__label">{{ 'price.excl' | t }}</span>
  </div>
  {%- if settings.price_show_secondary -%}
    <div class="price__alt" data-vat-mode="incl"><span class="price__value">{{ p_excl_fmt }}</span>&nbsp;{{ 'price.excl' | t }}</div>
    <div class="price__alt" data-vat-mode="excl"><span class="price__value">{{ p_fmt }}</span>&nbsp;{{ 'price.incl' | t }}</div>
  {%- endif -%}
</div>
