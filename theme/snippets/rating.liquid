{%- comment -%}
  Review stars. Renders ONLY when a review app provides product.metafields.reviews.rating (never fabricated).
  Params: product, show_count (bool)
{%- endcomment -%}
{%- assign rating_mf = product.metafields.reviews.rating -%}
{%- if rating_mf != blank and rating_mf.value != blank -%}
  {%- liquid
    assign r_value = rating_mf.value.rating | default: rating_mf.value
    assign r_max = rating_mf.value.scale_max | default: 5
    assign r_pct = r_value | times: 100.0 | divided_by: r_max | round: 1
    assign r_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count
  -%}
  <div class="rating" role="img" aria-label="{{ 'accessibility.rating' | t: rating: r_value, max: r_max }}">
    <span class="rating__stars" style="--pct: {{ r_pct }}%"></span>
    <span aria-hidden="true">{{ r_value | round: 1 }}</span>
    {%- if show_count and r_count != blank -%}
      <span class="muted">({{ 'accessibility.rating_count' | t: count: r_count }})</span>
    {%- endif -%}
  </div>
{%- endif -%}
