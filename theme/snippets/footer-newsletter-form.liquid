{%- comment -%}
  Newsletter form of the footer (customer form, tag newsletter); used in the top band or in a column. Validation speaks
  the brand's words instead of the browser's ('Vul je e-mailadres in.'); after a successful post the success message
  takes focus, so screen readers read it (a status message that is already there at load is not announced).
{%- endcomment -%}
{%- form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' -%}
  <input type="hidden" name="contact[tags]" value="newsletter">
  {%- if form.posted_successfully? -%}
    <p class="notice notice--success" role="status" tabindex="-1" data-newsletter-done>{%- render 'icon', icon: 'check' -%}<span>{{ 'newsletter.success' | t }}</span></p>
  {%- else -%}
    <div class="newsletter-form__row">
      <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'newsletter.label' | t }}</label>
      <input class="input" type="email" id="FooterNewsletterEmail" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.label' | t }}" data-msg-empty="{{ 'forms.error_required_email' | t | escape }}" data-msg-invalid="{{ 'forms.error_email' | t | escape }}"{% if form.errors %} aria-invalid="true" aria-describedby="FooterNewsletterError"{% endif %}>
      <button type="submit" class="btn">{{ 'newsletter.button' | t }}</button>
    </div>
    {%- if form.errors -%}<p class="field__error" id="FooterNewsletterError">{{ 'forms.error_email' | t }}</p>{%- endif -%}
    {%- if shop.privacy_policy -%}<p class="newsletter-form__note">{{ 'newsletter.privacy_html' | t: url: shop.privacy_policy.url }}</p>{%- endif -%}
  {%- endif -%}
{%- endform -%}
<script>
  (() => {
    const done = document.querySelector('[data-newsletter-done]');
    if (done) return done.focus();
    const f = document.getElementById('FooterNewsletterEmail');
    if (!f) return;
    f.addEventListener('invalid', () => f.setCustomValidity(f.validity.valueMissing ? f.dataset.msgEmpty : f.dataset.msgInvalid));
    f.addEventListener('input', () => f.setCustomValidity(''));
  })();
</script>
