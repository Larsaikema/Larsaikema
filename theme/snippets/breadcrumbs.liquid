{%- comment -%} Visible breadcrumbs. JSON-LD BreadcrumbList lives in snippets/structured-data. {%- endcomment -%}
<nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
  <ol>
    <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
    {%- case request.page_type -%}
      {%- when 'product' -%}
        {%- assign crumb_collection = collection | default: product.collections.first -%}
        {%- if crumb_collection and crumb_collection.handle != 'all' and crumb_collection.handle != 'frontpage' -%}
          <li><a href="{{ crumb_collection.url }}">{{ crumb_collection.title }}</a></li>
        {%- endif -%}
        <li><span aria-current="page">{{ product.title | replace: ' x ', ' × ' }}</span></li>
      {%- when 'collection' -%}
        <li><a href="{{ routes.collections_url }}">{{ 'search.collections' | t }}</a></li>
        <li><span aria-current="page">{{ collection.title }}</span></li>
      {%- when 'article' -%}
        <li><a href="{{ blog.url }}">{{ blog.title }}</a></li>
        <li><span aria-current="page">{{ article.title }}</span></li>
      {%- when 'blog' -%}
        <li><span aria-current="page">{{ blog.title }}</span></li>
      {%- when 'page' -%}
        <li><span aria-current="page">{{ page.title }}</span></li>
      {%- when 'search' -%}
        <li><span aria-current="page">{{ 'search.title' | t }}</span></li>
      {%- else -%}
        <li><span aria-current="page">{{ page_title }}</span></li>
    {%- endcase -%}
  </ol>
</nav>
