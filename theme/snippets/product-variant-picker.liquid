{%- comment -%}
  Variant picker of the main product (colour swatches as a native radio group, other options as pills). Params: product,
  block (section block: size_option_names, size_guide_page), section_id, is_print (bool). The variants JSON feeds
  variant-picker.js; 'print' says per variant whether the logo-upload block applies (snippets/print-active).

  Size switch across products (feature product.size-switch): a line that is split into one product per size links
  its sizes with custom.andere_maten (list.product_reference, catalog/CONTRACT.md). Those sizes are shown as pills in
  the size option, sorted by size (snippets/size-siblings-order): the current size is the chosen pill, the others are
  links to the sibling product with the same other options (colour, uitvoering) preselected via ?variant=; a size without
  that combination links to its closest variant (most shared values, available first: Heavy duty PVC / Zwart opens the
  5 × 5 m as Polyester / Zwart) and says 'niet in Heavy duty PVC' instead of a price, never 'niet leverbaar'.
  variant-picker.js keeps those links in step when the colour changes.

  assets/variant-picker.js (comments stripped there for the JS budget): <variant-picker> finds the variant (or the nearest
  available one with the changed value), sets the radios and size-sibling links (price, or 'niet in Heavy duty PVC');
  <product-info> sets ?variant=, the form id and offerte fields, shows/hides the print block, emits 'variant:change',
  fetches the section (Section Rendering API, cached) and swaps the [data-dynamic] parts and option availability, then
  emits 'variant:rendered' ({ failed: true } when the fetch fails) and announces option, price and stock (WCAG 4.1.3).
  Details band: specs/downloads are accordions on phones and open cards with an h2 from 990 px; the description is
  clamped on phones ('Lees verder'); in-page links to an accordion (#ProductQuote) open and focus it. Backorder / lead
  time: 'Verwacht in huis: 3 – 10 nov' from the lead-time text ('Leverbaar over 2–3 weken', '5 werkdagen'; not when it
  counts from something else, '… na akkoord drukproef'), the shipping days and transit (KK.delivery.compute).
{%- endcomment -%}
{%- liquid
  # sizes read '3 × 3 m' (non-breaking, like the product cards); option values themselves stay '3 x 3 m'
  assign times_nb = ' × '
  assign swatch_names = settings.swatch_option_names | downcase | split: ','
  # Maatgids + size help belong to the size option only (Maat, Tafelmaat, Diameter, ...), never to colour.
  assign size_names_lc = block.settings.size_option_names | default: 'Maat, Tafelmaat, Diameter, Afmeting, Formaat' | downcase | replace: ', ', ',' | replace: ' ,', ',' | strip | split: ','
  assign guide_page = product.metafields.custom.maatgids.value | default: block.settings.size_guide_page
  # Option hints: a spec row (custom.specificaties) whose label is an option value and whose group is in the block
  # setting hint_groups (default 'Pasvorm') or is named after the option itself shows under that option for the chosen
  # value: 'Ø80-85 cm' -> 'Bladen Ø 80–85 cm, tafelhoogte 105–115 cm', 'Met topcover' -> 'Rok en losse topcover in
  # dezelfde kleur'. variant-picker.js swaps it on change.
  assign vp_specs = product.metafields.custom.specificaties.value
  assign hint_groups = block.settings.hint_groups | default: 'Pasvorm' | downcase | replace: ', ', ',' | split: ','
  assign current_variant = product.selected_or_first_available_variant
  assign size_index = -1
  for option in product.options_with_values
    assign on = option.name | downcase | strip
    if size_names_lc contains on
      assign size_index = forloop.index0
      break
    endif
  endfor

  # price under each size pill (block setting size_prices): the variant with that size and the current other options
  assign show_size_prices = false
  if block.settings.size_prices
    if size_index != -1 or product.metafields.custom.andere_maten != blank
      assign show_size_prices = true
    endif
  endif

  assign siblings = product.metafields.custom.andere_maten.value
  assign has_siblings = false
  if siblings != blank and siblings.size > 0
    assign has_siblings = true
  endif
  assign sib_before = ''
  assign sib_after = ''
  if has_siblings
    capture sib_order
      render 'size-siblings-order', product: product, siblings: siblings, size_names: size_names_lc
    endcapture
    # key of the current variant without its size: 'Kleur=Wit|Uitvoering=Polyester|'
    capture cur_key
      for option in product.options_with_values
        assign on = option.name | downcase | strip
        unless size_names_lc contains on
          echo option.name | append: '=' | append: current_variant.options[forloop.index0] | append: '|'
        endunless
      endfor
    endcapture
    capture key_names
      echo '['
      for option in product.options_with_values
        assign on = option.name | downcase | strip
        if size_names_lc contains on
          echo 'null'
        else
          echo option.name | json
        endif
        unless forloop.last
          echo ','
        endunless
      endfor
      echo ']'
    endcapture
    capture sib_pills
      assign sib_idx = sib_order | split: ','
      for si in sib_idx
        assign sin = si | plus: 0
        if sin == 0
          echo '__SELF__'
          continue
        endif
        assign sj = sin | minus: 1
        assign sp = siblings[sj]
        if sp == blank
          continue
        endif
        capture sp_label
          render 'size-label', p: sp, size_names: size_names_lc
        endcapture
        if sp_label == blank
          assign sp_label = sp.title
        endif
        assign sp_label = sp_label | replace: ' x ', times_nb
        assign m_id = ''
        assign m_av = sp.available
        assign m_price = sp.price
        assign m_from = sp.price_varies
        # best other match when this size lacks the exact colour / uitvoering: the variant that shares the most option
        # values (Heavy duty PVC / Zwart -> Polyester / Zwart), available first; variant-picker.js scores the same way
        assign b_id = ''
        assign b_score = -1
        capture vmap
          echo '{'
          for v in sp.variants
            assign v_score = 0
            capture vk
              for option in sp.options_with_values
                assign on = option.name | downcase | strip
                unless size_names_lc contains on
                  echo option.name | append: '=' | append: v.options[forloop.index0] | append: '|'
                endunless
              endfor
            endcapture
            for option in sp.options_with_values
              assign on = option.name | downcase | strip
              unless size_names_lc contains on
                assign pair = option.name | append: '=' | append: v.options[forloop.index0] | append: '|'
                if cur_key contains pair
                  assign v_score = v_score | plus: 2
                endif
              endunless
            endfor
            if v.available
              assign v_score = v_score | plus: 1
            endif
            if v_score > b_score
              assign b_score = v_score
              assign b_id = v.id
              assign b_av = v.available
              assign b_price = v.price
            endif
            if vk == cur_key and m_id == ''
              assign m_id = v.id
              assign m_av = v.available
              assign m_price = v.price
              assign m_from = false
            endif
            echo vk | json | append: ':[' | append: v.id | append: ',' | append: v.available | append: ',' | append: v.price | append: ']'
            unless forloop.last
              echo ','
            endunless
          endfor
          echo '}'
        endcapture
        # no variant of this size in the current colour / uitvoering (2 x 2 m has no Heavy duty PVC): the pill says
        # 'niet in Heavy duty PVC' instead of a price and links to the sibling's default variant
        assign sp_miss = ''
        if m_id == ''
          assign m_av = false
          if b_id != ''
            assign m_id = b_id
            assign m_av = b_av
            assign m_price = b_price
            assign m_from = false
          endif
          for option in product.options_with_values
            assign on = option.name | downcase | strip
            if size_names_lc contains on or sp_miss != ''
              continue
            endif
            assign cv = current_variant.options[forloop.index0]
            assign sp_found = false
            for so in sp.options_with_values
              if so.name == option.name
                for sv in so.values
                  assign svn = sv.name | default: sv
                  if svn == cv
                    assign sp_found = true
                  endif
                endfor
              endif
            endfor
            unless sp_found
              assign sp_miss = cv
            endunless
          endfor
        endif
        if show_size_prices
          capture sp_label_html
            echo '<span class="vp__pill-label">' | append: sp_label | append: '</span><span class="vp__pill-price" data-sibling-price>'
            if m_from
              echo 'price.from' | t | append: ' '
            endif
            if sp_miss != ''
              echo 'product.sibling_missing' | t: value: sp_miss
            else
              render 'vat-money', cents: m_price
            endif
            echo '</span>'
          endcapture
          assign sp_label = sp_label_html
        endif
        assign sp_note = ''
        if sp_miss != ''
          assign sp_note = 'product.sibling_missing' | t: value: sp_miss
        endif
        render 'size-sibling-link', sp: sp, label: sp_label, variant_id: m_id, available: m_av, vmap: vmap, note: sp_note, prices: show_size_prices
      endfor
    endcapture
    assign sib_parts = sib_pills | split: '__SELF__'
    assign sib_before = sib_parts[0]
    assign sib_after = sib_parts[1]
  endif
-%}
<variant-picker class="vp js-only" data-section-id="{{ section_id }}"{% if has_siblings %} data-key-names="{{ key_names | escape }}" data-miss-tpl="{{ 'product.sibling_missing' | t: value: '__VALUE__' | escape }}"{% endif %} {{ block.shopify_attributes }}>
  {%- if has_siblings and size_index == -1 -%}
    {%- capture self_label -%}{%- render 'size-label', p: product, size_names: size_names_lc -%}{%- endcapture -%}
    {%- if self_label == blank -%}{%- assign self_label = product.title -%}{%- endif -%}
    {%- assign self_label = self_label | replace: ' x ', times_nb -%}
    <div class="vp__option" role="group" aria-labelledby="SizeSiblings-{{ section_id }}">
      <p class="vp__legend" id="SizeSiblings-{{ section_id }}"><span class="vp__name">{{ 'product.size_label' | t }}:</span> <span class="vp__selected">{{ self_label }}</span></p>
      <div class="vp__values">{{ sib_before }}<span class="vp__pill" aria-current="true">{%- if show_size_prices -%}<span class="vp__pill-label">{{ self_label }}</span><span class="vp__pill-price">{%- render 'vat-money', cents: current_variant.price -%}</span>{%- else -%}{{ self_label }}{%- endif -%}</span>{{ sib_after }}</div>
    </div>
  {%- endif -%}
  {%- unless product.has_only_default_variant -%}
  {%- for option in product.options_with_values -%}
    {%- assign opt_name = option.name | downcase | strip -%}
    {%- assign is_swatch = false -%}
    {%- for n in swatch_names -%}{%- assign nn = n | strip -%}{%- if nn == opt_name -%}{%- assign is_swatch = true -%}{%- endif -%}{%- endfor -%}
    {%- assign option_index = forloop.index0 -%}
    {%- assign with_siblings = false -%}
    {%- if has_siblings and option_index == size_index -%}{%- assign with_siblings = true -%}{%- endif -%}
    {%- comment -%}
      Price under each pill (block setting size_prices) when the price depends on this option (sizes, Polyester vs
      Heavy duty PVC): the variant with that value and the current other options, else the first variant with that value.
    {%- endcomment -%}
    {%- assign show_opt_prices = false -%}
    {%- assign opt_price_list = '' | split: ',' -%}
    {%- if block.settings.size_prices and is_swatch == false -%}
      {%- assign opt_prices = '' -%}
      {%- assign first_p = '' -%}
      {%- for value in option.values -%}
        {%- assign vname = value.name | default: value -%}
        {%- assign pp = '' -%}
        {%- assign pp_any = '' -%}
        {%- for v in product.variants -%}
          {%- if v.options[option_index] != vname -%}{%- continue -%}{%- endif -%}
          {%- if pp_any == '' -%}{%- assign pp_any = v.price -%}{%- endif -%}
          {%- assign v_hit = true -%}
          {%- for o in v.options -%}
            {%- unless forloop.index0 == option_index -%}{%- if o != current_variant.options[forloop.index0] -%}{%- assign v_hit = false -%}{%- endif -%}{%- endunless -%}
          {%- endfor -%}
          {%- if v_hit -%}{%- assign pp = v.price -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
        {%- if pp == '' -%}{%- assign pp = pp_any -%}{%- endif -%}
        {%- assign opt_prices = opt_prices | append: pp | append: ',' -%}
        {%- if forloop.first -%}{%- assign first_p = pp -%}{%- elsif pp != first_p -%}{%- assign show_opt_prices = true -%}{%- endif -%}
      {%- endfor -%}
      {%- assign opt_price_list = opt_prices | split: ',' -%}
      {%- if with_siblings -%}{%- assign show_opt_prices = true -%}{%- endif -%}
    {%- endif -%}
    {%- comment -%} the group is named by its name and value only ('Maat: 3 × 3 m'), not by the Maatgids link in the legend {%- endcomment -%}
    {%- capture opt_label_id -%}OptLabel-{{ section_id }}-{{ option_index }}{%- endcapture -%}
    <fieldset class="vp__option{% if is_swatch %} vp__option--swatch{% endif %}" data-option-index="{{ option_index }}" aria-labelledby="{{ opt_label_id }}">
      <legend class="vp__legend">
        <span id="{{ opt_label_id }}"><span class="vp__name">{{ option.name }}:</span> <span class="vp__selected" data-selected-value>{{ option.selected_value | replace: ' x ', times_nb }}</span></span>
        {%- if option_index == size_index and guide_page != blank -%}
          <a class="vp__guide link" href="{{ guide_page.url }}">{%- render 'icon', icon: 'ruler', class: 'icon--xs' -%}{{ 'product.size_guide' | t }}</a>
        {%- endif -%}
      </legend>
      {%- liquid
        # swatches: as many per row as fit (12 / 10 / 8 / 7 / 6 by width band), spread over the fewest rows so every row
        # holds about the same number (24 colours: 2 x 12, 3 x 8, never 11 + 11 + 2)
        assign sw_cols = ''
        if is_swatch
          assign n = option.values.size
          for cap in (6..12)
            assign rows = n | plus: cap | minus: 1 | divided_by: cap
            assign cols = n | plus: rows | minus: 1 | divided_by: rows
            assign sw_cols = sw_cols | append: '--c' | append: cap | append: ':' | append: cols | append: ';'
          endfor
        endif
      -%}
      <div class="vp__values"{% if sw_cols != blank %} style="{{ sw_cols }}"{% endif %}>
        {%- if with_siblings -%}{{ sib_before }}{%- endif -%}
        {%- for value in option.values -%}
          {%- capture input_id -%}Opt-{{ section_id }}-{{ option_index }}-{{ forloop.index0 }}{%- endcapture -%}
          <input class="vp__input" type="radio" id="{{ input_id }}" name="option-{{ section_id }}-{{ option_index }}" value="{{ value | escape }}"{% if value.selected %} checked{% endif %}{% unless value.available %} data-unavailable{% endunless %}>
          {%- if is_swatch -%}
            {%- capture sw_style -%}{%- render 'swatch', value: value, mode: 'css' -%}{%- endcapture -%}
            <label for="{{ input_id }}" class="vp__swatch{% unless value.available %} is-unavailable{% endunless %}" title="{{ value | escape }}">
              <span class="swatch" style="{{ sw_style }}"></span>
              <span class="visually-hidden">{{ value }}{% unless value.available %}, {{ 'product.option_unavailable' | t }}{% endunless %}</span>
            </label>
          {%- else -%}
            {%- assign pill_price = opt_price_list[forloop.index0] -%}
            <label for="{{ input_id }}" class="vp__pill{% unless value.available %} is-unavailable{% endunless %}">
              {%- if show_opt_prices and pill_price != blank -%}<span class="vp__pill-label">{{ value | replace: ' x ', times_nb }}</span><span class="vp__pill-price">{%- render 'vat-money', cents: pill_price -%}</span>{%- else -%}{{ value | replace: ' x ', times_nb }}{%- endif -%}
              {%- unless value.available %}<span class="visually-hidden">, {{ 'product.option_unavailable' | t }}</span>{% endunless -%}
            </label>
          {%- endif -%}
        {%- endfor -%}
        {%- if with_siblings -%}{{ sib_after }}{%- endif -%}
      </div>
      {%- if vp_specs != blank -%}
        {%- assign on_lc = option.name | downcase | strip -%}
        {%- for value in option.values -%}
          {%- assign vname = value.name | default: value -%}
          {%- for row in vp_specs -%}
            {%- assign rg = row.groep | downcase | strip -%}
            {%- if row.label == vname and row.waarde != blank -%}
              {%- if hint_groups contains rg or rg == on_lc -%}
                <p class="vp__hint" data-hint="{{ vname | escape }}"{% unless value.selected %} hidden{% endunless %}>{%- render 'icon', icon: 'check', class: 'icon--xs' -%}<span>{{ row.waarde }}</span></p>
                {%- break -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
    </fieldset>
  {%- endfor -%}
  {%- endunless -%}
  <script type="application/json" data-variants>
    [{%- for v in product.variants -%}
      {%- capture v_print -%}{%- if is_print -%}{%- render 'print-active', product: product, variant: v -%}{%- else -%}false{%- endif -%}{%- endcapture -%}
      {%- liquid
        # max: the quantity limit for the stepper (quantity rule, or tracked stock that cannot be oversold); 0 = none
        assign v_max = v.quantity_rule.max | default: 0
        if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' and v.inventory_quantity > 0
          if v_max == 0 or v.inventory_quantity < v_max
            assign v_max = v.inventory_quantity
          endif
        endif
        # ad: this variant's add-ons (custom.addon_varianten) as [add-on product id, variant id, price, quantity, type], so
        # product-form.js swaps the ticked add-ons the moment the variant changes, before the section HTML arrives
        assign v_avs = v.metafields.custom.addon_varianten.value
        assign v_aqs = v.metafields.custom.addon_aantallen.value
        assign v_ad = 'null'
        if v_avs != blank
          capture v_ad
            for a in v_avs
              if a.available
                assign v_aq = v_aqs[forloop.index0] | default: 1
                assign v_at = a.product.type | json
                echo ',[' | append: a.product.id | append: ',' | append: a.id | append: ',' | append: a.price | append: ',' | append: v_aq | append: ',' | append: v_at | append: ']'
              endif
            endfor
          endcapture
          assign v_ad = v_ad | remove_first: ',' | prepend: '[' | append: ']'
        endif
      -%}
      {"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available | json }},"price":{{ v.price }},"compare_at_price":{{ v.compare_at_price | default: 0 }},"media_id":{{ v.featured_media.id | default: 0 }},"max":{{ v_max }},"print":{{ v_print }},"ad":{{ v_ad }}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}]
  </script>
</variant-picker>
