{%- comment -%}
  Progress to free shipping (theme setting free_shipping_threshold, incl. btw). The threshold only applies to parcels:
  as soon as a pallet product (custom.verzending = pallet or tag pallet) or a product with its own shipping cost
  (custom.verzendkosten) is in the cart, the bar is left out and the summary shows that cost instead (cart-shipping),
  so the cart never promises free shipping it cannot give. The progressbar is named by its visible text, which follows
  the btw switch.
  Param: hide_done (bool, drawer) leaves the block out once the threshold is reached (the totals say 'Gratis').
{%- endcomment -%}
{%- liquid
  assign fs_threshold = settings.free_shipping_threshold | default: 0 | times: 100
  assign fs_skip = false
  for item in cart.items
    assign fs_cls = item.product.metafields.custom.verzending.value | default: 'pakket' | downcase
    if fs_cls == 'pallet' or item.product.tags contains 'pallet' or item.product.metafields.custom.verzendkosten.value != blank
      assign fs_skip = true
      break
    endif
  endfor
  assign fs_id = 'FreeShip-page'
  if hide_done
    assign fs_id = 'FreeShip-drawer'
  endif
-%}
{%- if settings.cart_free_shipping_bar and fs_threshold > 0 and cart.item_count > 0 and fs_skip == false and cart.requires_shipping -%}
  {%- liquid
    assign fs_remaining = fs_threshold | minus: cart.total_price
    assign fs_pct = cart.total_price | times: 100 | divided_by: fs_threshold | at_most: 100
  -%}
  {%- capture fs_shown -%}{%- render 'vat-money', cents: fs_remaining -%}{%- endcapture -%}{%- assign fs_shown = fs_shown | strip -%}
  {%- unless hide_done and fs_remaining <= 0 -%}
  <div class="free-ship{% if fs_remaining <= 0 %} free-ship--done{% endif %}">
    <p class="free-ship__text">
      {%- render 'icon', icon: 'truck', class: 'icon--sm' -%}
      <span id="{{ fs_id }}">{%- if fs_remaining > 0 -%}{{ 'cart.free_shipping_remaining_html' | t: amount: fs_shown }}{%- else -%}{{ 'cart.free_shipping_reached' | t }}{%- endif -%}</span>
    </p>
    {%- if fs_remaining > 0 -%}
      <div class="free-ship__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ fs_pct }}" aria-labelledby="{{ fs_id }}"><span style="width: {{ fs_pct }}%"></span></div>
    {%- endif -%}
  </div>
  {%- endunless -%}
{%- endif -%}
