{%- liquid
  assign fs_threshold = settings.free_shipping_threshold | default: 0 | times: 100
-%}
{%- if settings.cart_free_shipping_bar and fs_threshold > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign fs_remaining = fs_threshold | minus: cart.total_price
    assign fs_pct = cart.total_price | times: 100 | divided_by: fs_threshold | at_most: 100
    assign fs_money = fs_remaining | money
  -%}
  <div class="free-ship{% if fs_remaining <= 0 %} free-ship--done{% endif %}">
    <p class="free-ship__text">
      {%- render 'icon', icon: 'truck', class: 'icon--sm' -%}
      <span>{%- if fs_remaining > 0 -%}{{ 'cart.free_shipping_remaining_html' | t: amount: fs_money }}{%- else -%}{{ 'cart.free_shipping_reached' | t }}{%- endif -%}</span>
    </p>
    <div class="free-ship__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ fs_pct }}" aria-label="{{ 'cart.free_shipping_reached' | t }}"><span style="width: {{ fs_pct }}%"></span></div>
  </div>
{%- endif -%}
