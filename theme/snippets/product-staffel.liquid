{%- comment -%}
  Staffel (feature product.staffelkorting, custom.staffelkorting) as a compact tier strip next to the quantity: one cell
  per tier with the unit price; product-form.js marks the tier that matches the quantity.
  - staffel_mode 'automatic' (a real Shopify automatic discount exists): a tier is a button that sets the quantity, and
    the hint shows the price per piece plus the step to the next tier ('Nog 2 erbij voor 5% korting').
  - 'quote' (default until those discounts exist): the cart charges the normal price, so the block never promises a cart
    discount. The title says it first ('Staffelprijs met offerte'), then the tiers as offerte prices, 'Deze prijzen krijg je
    met een offerte, ook als particulier of vereniging.' plus the reply time (settings.response_time) and the link that opens
    the inline offerte form with the quantity filled in (product-form.js); for a quantity in a tier the hint compares the
    cart total with the offerte total. main-product then leaves out its separate Zakelijk nudge.
  - 'hide': the tiers only, no hint and no promise.
  Params: product, block, section_id, current_variant, staffel (parsed metafield), quote_url, nudge_url ('#ProductQuote'
  when the section has the inline offerte form), is_config + unit (a configurator product counts in its unit, e.g. m²).
{%- endcomment -%}
{%- if staffel != blank and staffel.size > 0 and current_variant.available == false -%}
  {%- comment -%} sold-out variant: no tiers under a disabled button; the empty slot lets the next variant swap them back {%- endcomment -%}
  <div data-dynamic="staffel" hidden></div>
{%- elsif staffel != blank and staffel.size > 0 -%}
  {%- liquid
    assign staffel_mode = settings.staffel_mode | default: 'quote'
    assign staffel_auto = false
    if staffel_mode == 'automatic'
      assign staffel_auto = true
    endif
    assign s_unit = ''
    if is_config
      assign s_unit = unit | default: ''
    endif
    assign s_pcs = 'product.staffel_pcs' | t
    assign s_word = 'product.staffel_pieces' | t
    assign s_each = 'product.staffel_each' | t
    if s_unit != ''
      assign s_pcs = s_unit
      assign s_word = s_unit
      assign s_each = 'price.per_unit' | t: unit: s_unit
    endif
    assign s_quote_url = nudge_url
    if s_quote_url == blank
      assign s_quote_url = quote_url | append: '?product=' | append: product.handle | append: '&variant=' | append: current_variant.id
    endif
  -%}
  {%- if staffel_mode == 'quote' -%}
    {%- comment -%}
      Quote mode: one calm 'Staffelprijs met offerte' box under the buy area. The title says up front that these prices
      come with an offerte (never read as a cart price), the foot says so again and that anyone can ask (particulier,
      vereniging, bedrijf), and the link opens the inline offerte form with the quantity filled in.
      The hint compares the cart total with the offerte total once the quantity reaches a tier.
    {%- endcomment -%}
    <div class="staffel staffel--quote" data-dynamic="staffel" data-staffel="{{ staffel | json | escape }}" data-mode="quote" data-unit-price="{{ current_variant.price }}" role="group" aria-labelledby="StaffelTitle-{{ section_id }}" {{ block.shopify_attributes }}>
      <div class="staffel__head">
        {%- render 'icon', icon: 'case', class: 'icon--sm' -%}
        <p class="staffel__title" id="StaffelTitle-{{ section_id }}">{{ 'product.staffel_title_quote' | t }}</p>
      </div>
      <ul class="staffel__tiers" role="list" style="--tiers: {{ staffel.size }}">
        {%- for tier in staffel -%}
          {%- assign tier_off = current_variant.price | times: tier.korting | divided_by: 100.0 | round -%}
          {%- assign tier_cents = current_variant.price | minus: tier_off -%}
          <li class="staffel__tier" data-tier-min="{{ tier.vanaf }}">
            <span class="staffel__qty">{% if s_unit != '' %}{{ 'product.staffel_from_unit' | t: qty: tier.vanaf, unit: s_unit }}{% else %}{{ 'product.staffel_from' | t: qty: tier.vanaf }}{% endif %}</span>
            <span class="staffel__price">{%- render 'staffel-price', cents: tier_cents -%}<span class="visually-hidden"> {{ s_each }}</span></span>
            <span class="staffel__off">−{{ tier.korting | replace: '.', ',' }}%<span class="visually-hidden"> {{ 'product.staffel_discount' | t | downcase }}</span></span>
          </li>
        {%- endfor -%}
      </ul>
      <p class="staffel__hint" data-staffel-hint aria-live="polite" data-tpl="{{ 'product.staffel_quote_hint_html' | t: qty: '__QTY__', unit: s_word, quote: '__QUOTE__', cart: '__CART__' | escape }}"></p>
      <p class="staffel__foot">{{ 'product.staffel_foot_quote' | t }}{% if settings.response_time != blank %} {{ settings.response_time }}{% endif %} <a class="link" href="{{ s_quote_url }}" data-quote-link{% if s_quote_url == '#ProductQuote' %} data-open-details{% endif %}>{{ 'product.quote_cta' | t }}</a></p>
    </div>
  {%- else -%}
  <div class="staffel staffel--{{ staffel_mode }}" data-dynamic="staffel" data-staffel="{{ staffel | json | escape }}" data-mode="{{ staffel_mode }}" data-unit-price="{{ current_variant.price }}" role="group" aria-labelledby="StaffelTitle-{{ section_id }}" {{ block.shopify_attributes }}>
    <div class="staffel__head">
      <p class="staffel__title" id="StaffelTitle-{{ section_id }}">{{ 'product.staffel_title' | t }}</p>
      {%- if staffel_auto -%}<p class="staffel__note">{{ 'product.staffel_note' | t }}</p>{%- endif -%}
    </div>
    <ul class="staffel__tiers" role="list" style="--tiers: {{ staffel.size | plus: 1 }}">
      {%- assign first_tier = staffel.first.vanaf | minus: 1 -%}
      <li class="staffel__tier" data-tier-min="1">
        {%- if staffel_auto -%}<button type="button" class="staffel__btn" data-staffel-qty="1">{%- endif -%}
        <span class="staffel__qty">{% if first_tier > 1 %}1–{{ first_tier }}{% else %}1{% endif %} {{ s_pcs }}</span>
        <span class="staffel__price">{%- render 'staffel-price', cents: current_variant.price -%}<span class="visually-hidden"> {{ s_each }}</span></span>
        <span class="staffel__off">&nbsp;</span>
        {%- if staffel_auto -%}</button>{%- endif -%}
      </li>
      {%- for tier in staffel -%}
        {%- assign tier_off = current_variant.price | times: tier.korting | divided_by: 100.0 | round -%}
        {%- assign tier_cents = current_variant.price | minus: tier_off -%}
        <li class="staffel__tier" data-tier-min="{{ tier.vanaf }}">
          {%- if staffel_auto -%}<button type="button" class="staffel__btn" data-staffel-qty="{{ tier.vanaf }}">{%- endif -%}
          <span class="staffel__qty">{% if s_unit != '' %}{{ 'product.staffel_from_unit' | t: qty: tier.vanaf, unit: s_unit }}{% else %}{{ 'product.staffel_from' | t: qty: tier.vanaf }}{% endif %}</span>
          <span class="staffel__price">{%- render 'staffel-price', cents: tier_cents -%}<span class="visually-hidden"> {{ s_each }}</span></span>
          <span class="staffel__off">−{{ tier.korting | replace: '.', ',' }}%<span class="visually-hidden"> {{ 'product.staffel_discount' | t | downcase }}</span></span>
          {%- if staffel_auto -%}</button>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if staffel_auto -%}<p class="staffel__hint" data-staffel-hint aria-live="polite"></p>{%- endif -%}
  </div>
  {%- endif -%}
{%- endif -%}
