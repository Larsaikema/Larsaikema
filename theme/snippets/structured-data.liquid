{%- comment -%}
  JSON-LD: Organization + WebSite/SearchAction (home), Product with one Offer per variant, BreadcrumbList,
  FAQPage for product FAQ metafield. AggregateRating ONLY from review-app metafields (never fabricated).
{%- endcomment -%}
{%- liquid
  assign org_phone = settings.phone | default: shop.phone
  assign org_email = settings.email | default: shop.email
  assign org_name = settings.company_name | default: shop.name
-%}
{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ org_name | json }},
  "url": {{ request.origin | append: routes.root_url | json }},
  "logo": {{ 'mark-512.png' | asset_url | prepend: 'https:' | json }}
  {%- if org_email != blank or org_phone != blank -%},
  "contactPoint": [{ "@type": "ContactPoint", "contactType": "customer service", "availableLanguage": ["nl"]{% if org_phone != blank %}, "telephone": {{ org_phone | json }}{% endif %}{% if org_email != blank %}, "email": {{ org_email | json }}{% endif %} }]
  {%- endif -%}
  {%- assign same_as = '' -%}
  {%- assign social_keys = 'social_instagram,social_facebook,social_linkedin,social_youtube,social_tiktok,social_pinterest' | split: ',' -%}
  {%- for s in social_keys -%}
    {%- if settings[s] != blank -%}{%- assign same_as = same_as | append: settings[s] | append: '|' -%}{%- endif -%}
  {%- endfor -%}
  {%- if same_as != '' -%},
  "sameAs": {{ same_as | split: '|' | json }}
  {%- endif %}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ request.origin | append: routes.root_url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    {%- capture search_target -%}{{ request.origin }}{{ routes.search_url }}?q={search_term_string}{%- endcapture %}
    "target": {{ search_target | json }},
    "query-input": "required name=search_term_string"
  }
}
</script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- liquid
    assign sd_seller = org_name
    assign rating_mf = product.metafields.reviews.rating
  -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  "description": {{ product.description | replace: '</p>', ' </p>' | replace: '</li>', '; </li>' | replace: '</h2>', ': </h2>' | replace: '</h3>', ': </h3>' | replace: '<br>', ' ' | strip_html | replace: '.;', '.' | split: ' ' | join: ' ' | truncate: 5000 | json }},
  {%- if product.featured_media -%}
  "image": [{% for media in product.media limit: 6 %}{{ media.preview_image | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
  {%- endif -%}
  {%- if product.selected_or_first_available_variant.sku != blank -%}
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  {%- endif -%}
  "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
  {%- if rating_mf != blank and rating_mf.value != blank and product.metafields.reviews.rating_count != blank -%}
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": {{ rating_mf.value.rating | json }}, "bestRating": {{ rating_mf.value.scale_max | json }}, "worstRating": {{ rating_mf.value.scale_min | json }}, "reviewCount": {{ product.metafields.reviews.rating_count.value | json }} },
  {%- endif -%}
  "offers": [
    {%- for v in product.variants -%}
    {
      "@type": "Offer",
      "url": {{ request.origin | append: v.url | json }},
      {%- if v.sku != blank -%}"sku": {{ v.sku | json }},{%- endif -%}
      {%- if v.barcode != blank -%}"gtin": {{ v.barcode | json }},{%- endif -%}
      "name": {{ v.title | json }},
      "price": {{ v.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "itemCondition": "https://schema.org/NewCondition",
      "availability": "https://schema.org/{% if v.available %}{% if v.inventory_management != blank and v.inventory_quantity <= 0 %}BackOrder{% else %}InStock{% endif %}{% else %}OutOfStock{% endif %}",
      "seller": { "@type": "Organization", "name": {{ sd_seller | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
  {%- assign faq = product.metafields.custom.faq.value -%}
  {%- if faq != blank and faq.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in faq -%}
    { "@type": "Question", "name": {{ item.vraag | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.antwoord | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
  {%- endif -%}
{%- endif -%}

{%- comment -%} Collection pages: sections/main-collection outputs the BreadcrumbList of its visible menu trail. {%- endcomment -%}
{%- if request.page_type == 'product' or request.page_type == 'article' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ 'general.home' | t | json }}, "item": {{ request.origin | append: routes.root_url | json }} },
    {%- case request.page_type -%}
      {%- when 'product' -%}
        {%- assign bc = collection | default: product.collections.first -%}
        {%- if bc and bc.handle != 'all' -%}
    { "@type": "ListItem", "position": 2, "name": {{ bc.title | json }}, "item": {{ request.origin | append: bc.url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
        {%- else -%}
    { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
        {%- endif -%}
      {%- when 'article' -%}
    { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ request.origin | append: blog.url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ request.origin | append: article.url | json }} }
    {%- endcase -%}
  ]
}
</script>
{%- endif -%}
