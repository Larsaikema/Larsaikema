<!doctype html>
{%- liquid
  assign vat_mode = 'incl'
  if settings.price_display == 'excl'
    assign vat_mode = 'excl'
  endif
  assign is_b2b = false
  if customer and settings.b2b_customer_tag != blank and customer.tags contains settings.b2b_customer_tag
    assign is_b2b = true
    if settings.b2b_excl_first
      assign vat_mode = 'excl'
    endif
  endif
-%}
<html class="no-js" lang="{{ request.locale.iso_code }}" data-vat="{{ vat_mode }}" data-price-display="{{ settings.price_display }}"{% if is_b2b %} data-b2b{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_zand }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 192, height: 192 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}" data-favicon>
    {%- endif -%}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- unless settings.type_heading_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_heading_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}
    {%- unless settings.type_body_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'pagination.page' | t: number: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'section-header.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      {%- if settings.price_display == 'toggle' and is_b2b == false %}
      try { var kkVat = localStorage.getItem('kk:vat'); if (kkVat === 'incl' || kkVat === 'excl') document.documentElement.dataset.vat = kkVat; } catch (e) {}
      {%- endif %}
      window.KK = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          search: {{ routes.search_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          recommendations: {{ routes.product_recommendations_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        priceDisplay: {{ settings.price_display | json }},
        vatRate: {{ settings.vat_rate | json }},
        moneyFormat: {{ shop.money_format | json }},
        faviconCart: {{ 'favicon-cart.svg' | asset_url | json }},
        strings: {
          adding: {{ 'product.adding' | t | json }},
          added: {{ 'product.added' | t | json }},
          addToCart: {{ 'product.add_to_cart' | t | json }},
          preOrder: {{ 'product.pre_order' | t | json }},
          excl: {{ 'price.excl' | t | json }},
          printRequired: {{ 'product.print_required' | t | json }},
          soldOut: {{ 'product.sold_out' | t | json }},
          unavailable: {{ 'product.unavailable' | t | json }},
          cartError: {{ 'cart.error' | t | json }},
          addError: {{ 'product.error_add' | t | json }},
          addedTitle: {{ 'cart.added_title' | t | json }},
          addedText: {{ 'cart.added_text' | t: title: '__TITLE__' | json }},
          fileTooBig: {{ 'product.print_file_too_big' | t | json }},
          countdown: {{ 'delivery.countdown_html' | t: time: '__TIME__' | json }},
          shipsToday: {{ 'delivery.ships_today_html' | t: time: '__TIME__' | json }},
          arrives: {{ 'delivery.arrives_html' | t: date: '__DATE__' | json }},
          etaShort: {{ 'delivery.eta_short' | t: date: '__DATE__' | json }},
          shipsOn: {{ 'delivery.ships_on_html' | t: date: '__DATE__' | json }},
          hours: {{ 'delivery.hours' | t: h: '__H__', m: '__M__' | json }},
          minutes: {{ 'delivery.minutes' | t: m: '__M__' | json }},
          today: {{ 'delivery.today' | t | json }},
          tomorrow: {{ 'delivery.tomorrow' | t | json }},
          staffelHint: {{ 'product.staffel_hint_html' | t: qty: '__QTY__', price: '__PRICE__' | json }},
          staffelNext: {{ 'product.staffel_next_html' | t: qty: '__QTY__', discount: '__DISCOUNT__' | json }},
          copied: {{ 'gift_card.copied' | t | json }},
          linkCopied: {{ 'product.link_copied' | t | json }},
          showResults: {{ 'collection.show_results_js' | t: count: '__COUNT__' | json }}
        }
      };
    </script>

    {{ content_for_header }}

    <script src="{{ 'global.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
    <script src="{{ 'delivery-countdown.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <div class="toast" id="Toast" role="status" aria-live="polite" aria-atomic="true" hidden></div>

    {% render 'structured-data' %}
  </body>
</html>
