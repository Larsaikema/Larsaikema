<div class="password color-{{ section.settings.color_scheme }}">
  <div class="password__flags divider-flags" aria-hidden="true"></div>
  <div class="password__inner">
    <div class="password__logo">{%- render 'logo', image: true -%}</div>
    <h1 class="password__title">{{ 'password.title' | t }}</h1>
    <p class="text-lg password__text">{% if shop.password_message != blank %}{{ shop.password_message }}{% else %}{{ 'password.text' | t }}{% endif %}</p>
    {%- form 'customer', id: 'PasswordNewsletter', class: 'password__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
      {%- if form.posted_successfully? -%}
        <p class="notice notice--success" role="status">{%- render 'icon', icon: 'check' -%}<span>{{ 'newsletter.success' | t }}</span></p>
      {%- else -%}
        <div class="newsletter-form__row">
          <label class="visually-hidden" for="PasswordEmail">{{ 'newsletter.label' | t }}</label>
          <input class="input" type="email" id="PasswordEmail" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.label' | t }}">
          <button type="submit" class="btn">{{ 'newsletter.button' | t }}</button>
        </div>
        {%- if form.errors -%}<p class="field__error">{{ 'forms.error_email' | t }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
    <details class="password__login"{% if form.errors %} open{% endif %}>
      <summary class="link">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'password__login-form' -%}
        <label class="field__label" for="StorePassword">{{ 'password.password' | t }}</label>
        <div class="newsletter-form__row">
          <input class="input" type="password" id="StorePassword" name="password" autocomplete="current-password"{% if form.errors %} aria-invalid="true"{% endif %}>
          <button type="submit" class="btn btn--secondary">{{ 'password.login' | t }}</button>
        </div>
        {%- if form.errors -%}<p class="field__error">{{ 'password.wrong' | t }}</p>{%- endif -%}
      {%- endform -%}
      <p class="text-sm muted">{{ 'password.admin' | t }}: <a class="link" href="/admin" rel="nofollow">/admin</a></p>
    </details>
  </div>
</div>
<style>
  .password{min-height:100vh;display:flex;flex-direction:column}
  .password__inner{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:18px;padding:48px 16px;max-width:560px;margin:0 auto;width:100%}
  .password__logo{width:180px;color:var(--c-inkt)}
  .password__title{margin:0}
  .password__text{margin:0;color:var(--muted)}
  .password__form{width:100%}
  .password .newsletter-form__row{display:flex;gap:8px;flex-wrap:wrap}
  .password .newsletter-form__row .input{flex:1 1 220px;min-width:0}
  .password__login{width:100%;margin-top:12px}
  .password__login summary{display:inline-block;font-weight:var(--font-body-weight-semibold)}
  .password__login-form{margin-top:14px;text-align:left}
</style>

{% schema %}
{
  "name": "Wachtwoordpagina",
  "class": "section-main-password",
  "settings": [ { "type": "color_scheme", "id": "color_scheme", "label": "Kleurschema", "default": "scheme-3" } ]
}
{% endschema %}
