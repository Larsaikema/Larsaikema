{%- comment -%}
  Garantie en klachten (feature service.warranty-page): the legal guarantee vs. the extra (manufacturer)
  warranty, how a complaint is handled, and a complaint form ({% form 'contact' %}) with order number, product,
  description and a link field for photos. Shopify contact forms cannot carry files, so the form says so and
  offers a link field + mail address instead of pretending to upload. Response time and warranty terms are
  owner-editable claims (theme settings / blocks, listed in docs/claims-to-confirm.md).
{%- endcomment -%}
{{ 'section-pages.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign phone = settings.phone | default: shop.phone
  assign phone_href = phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign email = settings.email | default: shop.email
  assign form_id = 'ComplaintForm-' | append: section.id
-%}
<div class="page-width">
  <header class="page-head">
    {%- render 'breadcrumbs' -%}
    <h1>{{ section.settings.heading | default: page.title }}</h1>
    {%- if page.content != blank -%}<div class="page-head__intro rte text-lg">{{ page.content }}</div>{%- endif -%}
  </header>

  <div class="page-body split">
    <div class="warranty">
      {%- assign cards = section.blocks | where: 'type', 'warranty' -%}
      {%- if cards.size > 0 -%}
        <ul class="warranty__cards" role="list">
          {%- for block in cards -%}
            <li class="warranty__card{% if block.settings.style == 'steen' %} warranty__card--steen{% endif %}" {{ block.shopify_attributes }}>
              <span class="benefit__icon" aria-hidden="true">{%- render 'icon', icon: block.settings.icon -%}</span>
              <h2 class="h4">{{ block.settings.title }}</h2>
              <div class="rte">{{ block.settings.text }}</div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- assign steps = section.blocks | where: 'type', 'step' -%}
      {%- if steps.size > 0 -%}
        <h2 class="h3 warranty__steps-title">{{ section.settings.steps_heading }}</h2>
        <ol class="warranty__steps" role="list">
          {%- for block in steps -%}
            <li {{ block.shopify_attributes }}><span class="step__num" aria-hidden="true">{{ forloop.index }}</span><div><h3 class="h4">{{ block.settings.title }}</h3><p class="muted">{{ block.settings.text }}</p></div></li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      <aside class="panel panel--steen warranty__contact" aria-labelledby="WarrantyContact-{{ section.id }}">
        <h2 class="panel__title" id="WarrantyContact-{{ section.id }}">{{ 'contact.info_title' | t }}</h2>
        <ul class="contact-list" role="list">
          {%- if phone != blank -%}<li><a href="tel:{{ phone_href }}">{%- render 'icon', icon: 'phone' -%}{{ phone }}</a></li>{%- endif -%}
          {%- if settings.whatsapp != blank -%}<li><a href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">{%- render 'icon', icon: 'whatsapp' -%}{{ 'contact.whatsapp_cta' | t }}</a></li>{%- endif -%}
          {%- if email != blank -%}<li><a href="mailto:{{ email }}">{%- render 'icon', icon: 'mail' -%}{{ email }}</a></li>{%- endif -%}
        </ul>
        {%- if settings.response_time != blank -%}<p class="muted text-sm">{{ settings.response_time }}</p>{%- endif -%}
      </aside>
    </div>

    <div class="panel" id="klacht">
      <h2 class="panel__title">{{ 'warranty.form_title' | t }}</h2>
      <p class="muted">{{ 'warranty.form_intro' | t }}</p>
      {%- form 'contact', id: form_id, class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="notice notice--success" role="status" tabindex="-1" autofocus>{%- render 'icon', icon: 'check' -%}<span><strong>{{ 'warranty.success' | t }}</strong>{{ settings.response_time }}</span></div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="notice notice--error" role="alert">{%- render 'icon', icon: 'alert' -%}<span><strong>{{ 'forms.error_heading' | t }}</strong>{% render 'form-errors', form: form %}</span></div>
          {%- endif -%}
          <input type="hidden" name="contact[Onderwerp]" value="{{ 'warranty.subject' | t | escape }}">
          <div class="form-grid form-grid--2">
            <div class="field">
              <label class="field__label" for="W-name">{{ 'forms.name' | t }} <span class="required" aria-hidden="true">*</span></label>
              <input class="input" id="W-name" type="text" name="contact[name]" autocomplete="name" required value="{{ form.name }}">
            </div>
            <div class="field">
              <label class="field__label" for="W-email">{{ 'forms.email' | t }} <span class="required" aria-hidden="true">*</span></label>
              <input class="input" id="W-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
            </div>
            <div class="field">
              <label class="field__label" for="W-phone">{{ 'forms.phone' | t }} <span class="muted">({{ 'general.optional' | t }})</span></label>
              <input class="input" id="W-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
            </div>
            <div class="field">
              <label class="field__label" for="W-order">{{ 'forms.order_number' | t }} <span class="required" aria-hidden="true">*</span></label>
              <input class="input" id="W-order" type="text" name="contact[Bestelnummer]" required placeholder="#1001">
            </div>
            <div class="field field--full">
              <label class="field__label" for="W-product">{{ 'warranty.product' | t }} <span class="required" aria-hidden="true">*</span></label>
              <input class="input" id="W-product" type="text" name="contact[Product]" required>
            </div>
            <div class="field">
              <label class="field__label" for="W-since">{{ 'warranty.since' | t }} <span class="muted">({{ 'general.optional' | t }})</span></label>
              <input class="input" id="W-since" type="date" name="contact[Sinds wanneer]">
            </div>
            <div class="field">
              <label class="field__label" for="W-wish">{{ 'warranty.wish' | t }}</label>
              <select class="select" id="W-wish" name="contact[Voorkeur]">
                <option value="{{ 'warranty.wish_repair' | t | escape }}">{{ 'warranty.wish_repair' | t }}</option>
                <option value="{{ 'warranty.wish_part' | t | escape }}">{{ 'warranty.wish_part' | t }}</option>
                <option value="{{ 'warranty.wish_replace' | t | escape }}">{{ 'warranty.wish_replace' | t }}</option>
                <option value="{{ 'warranty.wish_unsure' | t | escape }}" selected>{{ 'warranty.wish_unsure' | t }}</option>
              </select>
            </div>
            <div class="field field--full">
              <label class="field__label" for="W-body">{{ 'warranty.issue' | t }} <span class="required" aria-hidden="true">*</span></label>
              <textarea class="textarea" id="W-body" name="contact[body]" rows="5" required>{{ form.body }}</textarea>
            </div>
            <div class="field field--full">
              <label class="field__label" for="W-photos">{{ 'warranty.photos' | t }} <span class="muted">({{ 'general.optional' | t }})</span></label>
              <input class="input" id="W-photos" type="url" name="contact[Link naar foto's]" inputmode="url" placeholder="https://" aria-describedby="W-photos-help">
              <p class="field__help" id="W-photos-help">{{ 'warranty.photos_help' | t: email: email }}</p>
            </div>
          </div>
          <div class="form-actions"><button type="submit" class="btn btn--secondary">{{ 'warranty.submit' | t }}</button></div>
          {%- if shop.privacy_policy -%}<p class="form-note">{{ 'forms.privacy_note_html' | t: url: shop.privacy_policy.url }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Garantie en klachten",
  "class": "section-page-garantie",
  "settings": [
    { "type": "paragraph", "content": "Let op: een Shopify-contactformulier kan geen bestanden ontvangen. Klanten plakken daarom een link naar hun foto's (bv. WeTransfer of Google Foto's) of mailen ze naar het e-mailadres uit Thema-instellingen › Contact & bedrijf. Wil je echte foto-uploads in dit formulier, gebruik dan een formulier-app met uploadveld en zet die als app-blok in een Apps-sectie op deze pagina." },
    { "type": "text", "id": "heading", "label": "Kop (leeg = paginatitel)" },
    { "type": "text", "id": "steps_heading", "label": "Kop stappen", "default": "Zo handelen we je klacht af" }
  ],
  "blocks": [
    {
      "type": "warranty", "name": "Garantiekaart",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icoon", "options": [ { "value": "shield", "label": "Schild" }, { "value": "check", "label": "Vinkje" }, { "value": "info", "label": "Info" }, { "value": "return", "label": "Retour" } ], "default": "shield" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Wettelijke garantie" },
        { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Elk product moet doen wat je ervan mag verwachten. Is dat niet zo, dan lossen we het op: herstellen, een onderdeel of vervangen.</p>" },
        { "type": "select", "id": "style", "label": "Stijl", "options": [ { "value": "white", "label": "Wit" }, { "value": "steen", "label": "Steen" } ], "default": "white" }
      ]
    },
    {
      "type": "step", "name": "Stap",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Meld het" },
        { "type": "text", "id": "text", "label": "Tekst", "default": "Vul het formulier in met je bestelnummer." }
      ]
    }
  ],
  "presets": [{ "name": "Garantie en klachten" }]
}
{% endschema %}
