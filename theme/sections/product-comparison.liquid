{%- comment -%}
  Comparison table (features collection.quality-line-explainer / content.comparison-guide).
  - Product page: the products from the chosen collection that share custom.vergelijk_groep with the current
    product (e.g. Easy-up Premium vs Professional). No group, or not in the set: no table (no tent table under a
    statafelrok).
  - Collection page (use_current on): the current collection; the first vergelijk_groep that two or more of its
    products share. Statafels or rokken without a group get no table.
  - Page / home: the chosen collection, same group rule (or any products with specs when require_group is off).
  Rows come from custom.specificaties (groep + label), so nothing is typed twice. Optional link to the full
  comparison guide (a page with template page.vergelijking).
{%- endcomment -%}
{%- liquid
  # Source collection: the current collection on a collection page (when 'use_current' is on), else the chosen one.
  assign src = section.settings.collection
  if template.name == 'collection' and collection and section.settings.use_current
    assign src = collection
  endif
  assign grp = ''
  assign on_product = false
  if template.name == 'product' and product
    assign on_product = true
    if product.metafields.custom.vergelijk_groep != blank
      assign grp = product.metafields.custom.vergelijk_groep.value
    endif
  endif
  # Collection page / page: compare the first custom.vergelijk_groep that at least two products share. Products
  # without a group are left out, so a statafel or rokken collection shows nothing.
  if on_product == false and section.settings.require_group
    assign all_groups = ''
    for p in src.products limit: 50
      if p.metafields.custom.vergelijk_groep != blank and p.metafields.custom.specificaties != blank
        assign all_groups = all_groups | append: p.metafields.custom.vergelijk_groep.value | append: '§'
      endif
    endfor
    assign group_list = all_groups | split: '§'
    assign unique_groups = group_list | uniq
    assign grp = 'kk-none'
    for g in unique_groups
      assign g_count = 0
      for x in group_list
        if x == g
          assign g_count = g_count | plus: 1
        endif
      endfor
      if g_count > 1
        assign grp = g
        break
      endif
    endfor
  endif
  assign handles = ''
  assign count = 0
  assign keys = ''
  assign pk_all = ''
  for p in src.products limit: 50
    if p.metafields.custom.specificaties == blank
      continue
    endif
    if grp != '' and p.metafields.custom.vergelijk_groep.value != grp
      continue
    endif
    if count >= section.settings.max
      break
    endif
    assign count = count | plus: 1
    assign handles = handles | append: ',' | append: p.handle | append: ','
    assign pk = '§'
    for row in p.metafields.custom.specificaties.value
      assign rk = row.groep | append: '|' | append: row.label
      assign keys = keys | append: rk | append: '§'
      assign pk = pk | append: rk | append: '§'
    endfor
    assign pk_all = pk_all | append: pk | append: '¶'
  endfor
  assign keys = keys | split: '§' | uniq
  assign pk_list = pk_all | split: '¶'

  # rows line up across products whose spec labels differ (snippets/comparison-merge); a row that still holds one value
  # is no comparison and is left out (the full table is on each product page)
  assign pres_s = ''
  for k in keys
    assign kn = '§' | append: k | append: '§'
    assign pr = ','
    for pkx in pk_list
      if pkx contains kn
        assign pr = pr | append: forloop.index | append: ','
      endif
    endfor
    assign pres_s = pres_s | append: pr | append: '¶'
  endfor
  assign pres = pres_s | split: '¶'
  assign group_s = ''
  for k in keys
    assign kg = k | split: '|' | first
    assign group_s = group_s | append: kg | append: '§'
  endfor
  assign groups = group_s | split: '§' | uniq
  capture cmap
    render 'comparison-merge', keys: keys, pres: pres, groups: groups, count: count
  endcapture
  # rows shown: every target once, in the order of the first label that lands there; one with fewer than two values goes
  assign row_s = ''
  for k in keys
    assign kn = '§' | append: k | append: '¦'
    assign t = k
    if cmap contains kn
      assign t = cmap | split: kn | last | split: '¦' | first
    endif
    assign row_s = row_s | append: t | append: '§'
  endfor
  assign all_rows = row_s | split: '§' | uniq
  assign rows_s = ''
  assign blanks = 0
  for t in all_rows
    assign src_s = '§'
    for k in keys
      assign kn = '§' | append: k | append: '¦'
      assign kt = k
      if cmap contains kn
        assign kt = cmap | split: kn | last | split: '¦' | first
      endif
      if kt == t
        assign src_s = src_s | append: k | append: '§'
      endif
    endfor
    assign srcs = src_s | split: '§'
    assign row_n = 0
    for pkx in pk_list
      for sk in srcs
        if sk == ''
          continue
        endif
        assign skn = '§' | append: sk | append: '§'
        if pkx contains skn
          assign row_n = row_n | plus: 1
          break
        endif
      endfor
    endfor
    if row_n > 1
      assign rows_s = rows_s | append: t | append: '§'
      assign blanks = blanks | plus: count | minus: row_n
    endif
  endfor
  assign rows = rows_s | split: '§'
  assign show_table = true
  # Collection page: products whose specs mostly do not line up (more than a third of the cells empty, e.g. a stretch rok
  # next to a hoes met strik) are not a comparison; no table rather than a misleading one.
  if template.name == 'collection'
    assign blanks_x3 = blanks | times: 3
    assign cells = rows.size | times: count
    if blanks_x3 > cells or rows.size < 3
      assign show_table = false
    endif
  endif
  if on_product
    assign current_key = ',' | append: product.handle | append: ','
    if grp == ''
      assign show_table = false
    endif
    unless handles contains current_key
      assign show_table = false
    endunless
  endif
-%}
{%- if count > 1 and show_table -%}
  <section class="section comparison color-{{ section.settings.color_scheme }}" aria-labelledby="Title-{{ section.id }}">
    <div class="page-width">
      <div class="section-head">
        <div>
          <h2 class="section-head__title" id="Title-{{ section.id }}">{{ section.settings.heading }}</h2>
          {%- if section.settings.text != blank -%}<p class="section-head__text muted">{{ section.settings.text }}</p>{%- endif -%}
        </div>
        {%- if section.settings.guide_link != blank and section.settings.guide_label != blank -%}
          {%- assign guide_path = section.settings.guide_link | split: '?' | first -%}
          {%- capture guide_ok -%}{%- render 'link-exists', url: section.settings.guide_link -%}{%- endcapture -%}
          {%- unless request.path == guide_path or guide_ok == 'false' -%}
            <a class="link comparison__guide" href="{{ section.settings.guide_link }}">{{ section.settings.guide_label }}{%- render 'icon', icon: 'arrow-right', class: 'icon--xs' -%}</a>
          {%- endunless -%}
        {%- endif -%}
      </div>
      <div class="table-wrap comparison__wrap" role="region" aria-labelledby="Title-{{ section.id }}" tabindex="0">
        <table class="table comparison__table">
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">{{ 'product.specs' | t }}</span></th>
              {%- for p in src.products limit: 50 -%}
                {%- assign hk = ',' | append: p.handle | append: ',' -%}{%- unless handles contains hk -%}{%- continue -%}{%- endunless -%}
                <th scope="col" class="comparison__product{% if p.id == product.id %} is-current{% endif %}">
                  <a href="{{ p.url }}">
                    {%- if p.featured_media -%}{{ p.featured_media.preview_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', widths: '120, 240', sizes: '120px' }}{%- endif -%}
                    <span>{{ p.title | replace: ' x ', ' × ' }}</span>
                  </a>
                  {%- render 'price', product: p -%}
                </th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- assign group_s = '' -%}
            {%- for t in rows -%}{%- assign tg = t | split: '|' | first -%}{%- assign group_s = group_s | append: tg | append: '§' -%}{%- endfor -%}
            {%- assign row_groups = group_s | split: '§' | uniq -%}
            {%- for g in row_groups -%}
              <tr class="comparison__group"><th scope="rowgroup" colspan="{{ count | plus: 1 }}">{{ g }}</th></tr>
              {%- for t in rows -%}
                {%- assign tparts = t | split: '|' -%}
                {%- if tparts.first != g -%}{%- continue -%}{%- endif -%}
                <tr>
                  <th scope="row">{{ tparts.last }}</th>
                  {%- for p in src.products limit: 50 -%}
                    {%- assign hk = ',' | append: p.handle | append: ',' -%}{%- unless handles contains hk -%}{%- continue -%}{%- endunless -%}
                    {%- capture cell -%}
                      {%- for row in p.metafields.custom.specificaties.value -%}
                        {%- assign rk = row.groep | append: '|' | append: row.label -%}
                        {%- assign rkn = '§' | append: rk | append: '¦' -%}
                        {%- assign rt = rk -%}{%- assign rq = '' -%}
                        {%- if cmap contains rkn -%}
                          {%- assign rentry = cmap | split: rkn | last | split: '§' | first | split: '¦' -%}
                          {%- assign rt = rentry.first -%}{%- assign rq = rentry[1] -%}
                        {%- endif -%}
                        {%- if rt == t -%}
                          {%- if rq != blank -%}<span class="comparison__l"><span class="comparison__q">{{ rq }}</span>{{ row.waarde }}</span>{%- else -%}{{ row.waarde }}{%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endcapture -%}
                    <td>{%- if cell == blank -%}<span aria-hidden="true">–</span><span class="visually-hidden">{{ 'product.spec_none' | t }}</span>{%- else -%}{{ cell }}{%- endif -%}</td>
                  {%- endfor -%}
                </tr>
              {%- endfor -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <style>
    .comparison__wrap{background:var(--c-wit);border:1px solid var(--c-lijn)}
    .comparison__guide{display:inline-flex;align-items:center;gap:6px;font-weight:var(--font-body-weight-semibold)}
    .comparison__table{min-width:560px}
    .comparison__table thead th{background:var(--c-wit)}
    .comparison__table th[scope="row"]{color:var(--c-kiezel);font-weight:var(--font-body-weight);width:28%}
    .comparison__product{vertical-align:bottom;background:var(--c-wit)!important}
    .comparison__product a{display:flex;flex-direction:column;gap:8px;text-decoration:none;font-family:var(--font-heading);font-size:16px;margin-bottom:6px}
    .comparison__product img{width:96px;height:96px;object-fit:contain;background:var(--c-media);border-radius:10px}
    .comparison__product.is-current a span::after{content:" ✓";color:var(--c-inkt)}
    .comparison__l{display:block}
    .comparison__l+.comparison__l{margin-top:8px}
    .comparison__q{display:block;font-size:12.5px;font-weight:var(--font-body-weight-semibold);color:var(--c-kiezel)}
    .comparison__group th{background:var(--c-band);font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--c-inkt)}
    .comparison__wrap:focus-visible{outline:3px solid var(--c-inkt);outline-offset:2px}
    /* phones: the label column stays put while the products scroll sideways; the next product peeks in as the cue */
    @media (max-width:749px){
      .comparison__table{min-width:0;width:max-content}
      .comparison__table th[scope="row"],.comparison__table thead th:first-child{position:sticky;left:0;z-index:1;width:112px;min-width:112px;max-width:112px;padding-inline:10px;font-size:13.5px;background:var(--c-wit);box-shadow:inset -1px 0 0 var(--c-lijn),inset 0 -1px 0 var(--c-lijn)}
      .comparison__table td,.comparison__product{width:150px;min-width:150px;max-width:150px}
      .comparison__group th{position:sticky;left:0}
      .comparison__product img{width:72px;height:72px}
      .comparison__product a{font-size:15px}
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Vergelijkingstabel",
  "class": "section-comparison",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurschema", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Vergelijk de uitvoeringen" },
    { "type": "text", "id": "text", "label": "Tekst", "default": "Zelfde idee, ander gebruik. Kies op frame, dak en gewicht." },
    { "type": "collection", "id": "collection", "label": "Collectie", "info": "Op een productpagina: alleen producten met dezelfde custom.vergelijk_groep. Rijen komen uit custom.specificaties." },
    { "type": "checkbox", "id": "use_current", "label": "Op een collectiepagina: de huidige collectie vergelijken", "default": true },
    { "type": "checkbox", "id": "require_group", "label": "Alleen producten met dezelfde vergelijkingsgroep", "default": true, "info": "custom.vergelijk_groep, bv. 'easy-up'. Collecties zonder twee producten in één groep tonen geen tabel." },
    { "type": "url", "id": "guide_link", "label": "Link naar de vergelijkingsgids" },
    { "type": "text", "id": "guide_label", "label": "Linktekst", "default": "Lees het hele verschil" },
    { "type": "range", "id": "max", "min": 2, "max": 4, "step": 1, "label": "Maximaal aantal producten", "default": 3 }
  ],
  "presets": [{ "name": "Vergelijkingstabel" }]
}
{% endschema %}
