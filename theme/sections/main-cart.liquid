{{ 'component-cart.css' | asset_url | stylesheet_tag }}
<div class="section page-width cart-page" id="CartPage-{{ section.id }}">
  {%- if cart.item_count > 0 -%}
    <div class="cart-page__head">
      <h1 class="cart-page__title">{{ 'cart.title_count' | t: count: cart.item_count }}</h1>
      <a class="link" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
    </div>
    <div class="cart-page__grid">
      <div class="cart-page__lines">
        <form action="{{ routes.cart_url }}" method="post" id="CartPageForm" novalidate>
          <cart-items data-section-id="{{ section.id }}">
            <ul class="cart-lines" role="list">
              {%- for item in cart.items -%}
                {%- render 'cart-line', item: item, index: forloop.index -%}
              {%- endfor -%}
            </ul>
          </cart-items>
          <noscript><button type="submit" class="btn btn--outline" name="update">{{ 'cart.updating' | t }}</button></noscript>
        </form>
      </div>
      <aside class="cart-page__summary" aria-label="{{ 'cart.subtotal' | t }}">
        {%- render 'cart-free-shipping' -%}
        {%- render 'cart-summary', form_id: 'CartPageForm', context: 'page' -%}
        {%- if section.settings.show_usps -%}
          <ul class="checklist cart-page__usps text-sm">
            {%- for i in (1..3) -%}
              {%- assign usp_key = 'usp_' | append: i -%}
              {%- if section.settings[usp_key] != blank -%}<li>{%- render 'icon', icon: 'check' -%}<span>{{ section.settings[usp_key] }}</span></li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if shop.enabled_payment_types.size > 0 -%}
          <ul class="payment-icons" role="list" aria-label="{{ 'footer.payment' | t }}">
            {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
      </aside>
    </div>
  {%- else -%}
    <div class="empty-state cart-empty">
      {%- render 'icon', icon: 'tent', class: 'icon--lg' -%}
      <h1>{{ 'cart.empty_title' | t }}</h1>
      <p class="muted text-lg">{{ 'cart.empty_text' | t }}</p>
      <div class="btn-row">
        <a class="btn" href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}">{{ 'cart.empty_cta' | t }}</a>
        <a class="btn btn--outline" href="{{ routes.root_url }}">{{ 'not_found.home' | t }}</a>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Winkelwagen",
  "settings": [
    { "type": "url", "id": "empty_link", "label": "Link bij lege winkelwagen" },
    { "type": "checkbox", "id": "show_usps", "label": "Zekerheden onder de totalen", "default": true },
    { "type": "text", "id": "usp_1", "label": "Zekerheid 1", "default": "Veilig betalen met iDEAL of Bancontact" },
    { "type": "text", "id": "usp_2", "label": "Zekerheid 2", "default": "Zakelijk bestellen op factuur" },
    { "type": "text", "id": "usp_3", "label": "Zekerheid 3", "default": "Vragen? Bel of app ons" }
  ]
}
{% endschema %}
