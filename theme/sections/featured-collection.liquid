<script src="{{ 'slider.js' | asset_url }}" defer></script>
{%- if section.settings.mobile_grid -%}{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}{%- endif -%}
{%- liquid
  assign c = section.settings.collection
  assign limit = section.settings.limit
  # mobile grid: 'Alle … (n)' as a full-width button under the grid instead of the link in the head
  assign show_more = false
  if section.settings.mobile_grid and c != blank and c.products_count > limit
    assign show_more = true
  endif
-%}
{%- liquid
  # 'Vergeet niet' on the cart page: items that fit the cart; the section disappears when nothing fits
  assign cart_dependent = false
  if section.settings.exclude_in_cart or section.settings.cart_related
    assign cart_dependent = true
  endif
  if section.settings.cart_related
    capture related_probe
      render 'cart-related', collection: c, limit: 1, style: 'row', fallback: section.settings.cart_fallback
    endcapture
  endif
-%}
{%- if section.settings.cart_related and related_probe == blank -%}
<div hidden data-cart-dependent data-section-id="{{ section.id }}"></div>
{%- else -%}
<section class="section featured-collection color-{{ section.settings.color_scheme }}" aria-labelledby="Title-{{ section.id }}"{% if cart_dependent %} data-cart-dependent data-section-id="{{ section.id }}"{% endif %}>
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-head__title" id="Title-{{ section.id }}">{{ section.settings.heading | default: c.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="section-head__text muted">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      <div class="btn-row">
        {%- if c != blank -%}<a class="link{% if show_more %} featured-collection__head-link{% endif %}" href="{{ c.url }}">{% if section.settings.link_label != blank %}{{ section.settings.link_label }}{% else %}{{ 'general.view_all' | t }}{% endif %}</a>{%- endif -%}
        {%- unless section.settings.desktop_grid -%}
        <div class="slider-nav">
          <button type="button" class="icon-btn" data-slider-btn="prev" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.scroll_left' | t }}">{%- render 'icon', icon: 'chevron-left', class: 'icon--sm' -%}</button>
          <button type="button" class="icon-btn" data-slider-btn="next" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.scroll_right' | t }}">{%- render 'icon', icon: 'chevron-right', class: 'icon--sm' -%}</button>
        </div>
        {%- endunless -%}
      </div>
    </div>
    <ul class="slider{% if section.settings.desktop_grid %} slider--desktop-grid{% endif %}{% if section.settings.mobile_grid %} product-row--mobile-grid{% endif %} product-row" id="Slider-{{ section.id }}" role="list" style="--cols: {{ section.settings.columns }}; --slide-w: 68%">
      {%- if section.settings.cart_related -%}
        {%- capture related_items -%}{%- render 'cart-related', collection: c, limit: limit, style: 'card', sizes: '(min-width: 990px) 320px, 68vw', fallback: section.settings.cart_fallback -%}{%- endcapture -%}
        {{ related_items }}
      {%- elsif c != blank and c.products_count > 0 -%}
        {%- liquid
          assign in_cart = ''
          if section.settings.exclude_in_cart
            assign in_cart = cart.items | map: 'product_id'
          endif
          assign shown = 0
          assign card_sizes = '(min-width: 990px) 320px, 68vw'
          if section.settings.mobile_grid
            assign card_sizes = '(min-width: 990px) 320px, 50vw'
          endif
        -%}
        {%- for product in c.products limit: 50 -%}
          {%- if section.settings.hide_sold_out and product.available == false -%}{%- continue -%}{%- endif -%}
          {%- if section.settings.exclude_in_cart and in_cart contains product.id -%}{%- continue -%}{%- endif -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <li>{%- render 'product-card', product: product, sizes: card_sizes -%}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li><div class="card"><div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div><div class="card__body"><p class="card__title">{{ 'general.placeholder_product' | t }}</p></div></div></li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
    {%- if show_more -%}
      <a class="btn btn--outline featured-collection__more" href="{{ c.url }}">{% if section.settings.link_label != blank %}{{ section.settings.link_label }}{% else %}{{ 'general.view_all' | t }}{% endif %} ({{ c.products_count }})</a>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Uitgelichte collectie",
  "class": "section-featured-collection",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurschema", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Bovenregel" },
    { "type": "text", "id": "heading", "label": "Kop" },
    { "type": "text", "id": "text", "label": "Tekst" },
    { "type": "collection", "id": "collection", "label": "Collectie" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Aantal producten", "default": 8 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Kolommen desktop", "default": 4 },
    { "type": "checkbox", "id": "desktop_grid", "label": "Raster op desktop (anders schuiven)", "default": true },
    { "type": "checkbox", "id": "mobile_grid", "label": "Raster op mobiel (2 kolommen, anders schuiven)", "default": false },
    { "type": "text", "id": "link_label", "label": "Linktekst", "default": "Bekijk alles" },
    { "type": "checkbox", "id": "hide_sold_out", "label": "Uitverkochte producten overslaan", "default": false },
    { "type": "checkbox", "id": "exclude_in_cart", "label": "Producten uit de winkelwagen overslaan", "default": false, "info": "Handig op de winkelwagenpagina." },
    { "type": "header", "content": "Winkelwagenpagina" },
    { "type": "checkbox", "id": "cart_related", "label": "Afstemmen op de winkelwagen", "default": false, "info": "Toont de add-ons (custom.addons) van wat in de winkelwagen ligt en producten uit de collectie die erop passen (custom.past_op). Past niets, dan verdwijnt de sectie." },
    { "type": "checkbox", "id": "cart_fallback", "label": "Aanvullen met de collectie als niets past", "default": false }
  ],
  "presets": [{ "name": "Uitgelichte collectie" }]
}
{% endschema %}
