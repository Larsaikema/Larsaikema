<section class="section newsletter color-{{ section.settings.color_scheme }}" aria-labelledby="Title-{{ section.id }}">
  {%- if section.settings.show_flags -%}<div class="divider-flags newsletter__flags" aria-hidden="true"></div>{%- endif -%}
  <div class="page-width page-width--narrow newsletter__inner">
    <h2 id="Title-{{ section.id }}" class="newsletter__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="newsletter__text text-lg">{{ section.settings.text }}</div>{%- endif -%}
    {%- assign nl_form_id = 'NewsletterForm-' | append: section.id -%}
    {%- form 'customer', id: nl_form_id, class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="notice notice--success" role="status">{%- render 'icon', icon: 'check' -%}<span>{{ 'newsletter.success' | t }}</span></p>
      {%- else -%}
        <div class="newsletter-form__row">
          <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
          <input class="input" type="email" id="NewsletterEmail-{{ section.id }}" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.label' | t }}"{% if form.errors %} aria-invalid="true" aria-describedby="NewsletterError-{{ section.id }}"{% endif %}>
          <button type="submit" class="btn">{{ 'newsletter.button' | t }}</button>
        </div>
        {%- if form.errors -%}<p class="field__error" id="NewsletterError-{{ section.id }}">{{ 'forms.error_email' | t }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
    {%- if section.settings.note != blank -%}<p class="newsletter__note text-sm muted">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>
{{ 'section-newsletter.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Nieuwsbrief",
  "class": "section-newsletter",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurschema", "default": "scheme-3" },
    { "type": "checkbox", "id": "show_flags", "label": "Vlaggenlijn bovenaan", "default": true, "info": "Alleen op feestelijke plekken (home, actie), niet op zakelijke pagina's." },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Eerst weten wanneer er actie is?" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Eén mail als er iets te vieren valt. Geen spam, afmelden kan altijd.</p>" },
    { "type": "text", "id": "note", "label": "Kleine tekst onder het formulier" }
  ],
  "presets": [{ "name": "Nieuwsbrief" }]
}
{% endschema %}
