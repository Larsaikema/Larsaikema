{%- liquid
  assign menu = section.settings.menu
  assign phone = settings.phone | default: shop.phone
  # tel:/wa.me links in international form (+31 for a national number), so they also work for a visitor in Belgium
  capture phone_href
    render 'header-contact-href', number: phone, type: 'tel'
  endcapture
  capture wa_href
    render 'header-contact-href', number: settings.whatsapp, type: 'wa'
  endcapture
  assign quote_url = settings.quote_page | default: '/pages/offerte'
  assign show_toggle = false
  if settings.price_display == 'toggle'
    assign show_toggle = true
  endif
  # the toggle labels are theme settings in the shop's own language; another language (/en) gets its locale strings
  assign vat_p = settings.b2b_toggle_particulier | default: 'Particulier'
  assign vat_z = settings.b2b_toggle_zakelijk | default: 'Zakelijk'
  if request.locale.primary == false
    assign vat_p = 'header.vat_particulier' | t
    assign vat_z = 'header.vat_zakelijk' | t
  endif
  # promotion blocks shown in a mega menu panel ('|id|id|'), see snippets/header-promo-ids
  capture promo_ids
    render 'header-promo-ids', menu: menu, blocks: section.blocks
  endcapture
  # One top item is marked active: the item that is the current page, else (product page) the item whose own
  # collection holds the product (URL context first, then product.collections), else the item with the current
  # page in its menu (not for pages: a page linked from a mega menu is not 'in' that category), else (product
  # page) the first item with an active child.
  assign deal_titles = section.settings.deal_items | downcase | replace: ', ', ',' | replace: ' ,', ',' | strip | split: ','
  assign nav_active = 0
  for link in menu.links
    if link.current
      assign nav_active = forloop.index
      break
    endif
  endfor
  if nav_active == 0 and template.name == 'product'
    for link in menu.links
      if collection and link.url == collection.url
        assign nav_active = forloop.index
        break
      endif
    endfor
    if nav_active == 0
      assign product_collections = product.collections | map: 'handle'
      for link in menu.links
        if link.active or link.type == 'collection_link' and product_collections contains link.object.handle
          assign nav_active = forloop.index
          break
        endif
      endfor
    endif
  endif
  if nav_active == 0 and template.name != 'page'
    for link in menu.links
      if link.child_current
        assign nav_active = forloop.index
        break
      endif
    endfor
  endif
  if nav_active == 0 and template.name == 'product'
    for link in menu.links
      if link.child_active
        assign nav_active = forloop.index
        break
      endif
    endfor
  endif

  # Key of the shown page for snippets/header-current (aria-current and the selected size chip): path + the active
  # storefront filters. link.current ignores the query string, so on a collection every filter link would be 'current'.
  assign here = request.path
  # a product reached through a collection (/collections/x/products/y) is the same page as /products/y for the menu
  if template.name == 'product' and here contains '/collections/' and here contains '/products/'
    assign here_tail = here | split: '/products/' | last
    assign here = here | split: '/collections/' | first | append: '/products/' | append: here_tail
  endif
  if here.size > 1
    assign here_end = here | slice: -1
    if here_end == '/'
      assign here = here | remove_last: '/'
    endif
  endif
  assign here_list = ''
  if template.name == 'collection' and collection
    for f in collection.filters
      if f.type == 'price_range'
        if f.min_value.value != nil or f.max_value.value != nil
          assign here_list = here_list | append: 'filter.v.price|'
        endif
      else
        for v in f.active_values
          assign here_list = here_list | append: v.param_name | append: '=' | append: v.value | append: '|'
        endfor
      endif
    endfor
  endif
  assign here_key = here_list | split: '|' | sort | join: '|'
  assign here = here | append: '?' | append: here_key
-%}
{%- comment -%} the one menu entry with aria-current ('3', '3-2' or '3-2-4'), see snippets/header-current-key {%- endcomment -%}
{%- capture cur_key -%}{%- render 'header-current-key', menu: menu, here: here -%}{%- endcapture -%}
{%- assign cur_key = cur_key | strip -%}

{%- comment -%}
  Without JavaScript the desktop mega menu opens on hover/focus (CSS) and the Menu button opens the drawer natively
  (invoker command); the drawer's top items are then plain links to their category. With JavaScript, section-header.js
  loads the menu files (-mega.css/.js on desktop, -drawer.css/.js on mobile) while the page is idle or on first reach,
  and shows a busy state if a menu is opened before they have arrived.
{%- endcomment -%}
<noscript>{{ 'section-header-mega.css' | asset_url | stylesheet_tag }}{{ 'section-header-drawer.css' | asset_url | stylesheet_tag }}</noscript>
<sticky-header class="header-wrap color-{{ section.settings.color_scheme }}" data-sticky="{{ section.settings.sticky }}" data-mega-css="{{ 'section-header-mega.css' | asset_url }}" data-mega-js="{{ 'section-header-mega.js' | asset_url }}" data-drawer-css="{{ 'section-header-drawer.css' | asset_url }}" data-drawer-js="{{ 'section-header-drawer.js' | asset_url }}">
  <header class="header">
    <div class="page-width header__main">
      <button type="button" class="header__action header__menu-btn" data-menu-open commandfor="MenuDrawer" command="show-modal" aria-controls="MenuDrawer" aria-expanded="false" aria-label="{{ 'header.menu_open' | t }}">
        {%- render 'icon', icon: 'menu' -%}<span class="header__action-label" aria-hidden="true">{{ 'general.menu' | t }}</span>
      </button>

      <div class="header__logo-wrap">
        <a href="{{ routes.root_url }}" class="header__logo" style="--logo-w: {{ settings.logo_width }}px; --logo-w-mobile: {{ settings.logo_width_mobile }}px;">
          {%- render 'logo', image: true, variant: 'auto' -%}
        </a>
      </div>

      <predictive-search class="header__search search" data-enabled="{{ settings.predictive_search_enabled }}" data-params="resources[type]=product,collection,page,article,query&amp;resources[limit_scope]=each&amp;resources[options][unavailable_products]=last&amp;resources[options][fields]=title,product_type,variants.title,vendor,variants.sku,tag&amp;resources[limit]={{ settings.predictive_search_limit | default: 6 }}"{% if settings.predictive_search_enabled %} data-src="{{ 'predictive-search.js' | asset_url }}" data-css="{{ 'section-header-search.css' | asset_url }}"{% endif %}>
        <form action="{{ routes.search_url }}" method="get" role="search" class="search__form">
          <label class="visually-hidden" for="HeaderSearch-{{ section.id }}">{{ 'header.search_label' | t }}</label>
          {%- render 'icon', icon: 'search', class: 'search__icon' -%}
          <input class="search__input" type="search" id="HeaderSearch-{{ section.id }}" name="q" value="{{ search.terms | escape }}"
            placeholder="{{ 'header.search_placeholder' | t }}" autocomplete="off" spellcheck="false" enterkeyhint="search"
            {% if settings.predictive_search_enabled %}role="combobox" aria-expanded="false" aria-haspopup="listbox" aria-autocomplete="list"{% endif %}>
          {%- comment -%} the visible placeholder: the long wording when it fits the field (CSS container query), else the short one; the input keeps the full text for assistive tech {%- endcomment -%}
          <span class="search__ph" aria-hidden="true"><span>{{ 'header.search_placeholder' | t }}</span><span>{{ 'header.search_placeholder_short' | t }}</span></span>
          <input type="hidden" name="options[prefix]" value="last">
          <button type="button" class="search__clear" data-search-clear{% if search.terms == blank %} hidden{% endif %} aria-label="{{ 'header.search_clear' | t }}">{%- render 'icon', icon: 'close', class: 'icon--sm' -%}</button>
          <button type="submit" class="search__submit" aria-label="{{ 'header.search_submit' | t }}">{%- render 'icon', icon: 'search' -%}<span class="search__submit-label">{{ 'header.search_submit' | t }}</span></button>
          {%- if settings.predictive_search_enabled -%}
            <div class="predictive" id="PredictiveResults-{{ section.id }}" data-predictive-results hidden></div>
            {%- render 'header-search-empty', terms: section.settings.search_popular, menu: section.settings.search_menu, fallback: menu, uid: section.id -%}
            <span class="visually-hidden" role="status" aria-live="polite" data-predictive-status></span>
          {%- endif -%}
        </form>
      </predictive-search>

      <div class="header__actions">
        {%- if show_toggle -%}
          {%- comment -%}
            each segment carries its own context ('Particulier' over 'incl. btw'), at every width: it never reads as a
            second 'Zakelijk' menu item, and its name ('Zakelijk excl. btw') differs from the menu item for voice control
          {%- endcomment -%}
          <div class="header__vat">
            <vat-toggle class="vat-toggle vat-toggle--stack" role="group" aria-label="{{ 'header.vat_toggle' | t }}">
              <button type="button" data-vat-set="incl" aria-pressed="true">{{ vat_p }} <small>{{ 'price.incl' | t }}</small></button>
              <button type="button" data-vat-set="excl" aria-pressed="false">{{ vat_z }} <small>{{ 'price.excl' | t }}</small></button>
            </vat-toggle>
          </div>
        {%- endif -%}
        {%- if section.settings.show_quote -%}
          <a href="{{ quote_url }}" class="header__action header__action--quote">{%- render 'icon', icon: 'invoice' -%}<span class="header__action-label">{{ 'header.quote' | t }}</span></a>
        {%- endif -%}
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" class="header__action header__action--account">{%- render 'icon', icon: 'user' -%}<span class="header__action-label">{% if customer %}{{ 'header.account' | t }}{% else %}{{ 'header.login' | t }}{% endif %}</span></a>
        {%- endif -%}
        {%- capture kk_count -%}{% render 'cart-count' %}{%- endcapture -%}{%- assign kk_count = kk_count | plus: 0 -%}
        <a href="{{ routes.cart_url }}" class="header__action header__cart" id="cart-icon-bubble" data-cart-toggle aria-label="{{ 'header.cart' | t }}, {{ 'header.cart_count' | t: count: kk_count }}">
          <span class="header__cart-icon">{%- render 'icon', icon: 'cart' -%}<span class="cart-count" data-cart-count{% if kk_count == 0 %} hidden{% endif %}>{{ kk_count }}</span></span>
          <span class="header__action-label">{{ 'header.cart' | t }}</span>
        </a>
      </div>
    </div>

    <nav class="header__nav" aria-label="{{ 'header.main_nav' | t }}">
      <div class="page-width header__nav-inner">
        <ul class="nav" role="list">
          {%- for link in menu.links -%}
            {%- liquid
              assign ti = forloop.index | append: ''
              assign mega_id = 'Mega-' | append: section.id | append: '-' | append: forloop.index
              assign link_lc = link.title | downcase | strip
              assign is_deal = false
              if deal_titles contains link_lc
                assign is_deal = true
              endif
              # a menu item with one column opens a compact dropdown under the item instead of a full-width panel
              assign compact = false
              if link.links.size == 1
                assign compact = true
              endif
            -%}
            {%- capture promo_url -%}{%- render 'header-promo', link: link, blocks: section.blocks, context: 'url' -%}{%- endcapture -%}
            <li class="nav__item{% if link.links != blank %} nav__item--has-mega{% endif %}{% if compact %} nav__item--compact{% endif %}">
              {%- if link.links != blank -%}
                {%- comment -%}
                  Disclosure navigation with top-level links (WAI-APG): the item itself is a link to its category (a click
                  goes there, as on any shop); fine-pointer hover opens the panel after 120 ms; the chevron beside it is
                  the disclosure button for keyboard and touch (Enter/Space, aria-expanded). Focus never opens a panel;
                  Esc closes it and returns focus to the chevron. Every panel starts with 'Alles in …' (first tab stop).
                {%- endcomment -%}
                <mega-menu class="mega-trigger">
                  <a href="{{ link.url }}" class="nav__link{% if forloop.index == nav_active %} is-active{% endif %}"{% if cur_key == ti %} aria-current="page"{% endif %}>
                    {%- if is_deal -%}<span class="nav__deal">{{ link.title }}</span>{%- else -%}<span class="nav__label">{{ link.title }}</span>{%- endif -%}
                  </a>
                  <button type="button" class="nav__toggle" data-mega-trigger data-url="{{ link.url }}" aria-expanded="false" aria-controls="{{ mega_id }}" aria-label="{{ 'header.submenu' | t: title: link.title }}">{%- render 'icon', icon: 'chevron-down', class: 'icon--xs' -%}</button>
                  <div class="mega{% if compact %} mega--compact{% endif %}" id="{{ mega_id }}" data-mega-panel>
                    {%- capture mega_promo -%}{%- render 'header-promo', link: link, blocks: section.blocks, context: 'mega' -%}{%- endcapture -%}
                    <div class="{% unless compact %}page-width {% endunless %}mega__inner">
                      <div class="mega__main">
                        {%- liquid
                          assign all_n = 0
                          if link.type == 'collection_link'
                            assign all_n = link.object.all_products_count
                          endif
                        -%}
                        {%- capture all_label -%}{%- render 'header-all-label', link: link -%}{%- endcapture -%}
                        <a class="mega__all" href="{{ link.url }}"{% if all_n > 0 %} aria-label="{{ all_label | strip }}, {{ 'header.products_count' | t: count: all_n }}"{% endif %}>
                          <span>{{ all_label }}</span>
                          {%- if all_n > 0 -%}<span class="mega__count" aria-hidden="true">{{ all_n }}</span>{%- endif -%}
                          {%- render 'icon', icon: 'arrow-right', class: 'icon--sm' -%}
                        </a>
                        {%- capture thumbs_ok -%}{%- render 'header-thumbs-ok', link: link -%}{%- endcapture -%}
                        {%- comment -%}
                          a link already listed in an earlier column of this panel (panel_seen) or pointing at a page that a column
                          heading of this panel links to (panel_heads, see snippets/header-panel-heads) is not repeated
                        {%- endcomment -%}
                        {%- assign panel_seen = '' -%}
                        {%- capture panel_heads -%}{%- render 'header-panel-heads', link: link, menu: menu -%}{%- endcapture -%}
                        <div class="mega__cols mega__cols--{{ link.links.size | at_most: 6 }}">
                          {%- for child in link.links -%}
                            {%- liquid
                              assign tj = ti | append: '-' | append: forloop.index
                              assign skip_urls = child.url | append: '|' | append: promo_url | append: panel_seen | append: panel_heads
                              # a column whose heading points at the item's own page (or names a part of another top item but opens
                              # all of it) has a plain heading; the only column of a panel then has none ('Alles in …' is above)
                              assign head_key = '|' | append: child.url | append: '|'
                              assign head_link = false
                              if panel_heads contains head_key
                                assign head_link = true
                              endif
                            -%}
                            <div class="mega__col">
                              {%- if head_link and thumbs_ok == 'yes' -%}
                                <a class="mega__heading mega__heading--thumb" href="{{ child.url }}"{% if cur_key == tj %} aria-current="page"{% endif %}>
                                  <span class="mega__thumb">{{ child.object.image | image_url: width: 168 | image_tag: widths: '56, 112, 168', sizes: '56px', loading: 'lazy', alt: '' }}</span>
                                  <span>{{ child.title }}</span>
                                </a>
                              {%- elsif head_link -%}
                                <a class="mega__heading" href="{{ child.url }}"{% if cur_key == tj %} aria-current="page"{% endif %}>{{ child.title }}</a>
                              {%- elsif link.links.size > 1 and thumbs_ok == 'yes' -%}
                                <p class="mega__heading mega__heading--thumb">
                                  <span class="mega__thumb">{{ child.object.image | image_url: width: 168 | image_tag: widths: '56, 112, 168', sizes: '56px', loading: 'lazy', alt: '' }}</span>
                                  <span>{{ child.title }}</span>
                                </p>
                              {%- elsif link.links.size > 1 -%}
                                <p class="mega__heading">{{ child.title }}</p>
                              {%- endif -%}
                              {%- if child.links != blank -%}
                                {%- render 'header-sublinks', links: child.links, label: child.title, key: tj, current: cur_key, skip: skip_urls -%}
                                {%- for g in child.links -%}{%- assign panel_seen = panel_seen | append: '|' | append: g.url -%}{%- endfor -%}
                              {%- endif -%}
                            </div>
                          {%- endfor -%}
                        </div>
                      </div>
                      {%- if mega_promo != blank -%}<div class="mega__aside">{{ mega_promo }}</div>{%- endif -%}
                    </div>
                  </div>
                </mega-menu>
              {%- else -%}
                <a href="{{ link.url }}" class="nav__link{% if forloop.index == nav_active %} is-active{% endif %}"{% if cur_key == ti %} aria-current="page"{% endif %}>{%- if is_deal -%}<span class="nav__deal">{{ link.title }}</span>{%- else -%}<span class="nav__label">{{ link.title }}</span>{%- endif -%}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- if section.settings.show_contact -%}{%- render 'header-contact', phone: phone, phone_href: phone_href, wa_href: wa_href -%}{%- endif -%}
      </div>
    </nav>
    {%- comment -%} theme editor only: a notice for a promotion block that no menu item shows {%- endcomment -%}
    {%- if request.design_mode -%}{%- render 'header-promo-ids', menu: menu, blocks: section.blocks, warn: true -%}{%- endif -%}
  </header>
  <div class="header__scrim" aria-hidden="true"></div>
</sticky-header>

{%- comment -%}
  Mobile menu: a modal <dialog> (focus trap, Esc, backdrop click from global.js). The root view lists the top items;
  an item with children opens its own panel that slides over the root (in the HTML a link to its category, made a
  button with aria-expanded/aria-controls by section-header-drawer.js; the root is inert meanwhile, Esc or 'Terug' goes
  back one level first). Inside a panel the subcategories are accordions with their links, size chips and advice, and
  the panel ends with the item's picture card. Without JavaScript the Menu button opens the dialog natively (command).
{%- endcomment -%}
<menu-drawer>
  <dialog class="drawer drawer--left menu-drawer" id="MenuDrawer" aria-label="{{ 'general.menu' | t }}">
    <div class="mdrawer__view mdrawer__view--root" data-mdrawer-root>
      <div class="drawer__head mdrawer__head">
        <a href="{{ routes.root_url }}" class="mdrawer__logo">{%- render 'logo', variant: 'klein' -%}</a>
        <button type="button" class="mdrawer__close" data-drawer-close commandfor="MenuDrawer" command="close" aria-label="{{ 'header.menu_close' | t }}">{%- render 'icon', icon: 'close' -%}<span aria-hidden="true">{{ 'general.close' | t }}</span></button>
      </div>
      <div class="drawer__body mdrawer__body">
        <nav aria-label="{{ 'header.main_nav' | t }}">
          <ul class="mdrawer__list" role="list">
            {%- for link in menu.links -%}
              {%- assign link_lc = link.title | downcase | strip -%}
              {%- assign is_deal = false -%}
              {%- if deal_titles contains link_lc -%}{%- assign is_deal = true -%}{%- endif -%}
              <li>
                {%- if link.links != blank -%}
                  {%- comment -%} a link to the category until section-header.js makes it the button of its panel {%- endcomment -%}
                  <a href="{{ link.url }}" class="mdrawer__link{% if forloop.index == nav_active %} is-active{% endif %}" data-mdrawer-open data-controls="MenuPanel-{{ section.id }}-{{ forloop.index }}">
                    {%- if is_deal -%}<span class="nav__deal">{{ link.title }}</span>{%- else -%}<span>{{ link.title }}</span>{%- endif -%}
                    {%- render 'icon', icon: 'chevron-right', class: 'icon--sm' -%}
                  </a>
                {%- else -%}
                  {%- assign ti = forloop.index | append: '' -%}
                  <a class="mdrawer__link{% if forloop.index == nav_active %} is-active{% endif %}" href="{{ link.url }}"{% if cur_key == ti %} aria-current="page"{% endif %}>{%- if is_deal -%}<span class="nav__deal">{{ link.title }}</span>{%- else -%}<span>{{ link.title }}</span>{%- endif -%}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>

        {%- comment -%} the Offerte action of the header, once more as a button under the menu {%- endcomment -%}
        {%- if section.settings.show_quote -%}
          <a class="btn btn--outline btn--block mdrawer__quote" href="{{ quote_url }}">{%- render 'icon', icon: 'invoice' -%}<span>{{ 'product.quote_cta' | t }}</span></a>
        {%- endif -%}

        {%- comment -%} the header's promotion blocks as a row of picture cards under the menu {%- endcomment -%}
        {%- assign promo_blocks = section.blocks | where: 'type', 'promo' -%}
        {%- if promo_blocks.size > 0 -%}
          <div class="mdrawer__featured">
            <p class="eyebrow mdrawer__label" id="MenuFeatured-{{ section.id }}">{{ 'header.featured' | t }}</p>
            <ul class="mdrawer__cards" role="list" aria-labelledby="MenuFeatured-{{ section.id }}">
              {%- for b in promo_blocks -%}
                {%- if b.settings.link != blank -%}
                  {%- comment -%} editor attributes live on the block's mega menu card; here only when no menu item shows that card {%- endcomment -%}
                  {%- liquid
                    assign b_key = '|' | append: b.id | append: '|'
                    assign b_in_mega = false
                    if promo_ids contains b_key
                      assign b_in_mega = true
                    endif
                  -%}
                  <li>
                    <a class="hpromo" href="{{ b.settings.link }}"{% unless b_in_mega %} {{ b.shopify_attributes }}{% endunless %}>
                      <span class="hpromo__media">
                        {%- if b.settings.image != blank -%}
                          {{- b.settings.image | image_url: width: 600 | image_tag: widths: '280, 420, 600', sizes: '260px', loading: 'lazy', alt: '' -}}
                        {%- else -%}
                          {%- render 'fallback-image', key: b.settings.fallback_image, alt: '', placeholder: 'collection-1', class: 'is-contain' -%}
                        {%- endif -%}
                      </span>
                      <span class="hpromo__body">
                        {%- if b.settings.eyebrow != blank -%}<span class="eyebrow hpromo__eyebrow">{{ b.settings.eyebrow }}</span>{%- endif -%}
                        <span class="hpromo__title">{{ b.settings.heading }}</span>
                      </span>
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <ul class="mdrawer__secondary" role="list" data-service-links>
          {%- if shop.customer_accounts_enabled -%}<li><a href="{{ routes.account_url }}">{%- render 'icon', icon: 'user' -%}<span>{% if customer %}{{ 'header.account' | t }}{% else %}{{ 'header.login' | t }}{% endif %}</span></a></li>{%- endif -%}
          {%- if phone_href != blank -%}<li><a href="{{ phone_href }}">{%- render 'icon', icon: 'phone' -%}<span>{{ phone }}</span></a></li>{%- endif -%}
          {%- if wa_href != blank -%}<li><a href="{{ wa_href }}" target="_blank" rel="noopener">{%- render 'icon', icon: 'whatsapp' -%}<span>{{ 'contact.whatsapp_cta' | t }}<span class="visually-hidden"> ({{ 'general.new_window' | t | downcase }})</span></span></a></li>{%- endif -%}
          {%- comment -%} only an address the owner entered in Thema-instellingen › Contact (claims-to-confirm) {%- endcomment -%}
          {%- if settings.email != blank -%}<li><a href="mailto:{{ settings.email }}">{%- render 'icon', icon: 'mail' -%}<span>{{ settings.email }}</span></a></li>{%- endif -%}
        </ul>

        {%- if show_toggle -%}
          <div class="mdrawer__vat">
            <p class="eyebrow mdrawer__label" id="MenuVatLabel-{{ section.id }}">{{ 'header.vat_toggle' | t }}</p>
            <vat-toggle class="vat-toggle vat-toggle--block" role="group" aria-labelledby="MenuVatLabel-{{ section.id }}">
              <button type="button" data-vat-set="incl" aria-pressed="true">{{ vat_p }} <small>{{ 'price.incl' | t }}</small></button>
              <button type="button" data-vat-set="excl" aria-pressed="false">{{ vat_z }} <small>{{ 'price.excl' | t }}</small></button>
            </vat-toggle>
          </div>
        {%- endif -%}

        {%- capture drawer_loc -%}{%- render 'header-localization', context: 'drawer' -%}{%- endcapture -%}
        {%- if drawer_loc != blank -%}<div class="mdrawer__loc">{{ drawer_loc }}</div>{%- endif -%}

        {%- if settings.openingstijden != blank -%}
          <div class="mdrawer__hours" style="margin-top:20px;font-size:14.5px;line-height:1.5;color:var(--c-kiezel)">
            <p class="eyebrow mdrawer__label">{{ 'general.opening_hours' | t }}</p>
            <p style="margin:0">{{ settings.openingstijden | newline_to_br }}</p>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- for link in menu.links -%}
      {%- if link.links != blank -%}
        {%- assign ti = forloop.index | append: '' -%}
        {%- capture promo_url -%}{%- render 'header-promo', link: link, blocks: section.blocks, context: 'url' -%}{%- endcapture -%}
        <div class="mdrawer__view mdrawer__view--panel" id="MenuPanel-{{ section.id }}-{{ forloop.index }}" data-mdrawer-panel role="group" aria-labelledby="MenuPanelTitle-{{ section.id }}-{{ forloop.index }}" hidden>
          <div class="drawer__head mdrawer__head mdrawer__head--panel">
            <button type="button" class="mdrawer__back" data-mdrawer-back>{%- render 'icon', icon: 'chevron-left' -%}<span>{{ 'general.back' | t }}</span></button>
            <p class="mdrawer__panel-title" id="MenuPanelTitle-{{ section.id }}-{{ forloop.index }}">{{ link.title }}</p>
            <button type="button" class="icon-btn mdrawer__x" data-drawer-close commandfor="MenuDrawer" command="close" aria-label="{{ 'header.menu_close' | t }}">{%- render 'icon', icon: 'close' -%}</button>
          </div>
          <div class="drawer__body mdrawer__body">
            <a class="mdrawer__all" href="{{ link.url }}"{% if cur_key == ti %} aria-current="page"{% endif %}>
              {%- if link.type == 'collection_link' and link.object.image != blank -%}
                <span class="mdrawer__all-media">{{ link.object.image | image_url: width: 192 | image_tag: widths: '64, 128, 192', sizes: '64px', loading: 'lazy', alt: '' }}</span>
              {%- endif -%}
              <span class="mdrawer__all-text">
                <span class="mdrawer__all-title">{%- render 'header-all-label', link: link -%}</span>
                {%- if link.type == 'collection_link' and link.object.all_products_count > 0 -%}<span class="mdrawer__all-count">{{ 'header.products_count' | t: count: link.object.all_products_count }}</span>{%- endif -%}
              </span>
              {%- render 'icon', icon: 'arrow-right', class: 'icon--sm' -%}
            </a>
            {%- capture thumbs_ok -%}{%- render 'header-thumbs-ok', link: link -%}{%- endcapture -%}
            {%- assign panel_seen = '' -%}
            {%- capture panel_heads -%}{%- render 'header-panel-heads', link: link, menu: menu -%}{%- endcapture -%}
            <ul class="mdrawer__groups{% if thumbs_ok == 'yes' %} mdrawer__groups--thumbs{% endif %}" role="list">
              {%- for child in link.links -%}
                {%- capture group_thumb -%}
                  {%- if thumbs_ok == 'yes' -%}<span class="mdrawer__thumb">{{ child.object.image | image_url: width: 144 | image_tag: widths: '48, 96, 144', sizes: '48px', loading: 'lazy', alt: '' }}</span>{%- endif -%}
                {%- endcapture -%}
                {%- assign tj = ti | append: '-' | append: forloop.index -%}
                {%- assign head_key = '|' | append: child.url | append: '|' -%}
                {%- assign skip_urls = child.url | append: '|' | append: promo_url | append: panel_seen | append: panel_heads -%}
                {%- for g in child.links -%}{%- assign panel_seen = panel_seen | append: '|' | append: g.url -%}{%- endfor -%}
                {%- comment -%} a panel with one group (Zakelijk) lists that group's links as its rows, without an accordion {%- endcomment -%}
                {%- if link.links.size == 1 and child.links != blank and child.url == link.url -%}
                  <li class="mdrawer__flat">{%- render 'header-sublinks', links: child.links, label: child.title, key: tj, current: cur_key, skip: skip_urls -%}</li>
                  {%- continue -%}
                {%- endif -%}
                <li>
                  {%- if child.links != blank -%}
                    <details class="mdrawer__group">
                      <summary class="mdrawer__group-title">
                        {{ group_thumb }}<span class="mdrawer__group-name">{{ child.title }}</span>
                        {%- render 'icon', icon: 'chevron-down', class: 'icon--sm mdrawer__pm' -%}
                      </summary>
                      <div class="mdrawer__group-body">
                        {%- if panel_heads contains head_key -%}
                          <a class="mdrawer__group-all" href="{{ child.url }}"{% if cur_key == tj %} aria-current="page"{% endif %}>{%- render 'header-all-label', link: child -%}</a>
                        {%- endif -%}
                        {%- render 'header-sublinks', links: child.links, label: child.title, key: tj, current: cur_key, skip: skip_urls -%}
                      </div>
                    </details>
                  {%- else -%}
                    <a class="mdrawer__group-title" href="{{ child.url }}"{% if cur_key == tj %} aria-current="page"{% endif %}>{{ group_thumb }}<span class="mdrawer__group-name">{{ child.title }}</span>{%- render 'icon', icon: 'arrow-right', class: 'icon--sm' -%}</a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
            {%- render 'header-promo', link: link, blocks: section.blocks, context: 'drawer', collection_fallback: false -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </dialog>
</menu-drawer>
<script src="{{ 'section-header.js' | asset_url }}" defer></script>
{%- if request.design_mode -%}<script src="{{ 'section-header-editor.js' | asset_url }}" defer></script>{%- endif -%}

{% schema %}
{
  "name": "Header",
  "tag": "div",
  "class": "section-header",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurschema", "default": "scheme-1" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Drie niveaus: categorie, subcategorie, links. Het tweede niveau wordt een kolom in het megamenu." },
    {
      "type": "select", "id": "sticky", "label": "Vastzetten bij scrollen",
      "options": [
        { "value": "always", "label": "Altijd" },
        { "value": "scroll-up", "label": "Alleen bij omhoog scrollen" },
        { "value": "none", "label": "Nooit" }
      ],
      "default": "scroll-up"
    },
    { "type": "checkbox", "id": "show_quote", "label": "Knop 'Offerte' tonen", "default": true },
    { "type": "checkbox", "id": "show_contact", "label": "Telefoon en WhatsApp in de menubalk", "default": true },
    { "type": "header", "content": "Zoeken" },
    { "type": "text", "id": "search_popular", "label": "Populaire zoekopdrachten", "default": "partytent 3x3, statafel, statafelrok, zijwanden, voetgewichten, prikkabel", "info": "Verschijnen als knoppen zodra iemand in het lege zoekveld klikt. Scheiden met een komma. Leeg = niet tonen." },
    { "type": "link_list", "id": "search_menu", "label": "Categorieën bij het lege zoekveld", "info": "Leeg = de eerste zes categorieën met een afbeelding uit het hoofdmenu." },
    { "type": "text", "id": "deal_items", "label": "Menu-item met actielabel", "default": "Actie", "info": "Titel van het hoofdmenu-item dat het Zon-label krijgt (merkboek §7.2). Meerdere titels scheiden met een komma, ook de vertaalde titel (bv. Actie, Sale). Hernoem je het menu-item, pas dit dan ook aan." }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Megamenu-promotie",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Bij menu-item", "info": "Titel van het hoofdmenu-item, bv. Partytenten. Meerdere titels scheiden met een komma (ook de vertaalde titel, bv. Partytenten, Party tents). De kaart staat naast de kolommen van het megamenu en onderaan dat onderdeel in het mobiele menu. Hernoem je het menu-item, pas dit dan ook aan: de editor waarschuwt als geen menu-item meer past." },
        { "type": "image_picker", "id": "image", "label": "Afbeelding" },
        { "type": "select", "id": "fallback_image", "label": "Standaardbeeld", "info": "Meegeleverde 3D-render, zichtbaar zolang er geen beeld gekozen is.", "options": [
        { "value": "none", "label": "Geen (lege plek)" },
        { "value": "scene-hero", "label": "Tent met statafels" },
        { "value": "scene-zakelijk", "label": "Zakelijke opstelling" },
        { "value": "tent-logo", "label": "Partytent met logo" },
        { "value": "tent-front", "label": "Partytent met logo, vooraanzicht" },
        { "value": "rok-logo", "label": "Statafelrok met logo" }
      ], "default": "none" },
        { "type": "text", "id": "eyebrow", "label": "Bovenregel" },
        { "type": "text", "id": "heading", "label": "Kop", "default": "Met jouw logo" },
        { "type": "text", "id": "text", "label": "Tekst" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Linktekst", "default": "Bekijk" }
      ]
    }
  ]
}
{% endschema %}
