{%- comment -%}
  Loaded lazily through /recommendations/products?section_id=…&product_id=…&intent=… (Section Rendering API).
{%- endcomment -%}
<product-recommendations class="section recommendations color-{{ section.settings.color_scheme }}" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="section-head">
        <h2 class="section-head__title">{%- if section.settings.heading != blank -%}{{ section.settings.heading }}{%- elsif section.settings.intent == 'complementary' -%}{{ 'product.complementary' | t }}{%- else -%}{{ 'product.recommendations' | t }}{%- endif -%}</h2>
      </div>
      <ul class="slider slider--desktop-grid" role="list" style="--cols: {{ section.settings.limit }}; --slide-w: 68%">
        {%- for rec in recommendations.products -%}
          <li>{%- render 'product-card', product: rec, sizes: '(min-width: 990px) 320px, 68vw' -%}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Productaanbevelingen",
  "class": "section-recommendations",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurschema", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Vaak samen bekeken" },
    { "type": "select", "id": "intent", "label": "Soort", "options": [ { "value": "related", "label": "Vergelijkbaar" }, { "value": "complementary", "label": "Aanvullend (Search & Discovery)" } ], "default": "related" },
    { "type": "range", "id": "limit", "min": 2, "max": 6, "step": 1, "label": "Aantal", "default": 4 }
  ]
}
{% endschema %}
