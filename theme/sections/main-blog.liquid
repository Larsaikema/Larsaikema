{{ 'section-blog.css' | asset_url | stylesheet_tag }}
<div class="page-width section section--tight">
  <header class="blog-head">
    {%- render 'breadcrumbs' -%}
    <h1>{{ blog.title }}</h1>
    {%- if section.settings.intro != blank -%}<div class="rte text-lg muted">{{ section.settings.intro }}</div>{%- endif -%}
    {%- if blog.all_tags.size > 0 -%}
      <nav class="blog-tags chips chips--scroll" aria-label="{{ 'blog.tags' | t }}">
        <a class="chip{% unless current_tags %} chip--active{% endunless %}" href="{{ blog.url }}">{{ 'blog.all' | t }}</a>
        {%- for tag in blog.all_tags -%}
          <a class="chip{% if current_tags contains tag %} chip--active{% endif %}" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </header>
  {%- paginate blog.articles by 9 -%}
    {%- if blog.articles.size > 0 -%}
      <ul class="blog-grid" role="list">
        {%- for article in blog.articles -%}
          <li>{%- render 'article-card', article: article, priority: forloop.first -%}</li>
        {%- endfor -%}
      </ul>
      {%- render 'pagination', paginate: paginate -%}
    {%- else -%}
      <p class="muted">{{ 'blog.empty' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "class": "section-main-blog",
  "settings": [ { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Opzetten, onderhouden, de juiste maat kiezen. Praktisch advies van mensen die het elke week doen.</p>" } ]
}
{% endschema %}
