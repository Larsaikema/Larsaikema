{%- comment -%}
  Blog index (feature content.blog): title, intro, topic filter (the first public tag of each article, so the filter
  matches the topic on the cards; tags with ':' are internal), the newest article as a wide feature on page 1, then a grid.
{%- endcomment -%}
{{ 'section-blog.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign topics = ''
  for a in blog.articles
    for tag in a.tags
      unless tag contains ':'
        assign key = '|' | append: tag | append: '|'
        unless topics contains key
          assign topics = topics | append: key
        endunless
        break
      endunless
    endfor
  endfor
  assign topic_list = topics | remove_first: '|' | split: '||'
-%}
<div class="page-width section section--tight blog-page">
  <header class="blog-head">
    {%- render 'breadcrumbs' -%}
    <h1 class="blog-head__title">{% if current_tags %}{{ blog.title }}: {{ current_tags.first }}{% else %}{{ blog.title }}{% endif %}</h1>
    {%- if section.settings.intro != blank -%}<div class="rte text-lg blog-head__intro">{{ section.settings.intro }}</div>{%- endif -%}
    {%- if topic_list.size > 1 -%}
      <nav class="blog-tags chips chips--scroll" aria-label="{{ 'blog.tags' | t }}">
        <a class="chip{% unless current_tags %} chip--active{% endunless %}" href="{{ blog.url }}"{% unless current_tags %} aria-current="page"{% endunless %}>{{ 'blog.all' | t }}</a>
        {%- for tag in topic_list -%}
          {%- assign t = tag | remove: '|' -%}
          {%- if t != blank -%}
            {%- assign is_cur = false -%}
            {%- if current_tags contains t -%}{%- assign is_cur = true -%}{%- endif -%}
            <a class="chip{% if is_cur %} chip--active{% endif %}" href="{{ blog.url }}/tagged/{{ t | handleize }}"{% if is_cur %} aria-current="page"{% endif %}>{{ t | capitalize }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </header>
  {%- paginate blog.articles by 13 -%}
    {%- if blog.articles.size > 0 -%}
      {%- assign featured = false -%}
      {%- if paginate.current_page == 1 and current_tags == blank and section.settings.feature_first -%}{%- assign featured = true -%}{%- endif -%}
      <ul class="blog-grid{% if featured %} blog-grid--featured{% endif %}" role="list">
        {%- for article in blog.articles -%}
          <li>{%- if featured and forloop.first -%}{%- render 'article-card', article: article, priority: true, featured: true -%}{%- else -%}{%- render 'article-card', article: article, priority: false -%}{%- endif -%}</li>
        {%- endfor -%}
      </ul>
      {%- render 'pagination', paginate: paginate -%}
    {%- else -%}
      <p class="muted">{{ 'blog.empty' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "class": "section-main-blog",
  "settings": [
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Opzetten, onderhouden, de juiste maat kiezen. Praktisch advies van mensen die het elke week doen.</p>" },
    { "type": "checkbox", "id": "feature_first", "label": "Nieuwste artikel groot bovenaan", "default": true }
  ]
}
{% endschema %}
