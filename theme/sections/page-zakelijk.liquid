{{ 'section-pages.css' | asset_url | stylesheet_tag }}
{%- comment -%} Klapklaar Zakelijk (brand.md v6 §6): Linnen + Inkt, one-colour logo with the ZAKELIJK label, Inkt buttons, no festive flags. {%- endcomment -%}
{%- liquid
  assign form_id = 'B2BForm-' | append: section.id
  assign quote_url = settings.quote_page | default: '/pages/offerte'
  assign staffel_rows = section.settings.staffel | newline_to_br | split: '<br />'
-%}
<div class="color-scheme-4">
  <div class="page-width b2b-hero">
    {%- render 'breadcrumbs' -%}
    <div class="b2b-hero__grid">
      <div>
        <p class="b2b-hero__logo">{%- render 'logo', variant: 'zakelijk' -%}</p>
        <h1>{{ section.settings.heading | default: page.title }}</h1>
        <div class="rte text-lg">{{ section.settings.intro }}</div>
        <div class="btn-row" style="margin-top:24px">
          <a class="btn" href="{{ quote_url }}">{{ settings.b2b_cta_label }}</a>
          <a class="btn btn--outline" href="#B2BContact">{{ section.settings.contact_label }}</a>
        </div>
        {%- assign segs = section.settings.segments | split: ',' -%}
        {%- if segs.size > 0 -%}
          <ul class="segments" role="list" aria-label="{{ section.settings.segments_label | escape }}">
            {%- for sgm in segs -%}<li class="chip">{%- render 'icon', icon: 'check', class: 'icon--xs' -%}{{ sgm | strip }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      <div class="panel">
        <h2 class="panel__title">{{ section.settings.staffel_heading }}</h2>
        <p class="muted text-sm">{{ section.settings.staffel_text }}</p>
        <div class="table-wrap example-staffel">
          <table class="table">
            <thead><tr><th scope="col">{{ 'product.staffel_qty' | t }}</th><th scope="col">{{ 'product.staffel_discount' | t }}</th></tr></thead>
            <tbody>
              {%- for row in staffel_rows -%}
                {%- assign parts = row | split: ':' -%}
                {%- if parts.size == 2 -%}<tr><td>{{ parts.first | strip }}</td><td><strong>{{ parts.last | strip }}</strong></td></tr>{%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        <p class="form-note">{{ section.settings.staffel_note }}</p>
      </div>
    </div>
  </div>
</div>

<div class="section color-scheme-1">
  <div class="page-width">
    <div class="section-head"><h2 class="section-head__title">{{ section.settings.benefits_heading }}</h2></div>
    <ul class="benefits benefits--4" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'benefit' -%}
          <li class="benefit" {{ block.shopify_attributes }}>
            <span class="benefit__icon">{%- render 'icon', icon: block.settings.icon -%}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

<div class="section color-scheme-4" id="B2BContact">
  <div class="page-width split">
    <div>
      <h2>{{ section.settings.form_heading }}</h2>
      <div class="rte">{{ section.settings.form_text }}</div>
      {%- if page.content != blank -%}<div class="rte" style="margin-top:16px">{{ page.content }}</div>{%- endif -%}
    </div>
    <div class="panel">
      {%- form 'contact', id: form_id -%}
        <input type="hidden" name="contact[Onderwerp]" value="Zakelijk account / vraag">
        {%- if form.posted_successfully? -%}
          <div class="notice notice--success" role="status">{%- render 'icon', icon: 'check' -%}<span><strong>{{ 'forms.contact_success' | t }}</strong></span></div>
        {%- else -%}
          {%- if form.errors -%}<div class="notice notice--error" role="alert">{%- render 'icon', icon: 'alert' -%}<span><strong>{{ 'forms.error_heading' | t }}</strong>{% render 'form-errors', form: form %}</span></div>{%- endif -%}
          <div class="form-grid form-grid--2">
            <div class="field"><label class="field__label" for="B2B-company">{{ 'forms.company' | t }} <span class="required" aria-hidden="true">*</span></label><input class="input" id="B2B-company" name="contact[Bedrijfsnaam]" autocomplete="organization" required></div>
            <div class="field"><label class="field__label" for="B2B-name">{{ 'forms.contact_person' | t }} <span class="required" aria-hidden="true">*</span></label><input class="input" id="B2B-name" name="contact[name]" autocomplete="name" required></div>
            <div class="field"><label class="field__label" for="B2B-email">{{ 'forms.email' | t }} <span class="required" aria-hidden="true">*</span></label><input class="input" id="B2B-email" type="email" name="contact[email]" autocomplete="email" required></div>
            <div class="field"><label class="field__label" for="B2B-phone">{{ 'forms.phone' | t }}</label><input class="input" id="B2B-phone" type="tel" name="contact[phone]" autocomplete="tel"></div>
            <div class="field"><label class="field__label" for="B2B-kvk">{{ 'forms.kvk' | t }}</label><input class="input" id="B2B-kvk" name="contact[KvK-nummer]" inputmode="numeric"></div>
            <div class="field"><label class="field__label" for="B2B-btw">{{ 'forms.btw' | t }}</label><input class="input" id="B2B-btw" name="contact[Btw-nummer]"></div>
            <div class="field field--full">
              <label class="field__label" for="B2B-sector">{{ 'forms.sector' | t }}</label>
              <select class="select" id="B2B-sector" name="contact[Branche]">
                {%- for sgm in segs -%}<option>{{ sgm | strip }}</option>{%- endfor -%}
                <option>{{ section.settings.other_label }}</option>
              </select>
            </div>
            <div class="field field--full"><label class="field__label" for="B2B-body">{{ 'forms.message' | t }}</label><textarea class="textarea" id="B2B-body" name="contact[body]" rows="4"></textarea></div>
          </div>
          <div class="form-actions"><button type="submit" class="btn">{{ 'forms.send' | t }}</button><a class="link" href="{{ quote_url }}">{{ settings.b2b_cta_label }}</a></div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Zakelijk",
  "class": "section-page-zakelijk",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Bestellen voor je bedrijf, club of school" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Voor horeca, eventbureaus, verhuurbedrijven, verenigingen en scholen. Prijzen excl. btw, staffelkorting en een offerte op maat.</p>" },
    { "type": "text", "id": "contact_label", "label": "Tweede knop", "default": "Zakelijk account aanvragen" },
    { "type": "text", "id": "segments", "label": "Doelgroepen (komma's)", "default": "Horeca, Eventbureaus, Verhuurbedrijven, Verenigingen, Scholen" },
    { "type": "text", "id": "segments_label", "label": "Label doelgroepen", "default": "Voor wie" },
    { "type": "text", "id": "staffel_heading", "label": "Kop staffel", "default": "Staffelkorting" },
    { "type": "text", "id": "staffel_text", "label": "Tekst staffel", "default": "Een voorbeeld. De exacte staffel staat op elke productpagina." },
    { "type": "textarea", "id": "staffel", "label": "Staffelregels (Aantal: korting)", "default": "Vanaf 10 stuks: 5%\nVanaf 25 stuks: 10%\nVanaf 50 stuks: 15%", "info": "Claim: alleen tonen wat je ook echt als korting instelt." },
    { "type": "text", "id": "staffel_note", "label": "Noot", "default": "Meer nodig? Dan maken we een offerte op maat." },
    { "type": "text", "id": "benefits_heading", "label": "Kop voordelen", "default": "Wat je krijgt" },
    { "type": "text", "id": "form_heading", "label": "Kop formulier", "default": "Zakelijk account aanvragen" },
    { "type": "richtext", "id": "form_text", "label": "Tekst formulier", "default": "<p>Laat je gegevens achter. We zetten je account klaar zodat je prijzen excl. btw ziet en op factuur kunt bestellen.</p>" },
    { "type": "text", "id": "other_label", "label": "Optie 'anders'", "default": "Anders" }
  ],
  "blocks": [
    { "type": "benefit", "name": "Voordeel", "settings": [
      { "type": "select", "id": "icon", "label": "Icoon", "options": [ { "value": "invoice", "label": "Factuur" }, { "value": "euro", "label": "Euro" }, { "value": "proof", "label": "Drukproef" }, { "value": "truck", "label": "Levering" }, { "value": "pallet", "label": "Pallet" }, { "value": "chat", "label": "Contact" }, { "value": "case", "label": "Zakelijk" } ], "default": "invoice" },
      { "type": "text", "id": "title", "label": "Titel", "default": "Op factuur" },
      { "type": "text", "id": "text", "label": "Tekst" }
    ] }
  ],
  "presets": [{ "name": "Zakelijk" }]
}
{% endschema %}
