{{ 'section-pages.css' | asset_url | stylesheet_tag }}
<div class="page-width">
  <div class="not-found">
    {%- render 'icon', icon: 'tent', class: 'icon--lg' -%}
    <p class="eyebrow">404</p>
    <h1>{{ 'not_found.title' | t }}</h1>
    <p class="text-lg muted">{{ 'not_found.text' | t }}</p>
    <form action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="NotFoundSearch">{{ 'search.title' | t }}</label>
      <input class="input" type="search" id="NotFoundSearch" name="q" placeholder="{{ 'search.placeholder' | t }}">
      <button class="btn btn--outline" type="submit">{{ 'header.search_submit' | t }}</button>
    </form>
    <div class="btn-row">
      <a class="btn btn--outline" href="{{ routes.root_url }}">{{ 'not_found.home' | t }}</a>
      <a class="btn" href="{{ section.settings.cta_link | default: routes.collections_url }}">{{ 'not_found.cta' | t }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404",
  "class": "section-main-404",
  "settings": [ { "type": "url", "id": "cta_link", "label": "Link 'Bekijk partytenten'" } ]
}
{% endschema %}
