{%- if template.name == 'index' -%}{{ 'section-blog-posts.css' | asset_url | stylesheet_tag }}{%- else -%}{{ 'section-blog.css' | asset_url | stylesheet_tag }}{%- endif -%}
{%- assign b = section.settings.blog -%}
<section class="section blog-posts color-{{ section.settings.color_scheme }}" aria-labelledby="Title-{{ section.id }}">
  <div class="page-width">
    <div class="section-head">
      <h2 class="section-head__title" id="Title-{{ section.id }}">{{ section.settings.heading | default: b.title }}</h2>
      {%- if b != blank -%}<a class="link" href="{{ b.url }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    <ul class="slider slider--desktop-grid" role="list" style="--cols: {{ section.settings.limit }}; --slide-w: 80%">
      {%- if b != blank -%}
        {%- assign shown = 0 -%}
        {%- for a in b.articles limit: 12 -%}
          {%- if section.settings.exclude_current and article and a.id == article.id -%}{%- continue -%}{%- endif -%}
          {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <li>{%- render 'article-card', article: a -%}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Blogartikelen",
  "class": "section-blog-posts",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurschema", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Advies & inspiratie" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "limit", "min": 2, "max": 4, "step": 1, "label": "Aantal artikelen", "default": 3 },
    { "type": "text", "id": "link_label", "label": "Linktekst", "default": "Alle artikelen" },
    { "type": "checkbox", "id": "exclude_current", "label": "Huidig artikel overslaan (op een artikelpagina)", "default": true }
  ],
  "presets": [{ "name": "Blogartikelen" }]
}
{% endschema %}
