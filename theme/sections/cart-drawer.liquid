{%- comment -%}
  Cart drawer. Rendered statically in layout/theme.liquid and re-rendered through the Section Rendering API
  (sections=cart-drawer) after every add / change. The <dialog> stays in the DOM; JS swaps its contents.
{%- endcomment -%}
{{ 'component-cart.css' | asset_url | stylesheet_tag }}
<cart-drawer class="cart-drawer-wrap">
  <dialog class="drawer cart-drawer" id="CartDrawer" aria-labelledby="CartDrawerTitle" data-item-count="{{ cart.item_count }}">
    <div class="drawer__head">
      <h2 class="drawer__title h3" id="CartDrawerTitle">
        {%- if cart.item_count > 0 -%}{{ 'cart.title_count' | t: count: cart.item_count }}{%- else -%}{{ 'cart.title' | t }}{%- endif -%}
      </h2>
      <button type="button" class="icon-btn" data-drawer-close aria-label="{{ 'general.close' | t }}">{%- render 'icon', icon: 'close' -%}</button>
    </div>
    {%- if cart.item_count > 0 -%}
      {%- render 'cart-free-shipping' -%}
      <div class="drawer__body">
        <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm" novalidate>
          <cart-items data-section-id="cart-drawer">
            <ul class="cart-lines" role="list">
              {%- for item in cart.items -%}
                {%- render 'cart-line', item: item, index: forloop.index, compact: true -%}
              {%- endfor -%}
            </ul>
          </cart-items>
        </form>
        {%- assign upsell = settings.cart_upsell_collection -%}
        {%- if upsell != blank and upsell.products_count > 0 -%}
          {%- assign in_cart = cart.items | map: 'product_id' -%}
          {%- capture upsell_items -%}
            {%- assign shown = 0 -%}
            {%- for p in upsell.products -%}
              {%- if in_cart contains p.id or p.available == false -%}{%- continue -%}{%- endif -%}
              {%- if shown >= settings.cart_upsell_limit -%}{%- break -%}{%- endif -%}
              {%- assign shown = shown | plus: 1 -%}
              <li class="upsell__item">
                <a class="upsell__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
                  {%- if p.featured_media -%}{{ p.featured_media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', widths: '80, 160', sizes: '64px' }}{%- endif -%}
                </a>
                <div class="upsell__info">
                  <a class="upsell__title" href="{{ p.url }}">{{ p.title }}</a>
                  <span class="upsell__price">{% if p.price_varies %}{{ 'price.from' | t }} {% endif %}{{ p.price | money }}</span>
                </div>
                {%- if p.has_only_default_variant -%}
                  {%- form 'product', p, data-product-form: '', class: 'upsell__form' -%}
                    <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                    <button type="submit" name="add" class="icon-btn upsell__add" aria-label="{{ 'card.quick_add_label' | t: title: p.title | escape }}">{%- render 'icon', icon: 'plus', class: 'icon--sm' -%}</button>
                  {%- endform -%}
                {%- else -%}
                  <a class="icon-btn upsell__add" href="{{ p.url }}" aria-label="{{ 'card.choose' | t }}: {{ p.title | escape }}">{%- render 'icon', icon: 'chevron-right', class: 'icon--sm' -%}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- endcapture -%}
          {%- if shown > 0 -%}
            <section class="upsell" aria-labelledby="UpsellTitle">
              <h3 class="upsell__heading h4" id="UpsellTitle">{{ 'cart.upsell_title' | t }}</h3>
              <ul class="upsell__list" role="list">{{ upsell_items }}</ul>
            </section>
          {%- endif -%}
        {%- endif -%}
      </div>
      <div class="drawer__foot">
        {%- render 'cart-summary', form_id: 'CartDrawerForm', context: 'drawer' -%}
      </div>
    {%- else -%}
      <div class="drawer__body cart-empty">
        {%- render 'icon', icon: 'tent', class: 'icon--lg' -%}
        <p class="h3">{{ 'cart.empty_title' | t }}</p>
        <p class="muted">{{ 'cart.empty_text' | t }}</p>
        <a class="btn" href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}">{{ 'cart.empty_cta' | t }}</a>
        <button type="button" class="btn btn--ghost" data-drawer-close>{{ 'cart.continue' | t }}</button>
      </div>
    {%- endif -%}
  </dialog>
</cart-drawer>

{% schema %}
{
  "name": "Winkelwagen-drawer",
  "settings": [
    { "type": "url", "id": "empty_link", "label": "Link bij lege winkelwagen", "info": "Standaard alle producten." }
  ]
}
{% endschema %}
