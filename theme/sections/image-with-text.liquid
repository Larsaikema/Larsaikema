{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}
<section class="section iwt color-{{ section.settings.color_scheme }} iwt--{{ section.settings.layout }}{% if section.settings.image_fit == 'contain' %} iwt--contain{% endif %}" aria-labelledby="Title-{{ section.id }}">
  <div class="page-width iwt__inner">
    <div class="iwt__media">
      {%- if section.settings.image != blank -%}
        {%- render 'image', image: section.settings.image, sizes: '(min-width: 990px) 50vw, 100vw', widths: '480, 640, 800, 1000, 1200, 1400' -%}
      {%- else -%}
        {%- render 'fallback-image', key: section.settings.fallback_image, alt: '' -%}
      {%- endif -%}
      {%- if section.settings.badge != blank -%}<span class="badge badge--logo iwt__badge">{%- render 'icon', icon: 'upload' -%}{{ section.settings.badge }}</span>{%- endif -%}
    </div>
    <div class="iwt__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}<p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
          {%- when 'heading' -%}<h2 class="iwt__title" id="Title-{{ section.id }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'text' -%}<div class="iwt__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'steps' -%}
            <ol class="steps" {{ block.shopify_attributes }}>
              {%- for i in (1..4) -%}
                {%- assign t_key = 'step_' | append: i -%}
                {%- if block.settings[t_key] != blank -%}<li class="steps__item"><span class="steps__num" aria-hidden="true">{{ i }}</span><span>{{ block.settings[t_key] }}</span></li>{%- endif -%}
              {%- endfor -%}
            </ol>
          {%- when 'checklist' -%}
            <ul class="checklist" {{ block.shopify_attributes }}>
              {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
              {%- for it in items -%}{%- assign it_s = it | strip -%}{%- if it_s != blank -%}<li>{%- render 'icon', icon: 'check' -%}<span>{{ it_s }}</span></li>{%- endif -%}{%- endfor -%}
            </ul>
          {%- when 'buttons' -%}
            {%- capture l1_ok -%}{%- render 'link-exists', url: block.settings.link_1 -%}{%- endcapture -%}
            {%- capture l2_ok -%}{%- render 'link-exists', url: block.settings.link_2 -%}{%- endcapture -%}
            <div class="btn-row" {{ block.shopify_attributes }}>
              {%- if block.settings.label_1 != blank and l1_ok == 'true' -%}<a class="btn" href="{{ block.settings.link_1 }}">{{ block.settings.label_1 }}</a>{%- endif -%}
              {%- if block.settings.label_2 != blank and l2_ok == 'true' -%}<a class="btn btn--outline" href="{{ block.settings.link_2 }}">{{ block.settings.label_2 }}</a>{%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Beeld met tekst",
  "class": "section-image-with-text",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurschema", "default": "scheme-1" },
    { "type": "image_picker", "id": "image", "label": "Beeld" },
    { "type": "select", "id": "fallback_image", "label": "Standaardbeeld", "info": "Meegeleverde 3D-render, zichtbaar zolang er geen beeld gekozen is.", "options": [
        { "value": "none", "label": "Geen (lege plek)" },
        { "value": "scene-hero", "label": "Tent met statafels" },
        { "value": "scene-zakelijk", "label": "Zakelijke opstelling" },
        { "value": "tent-logo", "label": "Partytent met logo" },
        { "value": "tent-front", "label": "Partytent met logo, vooraanzicht" },
        { "value": "rok-logo", "label": "Statafelrok met logo" }
      ], "default": "none" },
    { "type": "select", "id": "image_fit", "label": "Beeld in het vlak", "options": [ { "value": "cover", "label": "Vullen (foto)" }, { "value": "contain", "label": "Helemaal tonen (render op Linnen)" } ], "default": "cover" },
    { "type": "text", "id": "badge", "label": "Badge op het beeld", "info": "Bijvoorbeeld 'Voorbeeldopdruk' bij een render met logo." },
    { "type": "select", "id": "layout", "label": "Indeling", "options": [ { "value": "image-left", "label": "Beeld links" }, { "value": "image-right", "label": "Beeld rechts" } ], "default": "image-left" }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Bovenregel", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Tekst", "default": "Met jouw logo" } ] },
    { "type": "heading", "name": "Kop", "limit": 1, "settings": [ { "type": "text", "id": "heading", "label": "Kop", "default": "Je eigen tent, met drukproef vooraf" } ] },
    { "type": "text", "name": "Tekst", "settings": [ { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Upload je logo, je krijgt eerst een drukproef ter akkoord.</p>" } ] },
    { "type": "steps", "name": "Stappen", "limit": 1, "settings": [
      { "type": "text", "id": "step_1", "label": "Stap 1", "default": "Kies je product en upload je logo" },
      { "type": "text", "id": "step_2", "label": "Stap 2", "default": "Je krijgt een drukproef ter akkoord" },
      { "type": "text", "id": "step_3", "label": "Stap 3", "default": "Na je akkoord drukken en leveren we" },
      { "type": "text", "id": "step_4", "label": "Stap 4" }
    ] },
    { "type": "checklist", "name": "Vinkjeslijst", "settings": [ { "type": "textarea", "id": "items", "label": "Regels", "default": "Eerst een drukproef\nVanaf 10 stuks staffelprijs" } ] },
    { "type": "buttons", "name": "Knoppen", "limit": 1, "settings": [
      { "type": "text", "id": "label_1", "label": "Knop 1", "default": "Ontwerp je tent" },
      { "type": "url", "id": "link_1", "label": "Link 1" },
      { "type": "text", "id": "label_2", "label": "Knop 2" },
      { "type": "url", "id": "link_2", "label": "Link 2" }
    ] }
  ],
  "presets": [{ "name": "Beeld met tekst", "blocks": [{ "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }, { "type": "buttons" }] }]
}
{% endschema %}
