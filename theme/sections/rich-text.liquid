<section class="section rich-text color-{{ section.settings.color_scheme }}{% if section.settings.narrow %} rich-text--narrow{% endif %}">
  <div class="page-width{% if section.settings.narrow %} page-width--text{% endif %} rich-text__inner rich-text__inner--{{ section.settings.align }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}<p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- when 'heading' -%}<h2 class="{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
        {%- when 'text' -%}<div class="rte text-lg" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <div class="btn-row" {{ block.shopify_attributes }}>
            <a class="btn{% if block.settings.style != 'primary' %} btn--{{ block.settings.style }}{% endif %}" href="{{ block.settings.link }}">{{ block.settings.label }}</a>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>
<style>
  #shopify-section-{{ section.id }} .rich-text__inner{display:flex;flex-direction:column;gap:16px}
  #shopify-section-{{ section.id }} .rich-text__inner>*{margin:0}
  #shopify-section-{{ section.id }} .rich-text__inner--center{align-items:center;text-align:center}
  #shopify-section-{{ section.id }} .rich-text__inner--center .rte{max-width:60ch}
</style>

{% schema %}
{
  "name": "Tekst",
  "class": "section-rich-text",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurschema", "default": "scheme-1" },
    { "type": "checkbox", "id": "narrow", "label": "Smalle kolom", "default": true },
    { "type": "select", "id": "align", "label": "Uitlijning", "options": [ { "value": "left", "label": "Links" }, { "value": "center", "label": "Midden" } ], "default": "center" }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Bovenregel", "settings": [ { "type": "text", "id": "text", "label": "Tekst", "default": "Klapklaar" } ] },
    { "type": "heading", "name": "Kop", "settings": [
      { "type": "text", "id": "heading", "label": "Kop", "default": "Kies je maat, wij doen de rest." },
      { "type": "select", "id": "size", "label": "Grootte", "options": [ { "value": "h1", "label": "Groot" }, { "value": "h2", "label": "Normaal" }, { "value": "h3", "label": "Klein" } ], "default": "h2" }
    ] },
    { "type": "text", "name": "Tekst", "settings": [ { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Elke productpagina noemt maat, materiaal, gewicht en levertijd voordat er sfeer komt.</p>" } ] },
    { "type": "button", "name": "Knop", "settings": [
      { "type": "text", "id": "label", "label": "Tekst", "default": "Bekijk partytenten" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "select", "id": "style", "label": "Stijl", "options": [ { "value": "primary", "label": "Primair" }, { "value": "secondary", "label": "Secundair" }, { "value": "outline", "label": "Omlijnd" } ], "default": "primary" }
    ] }
  ],
  "presets": [{ "name": "Tekst", "blocks": [{ "type": "heading" }, { "type": "text" }, { "type": "button" }] }]
}
{% endschema %}
