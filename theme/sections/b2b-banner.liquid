{%- comment -%} Klapklaar Zakelijk call-to-action (Linnen / Polder, no festive flags, brand.md §6). {%- endcomment -%}
{{ 'section-b2b-banner.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign b2b_has_media = false
  if section.settings.image != blank or section.settings.fallback_image != 'none'
    assign b2b_has_media = true
  endif
-%}
<section class="section b2b color-{{ section.settings.color_scheme }}" aria-labelledby="Title-{{ section.id }}">
  <div class="page-width">
    <div class="b2b__panel{% if b2b_has_media %} b2b__panel--media{% endif %}">
      {%- capture b2b_list -%}
        <ul class="b2b__list" role="list">
          {%- for block in section.blocks -%}
            <li class="b2b__item" {{ block.shopify_attributes }}>
              <span class="b2b__icon">{%- render 'icon', icon: block.settings.icon -%}</span>
              <span class="b2b__item-body"><strong>{{ block.settings.title }}</strong>
                {%- if block.settings.vat_toggle and settings.price_display == 'toggle' -%}
                  {%- comment -%}
                    The same switch as in the header (global.js vat-toggle, html[data-vat]), here because on a phone the header has
                    no room for it: whoever reads 'prijzen excl. btw' can switch right here, and the line says what is shown now.
                  {%- endcomment -%}
                  <span class="b2b__item-text" data-vat-show="incl">{{ block.settings.text | default: block.settings.text_incl }}</span>
                  <span class="b2b__item-text" data-vat-show="excl">{{ block.settings.text_excl | default: block.settings.text }}</span>
                  {%- liquid
                    assign vat_p = settings.b2b_toggle_particulier | default: 'Particulier'
                    assign vat_z = settings.b2b_toggle_zakelijk | default: 'Zakelijk'
                    if request.locale.primary == false
                      assign vat_p = 'header.vat_particulier' | t
                      assign vat_z = 'header.vat_zakelijk' | t
                    endif
                  -%}
                  <vat-toggle class="vat-toggle vat-toggle--stack b2b__vat" role="group" aria-label="{{ 'header.vat_toggle' | t }}">
                    <button type="button" data-vat-set="incl" aria-pressed="true">{{ vat_p }} <small>{{ 'price.incl' | t }}</small></button>
                    <button type="button" data-vat-set="excl" aria-pressed="false">{{ vat_z }} <small>{{ 'price.excl' | t }}</small></button>
                  </vat-toggle>
                {%- elsif block.settings.text != blank -%}<span class="b2b__item-text">{{ block.settings.text }}</span>{%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endcapture -%}
      {%- if b2b_has_media -%}
        <div class="b2b__media">
          {%- if section.settings.image != blank -%}
            {%- render 'image', image: section.settings.image, sizes: '(min-width: 990px) 50vw, 100vw', widths: '480, 640, 800, 1000, 1200, 1500', alt: section.settings.image_alt -%}
          {%- else -%}
            {%- render 'fallback-image', key: section.settings.fallback_image, alt: section.settings.image_alt -%}
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="b2b__content">
        <p class="eyebrow b2b__eyebrow">{%- render 'icon', icon: 'case', class: 'icon--xs' -%}{{ section.settings.eyebrow }}</p>
        <h2 class="b2b__title" id="Title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="b2b__text text-lg">{{ section.settings.text }}</div>{%- endif -%}
        {%- if b2b_has_media and section.blocks.size > 0 -%}{{ b2b_list }}{%- endif -%}
        <div class="btn-row">
          {%- if section.settings.button_1_label != blank -%}<a class="btn" href="{{ section.settings.button_1_link | default: settings.quote_page }}">{{ section.settings.button_1_label }}</a>{%- endif -%}
          {%- if section.settings.button_2_label != blank -%}<a class="btn btn--outline" href="{{ section.settings.button_2_link | default: settings.b2b_page }}">{{ section.settings.button_2_label }}</a>{%- endif -%}
        </div>
      </div>
      {%- unless b2b_has_media -%}{{ b2b_list }}{%- endunless -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Zakelijk-banner",
  "class": "section-b2b-banner",
  "max_blocks": 6,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurschema", "default": "scheme-4" },
    { "type": "text", "id": "eyebrow", "label": "Bovenregel", "default": "Klapklaar Zakelijk" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Voor horeca, evenementen, verhuur en verenigingen" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Prijzen excl. btw, staffelprijzen bij grotere aantallen en een offerte op maat.</p>", "info": "Noem 'op factuur' pas als je factuurbetaling hebt (factuur-app of Shopify B2B), of zet erbij dat het via een offerte gaat." },
    { "type": "text", "id": "button_1_label", "label": "Knop 1", "default": "Offerte aanvragen" },
    { "type": "url", "id": "button_1_link", "label": "Link knop 1" },
    { "type": "text", "id": "button_2_label", "label": "Knop 2", "default": "Meer over zakelijk" },
    { "type": "url", "id": "button_2_link", "label": "Link knop 2" },
    { "type": "header", "content": "Beeld (optioneel)" },
    { "type": "image_picker", "id": "image", "label": "Beeld", "info": "Bv. een zakelijke opstelling. Met beeld staan de voordelen als lijst onder de tekst." },
    { "type": "select", "id": "fallback_image", "label": "Standaardbeeld", "info": "Meegeleverde 3D-render, zichtbaar zolang er geen beeld gekozen is.", "options": [
        { "value": "none", "label": "Geen beeld" },
        { "value": "scene-zakelijk", "label": "Zakelijke opstelling" },
        { "value": "scene-hero", "label": "Tent met statafels" }
      ], "default": "none" },
    { "type": "text", "id": "image_alt", "label": "Beschrijving van het beeld (alt-tekst)" }
  ],
  "blocks": [
    { "type": "benefit", "name": "Voordeel", "settings": [
      { "type": "select", "id": "icon", "label": "Icoon", "options": [ { "value": "invoice", "label": "Factuur" }, { "value": "euro", "label": "Euro" }, { "value": "proof", "label": "Drukproef" }, { "value": "truck", "label": "Levering" }, { "value": "chat", "label": "Contact" }, { "value": "case", "label": "Zakelijk" }, { "value": "pallet", "label": "Pallet" } ], "default": "invoice" },
      { "type": "text", "id": "title", "label": "Titel", "default": "Offerte op maat" },
      { "type": "text", "id": "text", "label": "Toelichting" },
      { "type": "checkbox", "id": "vat_toggle", "label": "Met btw-schakelaar (Particulier / Zakelijk)", "default": false, "info": "Alleen bij Prijsweergave = schakelaar. Handig op mobiel, waar de schakelaar niet in de kopbalk past." },
      { "type": "text", "id": "text_excl", "label": "Toelichting als Zakelijk aan staat", "info": "Bv. 'Je ziet nu alle prijzen excl. btw'. Leeg = de gewone toelichting." }
    ] }
  ],
  "presets": [{ "name": "Zakelijk-banner", "blocks": [{ "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }] }]
}
{% endschema %}
