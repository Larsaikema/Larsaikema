{%- comment -%} Klapklaar Zakelijk call-to-action (Linnen / Polder, no festive flags, brand.md §6). {%- endcomment -%}
{{ 'section-b2b-banner.css' | asset_url | stylesheet_tag }}
<section class="section b2b color-{{ section.settings.color_scheme }}" aria-labelledby="Title-{{ section.id }}">
  <div class="page-width">
    <div class="b2b__panel">
      <div class="b2b__content">
        <p class="eyebrow b2b__eyebrow">{%- render 'icon', icon: 'case', class: 'icon--xs' -%}{{ section.settings.eyebrow }}</p>
        <h2 class="b2b__title" id="Title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="b2b__text text-lg">{{ section.settings.text }}</div>{%- endif -%}
        <div class="btn-row">
          {%- if section.settings.button_1_label != blank -%}<a class="btn" href="{{ section.settings.button_1_link | default: settings.quote_page }}">{{ section.settings.button_1_label }}</a>{%- endif -%}
          {%- if section.settings.button_2_label != blank -%}<a class="btn btn--outline" href="{{ section.settings.button_2_link | default: settings.b2b_page }}">{{ section.settings.button_2_label }}</a>{%- endif -%}
        </div>
      </div>
      <ul class="b2b__list" role="list">
        {%- for block in section.blocks -%}
          <li class="b2b__item" {{ block.shopify_attributes }}>
            <span class="b2b__icon">{%- render 'icon', icon: block.settings.icon -%}</span>
            <span><strong>{{ block.settings.title }}</strong>{%- if block.settings.text != blank -%}<span class="b2b__item-text">{{ block.settings.text }}</span>{%- endif -%}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Zakelijk-banner",
  "class": "section-b2b-banner",
  "max_blocks": 6,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurschema", "default": "scheme-4" },
    { "type": "text", "id": "eyebrow", "label": "Bovenregel", "default": "Klapklaar Zakelijk" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Voor horeca, events, verhuur en verenigingen" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Prijzen excl. btw, staffelkorting vanaf 10 stuks en een offerte op maat. Op factuur als je dat wilt.</p>" },
    { "type": "text", "id": "button_1_label", "label": "Knop 1", "default": "Offerte aanvragen" },
    { "type": "url", "id": "button_1_link", "label": "Link knop 1" },
    { "type": "text", "id": "button_2_label", "label": "Knop 2", "default": "Meer over zakelijk" },
    { "type": "url", "id": "button_2_link", "label": "Link knop 2" }
  ],
  "blocks": [
    { "type": "benefit", "name": "Voordeel", "settings": [
      { "type": "select", "id": "icon", "label": "Icoon", "options": [ { "value": "invoice", "label": "Factuur" }, { "value": "euro", "label": "Euro" }, { "value": "proof", "label": "Drukproef" }, { "value": "truck", "label": "Levering" }, { "value": "chat", "label": "Contact" }, { "value": "case", "label": "Zakelijk" }, { "value": "pallet", "label": "Pallet" } ], "default": "invoice" },
      { "type": "text", "id": "title", "label": "Titel", "default": "Op factuur" },
      { "type": "text", "id": "text", "label": "Toelichting" }
    ] }
  ],
  "presets": [{ "name": "Zakelijk-banner", "blocks": [{ "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }] }]
}
{% endschema %}
