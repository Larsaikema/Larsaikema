{
  "type": "header",
  "name": "Header-groep",
  "sections": {
    "announcement": {
      "type": "announcement-bar",
      "blocks": {
        "usp-levering": {
          "type": "usp",
          "disabled": true,
          "settings": {
            "icon": "truck",
            "text": "Snel in huis in NL & BE",
            "link": "shopify://pages/verzenden-en-bezorgen"
          }
        },
        "countdown": {
          "type": "countdown",
          "settings": {
            "text": "Uit voorraad op werkdagen vóór [besteltijd] besteld, dezelfde dag verzonden",
            "link": "shopify://pages/verzenden-en-bezorgen"
          }
        },
        "usp-offerte": {
          "type": "usp",
          "settings": {
            "icon": "invoice",
            "text": "Zakelijk? Offerte [reactietijd]",
            "link": "shopify://pages/offerte"
          }
        },
        "usp-bedenktijd": {
          "type": "usp",
          "settings": {
            "icon": "return",
            "text": "[bedenktijd] dagen bedenktijd (niet bij maatwerk)",
            "link": "shopify://pages/retourneren"
          }
        },
        "link-klantenservice": {
          "type": "link",
          "settings": {
            "label": "Klantenservice",
            "link": "shopify://pages/contact",
            "icon": "chat"
          }
        },
        "link-faq": {
          "type": "link",
          "settings": {
            "label": "Veelgestelde vragen",
            "link": "shopify://pages/veelgestelde-vragen",
            "icon": "none"
          }
        }
      },
      "block_order": [
        "usp-levering",
        "countdown",
        "usp-offerte",
        "usp-bedenktijd",
        "link-faq",
        "link-klantenservice"
      ],
      "settings": {
        "color_scheme": "scheme-5",
        "menu": "",
        "show_phone": true,
        "interval": 5
      }
    },
    "header": {
      "type": "header",
      "blocks": {
        "promo-statafels": {
          "type": "promo",
          "settings": {
            "menu_item": "Statafels",
            "image": "",
            "eyebrow": "Voor bedrijven",
            "heading": "Statafelrokken met jouw logo",
            "text": "Logo op één of twee kanten, of full colour rondom. Vanaf 1 stuk, staffelprijs vanaf 10.",
            "link": "shopify://collections/bedrukte-statafelhoezen",
            "link_label": "Bekijk de rokken",
            "fallback_image": "rok-logo"
          }
        },
        "promo-logo": {
          "type": "promo",
          "settings": {
            "menu_item": "Met jouw logo",
            "image": "",
            "eyebrow": "Drukproef vooraf",
            "heading": "Je eigen tent, met jouw logo",
            "text": "Luifel of dak bedrukt. Eerst je akkoord, dan drukken we.",
            "link": "shopify://pages/bedrukken",
            "link_label": "Zo werkt bedrukken",
            "fallback_image": "tent-logo"
          }
        },
        "promo-zakelijk": {
          "type": "promo",
          "settings": {
            "menu_item": "Zakelijk",
            "image": "",
            "eyebrow": "Klapklaar Zakelijk",
            "heading": "Offerte op maat",
            "text": "Voor je bedrijf, club of verhuur: grote aantallen, bedrukking en prijzen excl. btw in één voorstel.",
            "link": "shopify://pages/offerte",
            "link_label": "Offerte aanvragen",
            "fallback_image": "scene-zakelijk"
          }
        }
      },
      "block_order": [
        "promo-statafels",
        "promo-logo",
        "promo-zakelijk"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "menu": "main-menu",
        "sticky": "scroll-up",
        "show_quote": true,
        "show_contact": true
      }
    }
  },
  "order": [
    "announcement",
    "header"
  ]
}
