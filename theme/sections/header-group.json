{
  "type": "header",
  "name": "Header-groep",
  "sections": {
    "announcement": {
      "type": "announcement-bar",
      "blocks": {
        "usp-levering": {
          "type": "usp",
          "disabled": true,
          "settings": {
            "icon": "truck",
            "text": "Snel in huis in NL & BE",
            "link": "shopify://pages/verzenden-en-bezorgen"
          }
        },
        "countdown": {
          "type": "countdown",
          "settings": {
            "text": "Uit voorraad op werkdagen vóór [besteltijd] besteld, dezelfde dag verzonden",
            "link": "shopify://pages/verzenden-en-bezorgen"
          }
        },
        "usp-offerte": {
          "type": "usp",
          "settings": {
            "icon": "invoice",
            "text": "Offerte op maat [reactietijd]",
            "link": "shopify://pages/offerte"
          }
        },
        "usp-bedenktijd": {
          "type": "usp",
          "settings": {
            "icon": "return",
            "text": "[bedenktijd] dagen bedenktijd (niet bij maatwerk)",
            "link": "shopify://pages/retourneren"
          }
        },
        "link-klantenservice": {
          "type": "link",
          "settings": {
            "label": "Klantenservice",
            "link": "shopify://pages/contact",
            "icon": "chat"
          }
        },
        "link-faq": {
          "type": "link",
          "settings": {
            "label": "Veelgestelde vragen",
            "link": "shopify://pages/veelgestelde-vragen",
            "icon": "none"
          }
        }
      },
      "block_order": [
        "usp-levering",
        "countdown",
        "usp-offerte",
        "usp-bedenktijd",
        "link-faq",
        "link-klantenservice"
      ],
      "settings": {
        "color_scheme": "scheme-5",
        "show_phone": true,
        "interval": 5
      }
    },
    "header": {
      "type": "header",
      "blocks": {
        "promo-statafels": {
          "type": "promo",
          "settings": {
            "menu_item": "Statafels",
            "eyebrow": "Rokken & hoezen",
            "heading": "Stretchrok met topcover in 21 kleuren",
            "text": "Voor statafels met een blad van Ø 60–70 cm of Ø 80–85 cm. Staffelprijs vanaf 10 stuks.",
            "link": "shopify://collections/stretch-statafelrokken",
            "link_label": "Bekijk de stretchrokken",
            "fallback_image": "none",
            "image": "shopify://shop_images/statafelrok-stretch-met-topcover-60-70-cm-rood-foto.webp"
          }
        },
        "promo-logo": {
          "type": "promo",
          "settings": {
            "menu_item": "Meubilair",
            "eyebrow": "Transportkarren",
            "heading": "Per model de kar die past",
            "text": "Voor statafels, barkrukken, stoelen, bankettafels en biertafelsets.",
            "link": "shopify://collections/transportkarren",
            "link_label": "Bekijk de transportkarren",
            "fallback_image": "none",
            "image": "shopify://shop_images/transportkar-statafels-inklapbaar-groot-voor-15-statafels-foto.webp"
          }
        },
        "promo-zakelijk": {
          "type": "promo",
          "settings": {
            "menu_item": "Zakelijk",
            "eyebrow": "Klapklaar Zakelijk",
            "heading": "Offerte op maat",
            "text": "Voor je bedrijf, club of verhuur: grote aantallen en prijzen excl. btw in één voorstel.",
            "link": "shopify://pages/offerte",
            "link_label": "Offerte aanvragen",
            "fallback_image": "none",
            "image": "shopify://shop_images/statafel-stapelbaar-industrieel-70-x-70-cm-eiken-foto.webp"
          }
        }
      },
      "block_order": [
        "promo-statafels",
        "promo-logo",
        "promo-zakelijk"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "menu": "main-menu",
        "sticky": "scroll-up",
        "show_quote": true,
        "show_contact": true
      }
    }
  },
  "order": [
    "announcement",
    "header"
  ]
}
