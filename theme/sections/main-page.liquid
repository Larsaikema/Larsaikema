{{ 'section-pages.css' | asset_url | stylesheet_tag }}
<div class="page-width{% if section.settings.narrow %} page-width--text{% endif %}">
  <header class="page-head">
    {%- render 'breadcrumbs' -%}
    <h1>{{ page.title }}</h1>
  </header>
  <div class="page-body">
    <div class="rte">{{ page.content }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Pagina",
  "class": "section-main-page",
  "settings": [ { "type": "checkbox", "id": "narrow", "label": "Smalle kolom", "default": true } ]
}
{% endschema %}
