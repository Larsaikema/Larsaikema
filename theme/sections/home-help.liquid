{%- comment -%}
  Home: 'Hulp bij kiezen'. Left: guide links (maatadvies, verschil, productbladen) and the ways to ask a question, from
  the contact settings only (phone and WhatsApp appear when filled in, never invented). Right: the most asked questions as
  accordions with a link to the full FAQ page. [besteltijd] and [bedenktijd] in answers become the theme settings, so the
  homepage never contradicts the shop's own claims. No FAQPage JSON-LD here: the FAQ page carries it.
{%- endcomment -%}
{{ 'section-home-help.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign phone = settings.phone | default: shop.phone
  assign mail = settings.email | default: shop.email
  assign return_days = settings.return_days | append: ''
  assign cutoff = settings.cutoff_time | default: '14:00'
  assign contact_url = section.settings.contact_link | default: pages.contact.url
  capture contact_ok
    render 'link-exists', url: contact_url
  endcapture
  assign faq_url = section.settings.faq_link | default: pages['veelgestelde-vragen'].url
  capture faq_ok
    render 'link-exists', url: faq_url
  endcapture
  assign question_blocks = section.blocks | where: 'type', 'question'
-%}
<section class="section home-help color-{{ section.settings.color_scheme }}" aria-labelledby="Title-{{ section.id }}">
  <div class="page-width home-help__inner">
    <div class="home-help__guides">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="home-help__title" id="Title-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="home-help__text muted">{{ section.settings.text }}</p>{%- endif -%}
      {%- capture guide_items -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'guide' or block.settings.title == blank or block.settings.link == blank -%}{%- continue -%}{%- endif -%}
          {%- capture g_ok -%}{%- render 'link-exists', url: block.settings.link -%}{%- endcapture -%}
          {%- if g_ok != 'true' -%}{%- continue -%}{%- endif -%}
          <li {{ block.shopify_attributes }}>
            <a class="guide" href="{{ block.settings.link }}">
              <span class="guide__icon" aria-hidden="true">{%- render 'icon', icon: block.settings.icon -%}</span>
              <span class="guide__body">
                <span class="guide__title">{{ block.settings.title }}</span>
                {%- if block.settings.text != blank -%}<span class="guide__text">{{ block.settings.text }}</span>{%- endif -%}
              </span>
              {%- render 'icon', icon: 'chevron-right', class: 'icon--sm guide__arrow' -%}
            </a>
          </li>
        {%- endfor -%}
      {%- endcapture -%}
      {%- if guide_items != blank -%}<ul class="guides" role="list">{{ guide_items }}</ul>{%- endif -%}
      <div class="home-help__ask">
        <p class="home-help__ask-title">{%- if section.settings.ask_heading != blank -%}{{ section.settings.ask_heading }}{%- else -%}{{ 'faq.ask_title' | t }}{%- endif -%}</p>
        {%- if settings.openingstijden != blank -%}<p class="home-help__hours">{%- render 'icon', icon: 'clock', class: 'icon--xs' -%}<span><span class="visually-hidden">{{ 'general.opening_hours' | t }}: </span>{{ settings.openingstijden | newline_to_br }}</span></p>{%- endif -%}
        <div class="home-help__actions">
          {%- if contact_url != blank and contact_ok == 'true' -%}<a class="btn btn--sm" href="{{ contact_url }}">{%- render 'icon', icon: 'chat', class: 'icon--sm' -%}{{ 'faq.ask_cta' | t }}</a>{%- endif -%}
          {%- if phone != blank -%}<a class="btn btn--outline btn--sm" href="tel:{{ phone | remove: ' ' | remove: '-' }}">{%- render 'icon', icon: 'phone', class: 'icon--sm' -%}{{ phone }}</a>{%- endif -%}
          {%- if settings.whatsapp != blank -%}<a class="btn btn--outline btn--sm" href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">{%- render 'icon', icon: 'whatsapp', class: 'icon--sm' -%}{{ 'general.whatsapp' | t }}<span class="visually-hidden"> ({{ 'general.new_window' | t }})</span></a>{%- endif -%}
          {%- if mail != blank -%}<a class="link home-help__mail" href="mailto:{{ mail }}">{%- render 'icon', icon: 'mail', class: 'icon--sm' -%}{{ mail }}</a>{%- endif -%}
        </div>
      </div>
    </div>
    {%- if question_blocks.size > 0 -%}
      <div class="home-help__faq">
        {%- if section.settings.faq_heading != blank -%}<h3 class="home-help__faq-title">{{ section.settings.faq_heading }}</h3>{%- endif -%}
        <div class="home-help__list" data-accordion-group>
          {%- for block in question_blocks -%}
            {%- if block.settings.question == blank -%}{%- continue -%}{%- endif -%}
            {%- assign answer = block.settings.answer | replace: '[bedenktijd]', return_days | replace: '[besteltijd]', cutoff -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary><span>{{ block.settings.question | replace: '[besteltijd]', cutoff }}</span>{%- render 'icon', icon: 'plus' -%}</summary>
              <div class="accordion__body rte">{{ answer }}</div>
            </details>
          {%- endfor -%}
        </div>
        {%- if faq_url != blank and faq_ok == 'true' and section.settings.faq_link_label != blank -%}
          <a class="link home-help__all" href="{{ faq_url }}">{{ section.settings.faq_link_label }}{%- render 'icon', icon: 'arrow-right', class: 'icon--sm' -%}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hulp bij kiezen",
  "class": "section-home-help",
  "max_blocks": 14,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurschema", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Bovenregel", "default": "Hulp bij kiezen" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Twijfel je? We rekenen het voor je uit." },
    { "type": "text", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "ask_heading", "label": "Kop boven de contactknoppen", "default": "Staat je vraag er niet bij?" },
    { "type": "url", "id": "contact_link", "label": "Link 'Stel je vraag'", "info": "Leeg = de pagina 'contact'. Bellen en WhatsApp verschijnen vanzelf als je ze invult bij Thema-instellingen › Contact & bedrijf." },
    { "type": "header", "content": "Veelgestelde vragen" },
    { "type": "text", "id": "faq_heading", "label": "Kop boven de vragen", "default": "Veelgestelde vragen" },
    { "type": "url", "id": "faq_link", "label": "Link naar alle vragen", "info": "Leeg = de pagina 'veelgestelde-vragen'." },
    { "type": "text", "id": "faq_link_label", "label": "Linktekst", "default": "Alle veelgestelde vragen" },
    { "type": "paragraph", "content": "In een vraag of antwoord wordt [besteltijd] de besteltijd en [bedenktijd] het aantal dagen bedenktijd uit Thema-instellingen." }
  ],
  "blocks": [
    {
      "type": "guide", "name": "Hulplink",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icoon", "options": [
          { "value": "ruler", "label": "Maatgids" }, { "value": "table", "label": "Statafel" }, { "value": "tent", "label": "Tent" },
          { "value": "file", "label": "Document" }, { "value": "proof", "label": "Drukproef" }, { "value": "truck", "label": "Levering" },
          { "value": "wind", "label": "Wind" }, { "value": "peg", "label": "Haring" }, { "value": "case", "label": "Zakelijk" } ], "default": "ruler" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Welke maat partytent?" },
        { "type": "text", "id": "text", "label": "Eén regel uitleg" },
        { "type": "url", "id": "link", "label": "Link", "info": "Zonder werkende link wordt het blok niet getoond." }
      ]
    },
    {
      "type": "question", "name": "Vraag",
      "settings": [
        { "type": "text", "id": "question", "label": "Vraag", "default": "Wanneer heb ik mijn bestelling?" },
        { "type": "richtext", "id": "answer", "label": "Antwoord", "default": "<p>Op elke productpagina zie je de verwachte leverdatum.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Hulp bij kiezen", "blocks": [{ "type": "guide" }, { "type": "guide" }, { "type": "question" }, { "type": "question" }] }]
}
{% endschema %}
