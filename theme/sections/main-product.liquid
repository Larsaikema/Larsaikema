{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'media-gallery.js' | asset_url }}" defer></script>
<script src="{{ 'variant-picker.js' | asset_url }}" defer></script>
<script src="{{ 'product-form.js' | asset_url }}" defer></script>
{%- if product.metafields.custom.configurator != blank -%}<script src="{{ 'product-configurator.js' | asset_url }}" defer></script>{%- endif -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign staffel = product.metafields.custom.staffelkorting.value
  assign is_print = false
  if product.metafields.custom.bedrukbaar.value == true or product.tags contains 'bedrukbaar'
    assign is_print = true
  endif
  assign druk = product.metafields.custom.drukopties.value
  # Print block follows the variant (feature product.print-option-reveal), see snippets/print-active.liquid
  capture print_state
    render 'print-active', product: product, variant: current_variant
  endcapture
  assign print_active = false
  if print_state == 'true'
    assign print_active = true
  endif
  assign cfg = product.metafields.custom.configurator.value
  assign is_config = false
  if cfg != blank and cfg.velden != blank
    assign is_config = true
  endif
  assign cfg_unit = cfg.eenheid | default: 'm²'
  assign is_maatwerk = false
  if cfg.maatwerk == true or product.metafields.custom.maatwerk.value == true
    assign is_maatwerk = true
  endif
  assign avail_status = product.metafields.custom.availability_status.value | downcase | strip | replace: ' ', '-'
  assign is_discontinued = false
  if avail_status == 'permanent-uitverkocht'
    assign is_discontinued = true
  endif
  assign quote_url = settings.quote_page | default: '/pages/offerte'
  # the Zakelijk nudge opens the inline offerte form when the section has one (block 'quote_form')
  assign nudge_url = quote_url | append: '?product=' | append: product.handle | append: '&variant=' | append: current_variant.id
  for b in section.blocks
    if b.type == 'quote_form'
      assign nudge_url = '#ProductQuote'
    endif
  endfor
  assign featured_index = 0
  for media in product.media
    if media.id == current_variant.featured_media.id
      assign featured_index = forloop.index0
    endif
  endfor
-%}
<product-info class="product section" id="ProductInfo-{{ section.id }}" data-section-id="{{ section.id }}" data-product-url="{{ product.url }}" data-form-id="{{ product_form_id }}">
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}{%- render 'breadcrumbs' -%}{%- endif -%}
    <div class="product__grid">
      {%- comment -%} ---------- media gallery ---------- {%- endcomment -%}
      <div class="product__media">
        <media-gallery class="gallery" data-start="{{ featured_index }}" aria-label="{{ 'product.gallery_label' | t }}">
          <div class="gallery__viewer">
            <ul class="gallery__slides" role="list" data-gallery-slides>
              {%- for media in product.media -%}
                <li class="gallery__slide" data-media-id="{{ media.id }}" data-index="{{ forloop.index0 }}">
                  <button type="button" class="gallery__zoom" data-gallery-zoom="{{ forloop.index0 }}" aria-label="{{ 'product.gallery_zoom' | t: index: forloop.index }}">
                    {%- assign m_alt = media.alt | default: product.title -%}
                    {%- if forloop.index0 == featured_index -%}
                      {%- render 'image', image: media.preview_image, sizes: '(min-width: 990px) min(56vw, 760px), (min-width: 750px) 48vw, 100vw', widths: '390, 560, 760, 900, 1100, 1400', priority: true, alt: m_alt -%}
                    {%- else -%}
                      {%- render 'image', image: media.preview_image, sizes: '(min-width: 990px) min(56vw, 760px), (min-width: 750px) 48vw, 100vw', widths: '390, 560, 760, 900, 1100, 1400', alt: m_alt -%}
                    {%- endif -%}
                  </button>
                </li>
              {%- else -%}
                <li class="gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</li>
              {%- endfor -%}
            </ul>
            {%- if product.media.size > 1 -%}
              <button type="button" class="gallery__arrow gallery__arrow--prev icon-btn" data-gallery-prev aria-label="{{ 'general.previous' | t }}">{%- render 'icon', icon: 'chevron-left' -%}</button>
              <button type="button" class="gallery__arrow gallery__arrow--next icon-btn" data-gallery-next aria-label="{{ 'general.next' | t }}">{%- render 'icon', icon: 'chevron-right' -%}</button>
              <p class="gallery__counter" aria-hidden="true"><span data-gallery-current>{{ featured_index | plus: 1 }}</span> / {{ product.media.size }}</p>
            {%- endif -%}
            <div class="gallery__badges">
              {%- if current_variant.compare_at_price > current_variant.price -%}
                {%- assign save_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
                <span class="badge badge--actie" data-dynamic="badge-sale">{{ 'price.save' | t: percent: save_pct }}</span>
              {%- else -%}
                <span data-dynamic="badge-sale" hidden></span>
              {%- endif -%}
              {%- if product.tags contains 'badge:nieuw' -%}<span class="badge badge--nieuw">{{ 'card.badge_new' | t }}</span>{%- endif -%}
              {%- if is_print -%}<span class="badge badge--logo">{%- render 'icon', icon: 'upload' -%}{{ 'card.badge_logo' | t }}</span>{%- endif -%}
            </div>
          </div>
          {%- if product.media.size > 1 -%}
            <ul class="gallery__thumbs" role="list">
              {%- for media in product.media -%}
                <li>
                  <button type="button" class="gallery__thumb" data-gallery-thumb="{{ forloop.index0 }}" aria-label="{{ 'product.gallery_thumb' | t: index: forloop.index }}"{% if forloop.index0 == featured_index %} aria-current="true"{% endif %}>
                    {{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '', widths: '90, 180', sizes: '90px' }}
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <dialog class="modal zoom" aria-label="{{ product.title | escape }}" data-gallery-dialog>
            <button type="button" class="icon-btn zoom__close" data-drawer-close aria-label="{{ 'product.gallery_close' | t }}">{%- render 'icon', icon: 'close' -%}</button>
            <ul class="zoom__list" role="list">
              {%- for media in product.media -%}
                <li data-zoom-index="{{ forloop.index0 }}">{{ media.preview_image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: media.alt, widths: '1000, 1400, 2000', sizes: 'min(1100px, 100vw)' }}</li>
              {%- endfor -%}
            </ul>
          </dialog>
        </media-gallery>
      </div>

      {%- comment -%} ---------- product info ---------- {%- endcomment -%}
      <div class="product__info">
        <div class="product__info-inner">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}

              {%- when 'title' -%}
                <div class="product__title-block" {{ block.shopify_attributes }}>
                  {%- assign eyebrow = product.type -%}
                  {%- if collection -%}{%- assign eyebrow = collection.title -%}{%- endif -%}
                  {%- if eyebrow != blank -%}<p class="eyebrow product__eyebrow">{{ eyebrow }}</p>{%- endif -%}
                  <h1 class="product__title">{{ product.title | replace: ' × ', ' × ' }}</h1>
                  {%- if product.metafields.custom.kenmerk_kort != blank -%}<p class="product__spec">{{ product.metafields.custom.kenmerk_kort.value }}</p>{%- endif -%}
                  {%- if is_discontinued -%}<p class="status-label status-label--out">{{ 'product.status_discontinued' | t }}</p>{%- elsif avail_status == 'binnenkort' -%}<p class="status-label status-label--later">{{ 'product.status_coming' | t }}</p>{%- endif -%}
                  {%- render 'rating', product: product, show_count: true -%}
                </div>

              {%- when 'price' -%}
                <div class="product__price-block" {{ block.shopify_attributes }}>
                  <div id="price-{{ section.id }}" data-dynamic="price">
                    {%- if is_config -%}
                      {%- render 'price', product: product, variant: current_variant, size: 'lg', unit: cfg_unit -%}
                    {%- else -%}
                      {%- render 'price', product: product, variant: current_variant, size: 'lg' -%}
                    {%- endif -%}
                    {%- render 'bundle-components', product: product, variant: current_variant, mode: 'savings' -%}
                  </div>
                  {%- if settings.price_display == 'toggle' -%}
                    <vat-toggle class="vat-toggle vat-toggle--mini" role="group" aria-label="{{ 'header.vat_toggle' | t }}">
                      <button type="button" data-vat-set="incl" aria-pressed="true">{{ 'price.incl' | t }}</button>
                      <button type="button" data-vat-set="excl" aria-pressed="false">{{ 'price.excl' | t }}</button>
                    </vat-toggle>
                  {%- endif -%}
                </div>

              {%- when 'variant_picker' -%}
                {%- if product.has_only_default_variant == false or product.metafields.custom.andere_maten != blank -%}
                  {%- render 'product-variant-picker', product: product, block: block, section_id: section.id, is_print: is_print -%}
                {%- endif -%}

              {%- when 'bundle' -%}
                <div class="product__bundle" data-dynamic="bundle" {{ block.shopify_attributes }}>
                  {%- render 'bundle-components', product: product, variant: current_variant -%}
                </div>

              {%- when 'configurator' -%}
                {%- if is_config -%}
                  {%- render 'product-configurator', product: product, block: block, section_id: section.id, form_id: product_form_id, cfg: cfg, cfg_unit: cfg_unit, current_variant: current_variant, is_maatwerk: is_maatwerk -%}
                {%- endif -%}

              {%- when 'included' -%}
                {%- assign inc = product.metafields.custom.included.value -%}
                {%- assign exc = product.metafields.custom.excluded.value -%}
                {%- if inc != blank or exc != blank -%}
                  <div class="included" {{ block.shopify_attributes }}>
                    <p class="included__title">{%- render 'icon', icon: 'box', class: 'icon--sm' -%}{% if block.settings.heading != blank %}{{ block.settings.heading }}{% else %}{{ 'product.included_title' | t }}{% endif %}</p>
                    <ul class="included__list" role="list">
                      {%- for x in inc -%}<li class="included__item">{%- render 'icon', icon: 'check', class: 'icon--sm' -%}<span><span class="visually-hidden">{{ 'product.included_label' | t }}: </span>{{ x }}</span></li>{%- endfor -%}
                      {%- for x in exc -%}<li class="included__item included__item--no">{%- render 'icon', icon: 'minus', class: 'icon--sm' -%}<span><span class="visually-hidden">{{ 'product.excluded_label' | t }}: </span>{{ x }}</span></li>{%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}

              {%- when 'staffel' -%}
                {%- if staffel != blank and staffel.size > 0 -%}
                  <div class="staffel" data-dynamic="staffel" data-staffel="{{ staffel | json | escape }}" data-unit-price="{{ current_variant.price }}" {{ block.shopify_attributes }}>
                    <p class="staffel__title">{%- render 'icon', icon: 'euro', class: 'icon--sm' -%}{{ 'product.staffel_title' | t }}</p>
                    <table class="staffel__table">
                      <thead><tr><th scope="col">{{ 'product.staffel_qty' | t }}</th><th scope="col">{{ 'product.staffel_discount' | t }}</th><th scope="col">{{ 'product.staffel_price' | t }}</th></tr></thead>
                      <tbody>
                        {%- assign first_tier = staffel.first.vanaf | minus: 1 -%}
                        <tr data-tier-min="1"><td>1–{{ first_tier }}</td><td>–</td><td>{%- render 'staffel-price', cents: current_variant.price -%}</td></tr>
                        {%- for tier in staffel -%}
                          {%- assign tier_off = current_variant.price | times: tier.korting | divided_by: 100.0 | round -%}
                          {%- assign tier_cents = current_variant.price | minus: tier_off -%}
                          <tr data-tier-min="{{ tier.vanaf }}">
                            <td>{{ 'product.staffel_from' | t: qty: tier.vanaf }}</td>
                            <td>{{ tier.korting }}%</td>
                            <td>{%- render 'staffel-price', cents: tier_cents -%}</td>
                          </tr>
                        {%- endfor -%}
                      </tbody>
                    </table>
                    <p class="staffel__hint" data-staffel-hint aria-live="polite"></p>
                    {%- case settings.staffel_mode -%}
                      {%- when 'automatic' -%}
                        <p class="staffel__note text-xs muted">{{ 'product.staffel_note' | t }}</p>
                      {%- when 'quote' -%}
                        <p class="staffel__note text-xs muted">{{ 'product.staffel_note_quote' | t }} <a class="link" href="{{ quote_url }}?product={{ product.handle }}&amp;variant={{ current_variant.id }}">{{ 'product.quote_cta' | t }}</a></p>
                    {%- endcase -%}
                  </div>
                {%- endif -%}

              {%- when 'bedrukken' -%}
                {%- if is_print -%}
                  {%- render 'product-print', product: product, block: block, section_id: section.id, form_id: product_form_id, print_active: print_active, druk: druk -%}
                {%- endif -%}

              {%- when 'addons' -%}
                {%- comment -%}
                  Add-ons per selected variant: custom.addon_varianten (list.variant_reference) + custom.addon_aantallen on the
                  variant, so a 3 x 6 m tent offers the 3 x 6 m side walls and 'Set van 6' foot weights. Fallback: the product
                  list custom.addons (first available variant, 1 each). The add-on quantity follows the main quantity, except
                  for per-meter products (custom.addon_modus = 'per-regel') and configurator products. Swapped on variant change
                  by product-form.js (data-dynamic="addons", ticked add-ons stay ticked per add-on product).
                {%- endcomment -%}
                {%- liquid
                  assign addon_vs = current_variant.metafields.custom.addon_varianten.value
                  assign addon_qs = current_variant.metafields.custom.addon_aantallen.value
                  assign addons = product.metafields.custom.addons.value
                  assign addon_follow = true
                  if product.metafields.custom.addon_modus.value == 'per-regel' or is_config
                    assign addon_follow = false
                  endif
                  assign addon_n = 0
                  if addon_vs != blank
                    assign addon_n = addon_vs.size
                  elsif addons != blank
                    assign addon_n = addons.size
                  endif
                -%}
                <div class="addons-slot" data-dynamic="addons" {{ block.shopify_attributes }}>
                {%- if addon_n > 0 -%}
                  <fieldset class="addons" data-addon-follow="{{ addon_follow }}">
                    <legend class="addons__legend">{% if block.settings.heading != blank %}{{ block.settings.heading }}{% else %}{{ 'product.addons_title' | t }}{% endif %}</legend>
                    <p class="addons__help text-sm muted">{{ 'product.addons_help' | t }}</p>
                    <ul class="addons__list" role="list">
                      {%- if addon_vs != blank -%}
                        {%- assign addon_list = addon_vs -%}
                      {%- else -%}
                        {%- assign addon_list = addons -%}
                      {%- endif -%}
                      {%- for item in addon_list -%}
                        {%- liquid
                          if addon_vs != blank
                            assign av = item
                            assign addon = item.product
                            assign aq = addon_qs[forloop.index0] | default: 1
                          else
                            assign addon = item
                            assign av = item.selected_or_first_available_variant
                            assign aq = 1
                          endif
                          if addon == blank or av == blank or av.available == false
                            continue
                          endif
                          assign a_price = av.price | times: aq
                          assign a_img = av.featured_image | default: addon.featured_media.preview_image
                        -%}
                        <li>
                          <label class="addon" for="Addon-{{ section.id }}-{{ forloop.index }}">
                            <input class="addon__check" type="checkbox" id="Addon-{{ section.id }}-{{ forloop.index }}" value="{{ av.id }}" data-addon data-price="{{ av.price }}" data-qty="{{ aq }}" data-product="{{ addon.id }}" data-title="{{ addon.title | escape }}">
                            <span class="addon__media">{%- if a_img -%}{{ a_img | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', widths: '60, 120', sizes: '56px' }}{%- endif -%}</span>
                            <span class="addon__text">
                              <span class="addon__title">{% if aq > 1 %}{{ aq }} × {% endif %}{{ addon.title }}</span>
                              {%- unless addon.has_only_default_variant -%}<span class="addon__variant text-sm">{{ av.title }}</span>{%- endunless -%}
                              {%- if addon.metafields.custom.kenmerk_kort != blank -%}<span class="addon__spec">{{ addon.metafields.custom.kenmerk_kort.value }}</span>{%- endif -%}
                            </span>
                            <span class="addon__price">+&nbsp;{%- render 'vat-money', cents: a_price -%}</span>
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </fieldset>
                {%- endif -%}
                </div>

              {%- when 'buy_buttons' -%}
                {%- render 'product-buy', product: product, block: block, section_id: section.id, form_id: product_form_id, current_variant: current_variant, is_config: is_config, cfg: cfg, avail_status: avail_status, is_discontinued: is_discontinued, print_active: print_active, druk: druk, is_maatwerk: is_maatwerk -%}

              {%- when 'delivery' -%}
                {%- unless is_discontinued -%}
                  <div class="product__delivery" data-dynamic="delivery" {{ block.shopify_attributes }}>
                    {%- render 'delivery-promise', product: product, variant: current_variant, style: 'full', print_active: print_active -%}
                  </div>
                {%- endunless -%}

              {%- when 'usps' -%}
                {%- assign usps = product.metafields.custom.usps.value -%}
                {%- assign past_op = product.metafields.custom.past_op.value -%}
                {%- comment -%}
                  The fallback list holds shop promises (levering, bedenktijd). They contradict 'Binnenkort leverbaar',
                  'Permanent uitverkocht' or sold out, so they only show while the product can be ordered.
                {%- endcomment -%}
                {%- assign usp_fallback = block.settings.fallback -%}
                {%- if product.available == false or is_discontinued or avail_status == 'binnenkort' -%}
                  {%- assign usp_fallback = blank -%}
                {%- endif -%}
                {%- if usps != blank or usp_fallback != blank or past_op != blank or product.metafields.custom.garantie != blank -%}
                  <div class="product__usps" {{ block.shopify_attributes }}>
                    <ul class="checklist" role="list">
                      {%- if usps != blank -%}
                        {%- for u in usps -%}<li>{%- render 'icon', icon: 'check' -%}<span>{{ u }}</span></li>{%- endfor -%}
                      {%- else -%}
                        {%- assign fb = usp_fallback | newline_to_br | split: '<br />' -%}
                        {%- for u in fb -%}{%- assign us = u | strip -%}{%- if us != blank -%}<li>{%- render 'icon', icon: 'check' -%}<span>{{ us }}</span></li>{%- endif -%}{%- endfor -%}
                      {%- endif -%}
                      {%- if product.metafields.custom.garantie != blank -%}<li>{%- render 'icon', icon: 'shield' -%}<span>{{ product.metafields.custom.garantie.value }}</span></li>{%- endif -%}
                    </ul>
                    {%- if past_op != blank -%}
                      <p class="product__fits text-sm"><strong>{{ 'product.compatible' | t }}:</strong>{% for p in past_op %} <a class="link" href="{{ p.url }}">{{ p.title }}</a>{% unless forloop.last %},{% endunless %}{% endfor %}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'b2b' -%}
                {%- if is_discontinued -%}{%- continue -%}{%- endif -%}
                <div class="product__b2b" {{ block.shopify_attributes }}>
                  {%- render 'icon', icon: 'case' -%}
                  <p>
                    {%- if settings.b2b_nudge_text contains '?' -%}
                      <strong>{{ settings.b2b_nudge_text | split: '?' | first }}?</strong> {{ settings.b2b_nudge_text | split: '?' | last | strip }}
                    {%- else -%}
                      {{ settings.b2b_nudge_text }}
                    {%- endif %}
                    <a class="link" href="{{ nudge_url }}"{% if nudge_url == '#ProductQuote' %} data-open-details{% endif %}>{{ settings.b2b_cta_label }}</a>
                  </p>
                </div>

              {%- when 'text' -%}
                <div class="product__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

              {%- when 'collapsible_tab' -%}
                {%- render 'product-tab', product: product, block: block, current_variant: current_variant -%}

              {%- when 'quote_form' -%}
                {%- unless is_discontinued -%}
                  {%- render 'product-quote', product: product, block: block, section_id: section.id, current_variant: current_variant -%}
                {%- endunless -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  {%- if section.settings.sticky_bar and is_discontinued == false -%}
    <div class="sticky-buy" data-sticky-buy aria-hidden="true">
      <div class="page-width sticky-buy__inner">
        <div class="sticky-buy__info">
          <span class="sticky-buy__title">{{ product.title }}</span>
          <span class="sticky-buy__variant" data-dynamic="sticky-variant">{% unless product.has_only_default_variant %}{{ current_variant.title }}{% endunless %}</span>
        </div>
        <div class="sticky-buy__price" data-dynamic="sticky-price">{%- if is_config -%}{%- render 'price', product: product, variant: current_variant, unit: cfg_unit -%}{%- else -%}{%- render 'price', product: product, variant: current_variant -%}{%- endif -%}</div>
        <button type="submit" form="{{ product_form_id }}" class="btn btn--buy sticky-buy__btn" tabindex="-1" data-sticky-add{% unless current_variant.available %} disabled{% endunless %}>{%- render 'icon', icon: 'cart', class: 'icon--sm' -%}<span>{{ 'product.sticky_buy' | t }}</span></button>
      </div>
    </div>
  {%- endif -%}
</product-info>

{% schema %}
{
  "name": "Productinformatie",
  "class": "section-main-product",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Kruimelpad tonen", "default": true },
    { "type": "checkbox", "id": "sticky_bar", "label": "Vaste koopbalk op mobiel", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "Titel en spec-regel", "limit": 1, "settings": [] },
    { "type": "price", "name": "Prijs", "limit": 1, "settings": [] },
    { "type": "variant_picker", "name": "Varianten", "limit": 1, "settings": [
      { "type": "page", "id": "size_guide_page", "label": "Standaard maatgids-pagina", "info": "Per product te vervangen met custom.maatgids. De link staat alleen bij de maat-optie." },
      { "type": "text", "id": "size_option_names", "label": "Namen van maat-opties", "default": "Maat, Tafelmaat, Diameter, Afmeting, Formaat" }
    ] },
    { "type": "bundle", "name": "Pakketinhoud", "limit": 1, "settings": [ { "type": "paragraph", "content": "Leest custom.componenten (lijst van varianten) en custom.component_aantallen per variant, of op productniveau. Toont de onderdelen en wat je bespaart ten opzichte van de losse prijzen." } ] },
    { "type": "configurator", "name": "Maatwerk-configurator", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Leest custom.configurator (JSON: velden, keuzes, eenheid, min_afname, tolerantie, maatwerk). De variantprijs is de prijs per eenheid (bv. per m²)." },
      { "type": "text", "id": "heading", "label": "Kop", "default": "Jouw maat" }
    ] },
    { "type": "included", "name": "Wat zit erin", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Leest custom.included en custom.excluded (lijsten met tekst)." },
      { "type": "text", "id": "heading", "label": "Kop", "default": "Wat zit erin" }
    ] },
    { "type": "staffel", "name": "Staffelkorting", "limit": 1, "settings": [ { "type": "paragraph", "content": "Leest product.metafields.custom.staffelkorting. De echte korting stel je in als automatische korting." } ] },
