<script src="{{ 'media-gallery.js' | asset_url }}" defer></script>
<script src="{{ 'variant-picker.js' | asset_url }}" defer></script>
{%- assign media_types = product.media | map: 'media_type' | uniq | join: ',' -%}
{%- if media_types contains 'video' or media_types contains 'model' -%}<script src="{{ 'product-media.js' | asset_url }}" defer></script>{%- endif %}
{%- if product.metafields.custom.bedrukbaar.value == true or product.tags contains 'bedrukbaar' -%}<script src="{{ 'product-print.js' | asset_url }}" defer></script>{%- endif %}
<script src="{{ 'product-form.js' | asset_url }}" defer></script>
{%- if product.metafields.custom.configurator != blank -%}<script src="{{ 'product-configurator.js' | asset_url }}" defer></script>{%- endif -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign staffel = product.metafields.custom.staffelkorting.value
  assign is_print = false
  if product.metafields.custom.bedrukbaar.value == true or product.tags contains 'bedrukbaar'
    assign is_print = true
  endif
  assign druk = product.metafields.custom.drukopties.value
  # Print block follows the variant (feature product.print-option-reveal), see snippets/print-active.liquid
  capture print_state
    render 'print-active', product: product, variant: current_variant
  endcapture
  assign print_active = false
  if print_state == 'true'
    assign print_active = true
  endif
  assign cfg = product.metafields.custom.configurator.value
  assign is_config = false
  if cfg != blank and cfg.velden != blank
    assign is_config = true
  endif
  assign cfg_unit = cfg.eenheid | default: 'm²'
  assign is_maatwerk = false
  if cfg.maatwerk == true or product.metafields.custom.maatwerk.value == true
    assign is_maatwerk = true
  endif
  assign avail_status = product.metafields.custom.availability_status.value | downcase | strip | replace: ' ', '-'
  assign is_discontinued = false
  if avail_status == 'permanent-uitverkocht'
    assign is_discontinued = true
  endif
  assign quote_url = settings.quote_page | default: '/pages/offerte'
  # the Zakelijk nudge opens the inline offerte form when the section has one (block 'quote_form')
  assign nudge_url = quote_url | append: '?product=' | append: product.handle | append: '&variant=' | append: current_variant.id
  # staffel in quote mode carries the Zakelijk / offerte route itself (snippets/product-staffel), so the separate
  # Zakelijk nudge ('Vanaf 10 stuks ...') is left out there: one offerte message, no clashing quantities
  assign staffel_quote = false
  for b in section.blocks
    if b.type == 'quote_form'
      assign nudge_url = '#ProductQuote'
    elsif b.type == 'staffel' and staffel.size > 0 and settings.staffel_mode == 'quote'
      assign staffel_quote = true
    endif
  endfor
  # Long content (description, specs, downloads, FAQ, 'Wat zit erin', offerte) goes in a full-width band under the
  # product grid (desktop: two columns aligned with gallery and buy column), so the buy column stays short.
  # key facts: under the photo from 990 px; on smaller screens after the delivery block (or in the title block)
  assign kf_labels = ''
  assign kf_after_delivery = false
  # 'Wat zit erin' (block 'included') sits next to the description: the description's own 'Wat je krijgt' section is
  # then left out (product-tab, strip_included), so the contents are not listed twice side by side
  assign strip_inc = false
  for b in section.blocks
    case b.type
      when 'title'
        if b.settings.show_keyfacts
          assign kf_labels = b.settings.keyfacts
        endif
      when 'delivery'
        assign kf_after_delivery = true
      when 'included'
        assign strip_inc = true
    endcase
  endfor
  if is_discontinued
    assign kf_after_delivery = false
  endif
  assign details_below = section.settings.details_below
  assign details_types = 'collapsible_tab,included,quote_form,compare' | split: ','
  assign featured_index = 0
  for media in product.media
    if media.id == current_variant.featured_media.id
      assign featured_index = forloop.index0
    endif
  endfor
-%}
{%- render 'product-styles', product: product, is_print: is_print, is_config: is_config, is_discontinued: is_discontinued, avail_status: avail_status, media_types: media_types %}
<product-info class="product section" id="ProductInfo-{{ section.id }}" data-section-id="{{ section.id }}" data-product-url="{{ product.url }}" data-form-id="{{ product_form_id }}">
  <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-variant-live></p>
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}{%- render 'breadcrumbs' -%}{%- endif -%}
    <div class="product__grid">
      {%- comment -%} ---------- media gallery ---------- {%- endcomment -%}
      <div class="product__media">
        <media-gallery class="gallery" data-start="{{ featured_index }}" role="region" aria-label="{{ 'product.gallery_label' | t }}">
          <div class="gallery__viewer">
            <ul class="gallery__slides" role="list" data-gallery-slides>
              {%- for media in product.media -%}
                <li class="gallery__slide gallery__slide--{{ media.media_type }}" data-media-id="{{ media.id }}" data-index="{{ forloop.index0 }}">
                  {%- render 'product-media', media: media, product: product, featured_index: featured_index, index: forloop.index0 -%}
                </li>
              {%- else -%}
                <li class="gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</li>
              {%- endfor -%}
            </ul>
            {%- if product.media.size > 1 -%}
              <button type="button" class="gallery__arrow gallery__arrow--prev icon-btn" data-gallery-prev aria-label="{{ 'general.previous' | t }}">{%- render 'icon', icon: 'chevron-left' -%}</button>
              <button type="button" class="gallery__arrow gallery__arrow--next icon-btn" data-gallery-next aria-label="{{ 'general.next' | t }}">{%- render 'icon', icon: 'chevron-right' -%}</button>
              <p class="gallery__counter" aria-hidden="true"><span data-gallery-current>{{ featured_index | plus: 1 }}</span> / {{ product.media.size }}</p>
            {%- endif -%}
            <div class="gallery__badges">
              {%- if current_variant.compare_at_price > current_variant.price -%}
                {%- assign save_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
                <span class="badge badge--actie" data-dynamic="badge-sale">{{ 'price.save' | t: percent: save_pct }}</span>
              {%- else -%}
                <span data-dynamic="badge-sale" hidden></span>
              {%- endif -%}
              {%- if product.tags contains 'badge:nieuw' -%}<span class="badge badge--nieuw">{{ 'card.badge_new' | t }}</span>{%- endif -%}
              {%- if is_print -%}<span class="badge badge--logo">{%- render 'icon', icon: 'upload' -%}{{ 'card.badge_logo' | t }}</span>{%- endif -%}
            </div>
          </div>
          {%- if product.media.size > 1 -%}
            <ul class="gallery__thumbs" role="list">
              {%- for media in product.media -%}
                <li>
                  <button type="button" class="gallery__thumb" data-gallery-thumb="{{ forloop.index0 }}" data-media-type="{{ media.media_type }}" aria-label="{{ 'product.gallery_thumb' | t: index: forloop.index }}"{% if forloop.index0 == featured_index %} aria-current="true"{% endif %}>
                    {{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '', widths: '90, 180', sizes: '90px' }}
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <dialog class="modal zoom" aria-label="{{ product.title | replace: ' x ', ' × ' | escape }}" data-gallery-dialog>
            <button type="button" class="icon-btn zoom__close" data-drawer-close aria-label="{{ 'product.gallery_close' | t }}">{%- render 'icon', icon: 'close' -%}</button>
            <ul class="zoom__list" role="list">
              {%- for media in product.media -%}
                {%- if media.media_type != 'image' -%}{%- continue -%}{%- endif -%}
                <li data-zoom-index="{{ forloop.index0 }}">{{ media.preview_image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: media.alt, widths: '1000, 1400, 2000', sizes: 'min(1100px, 100vw)' }}</li>
              {%- endfor -%}
            </ul>
          </dialog>
        </media-gallery>
        {%- comment -%} key facts: under the photo from 990 px (the title block holds the copy for smaller screens) {%- endcomment -%}
        {%- if kf_labels != blank -%}{%- render 'product-keyfacts', product: product, labels: kf_labels, class: 'keyfacts--media' -%}{%- endif -%}
      </div>

      {%- comment -%} ---------- product info ---------- {%- endcomment -%}
      <div class="product__info">
        <div class="product__info-inner">
          {%- for block in section.blocks -%}
            {%- if details_below -%}
              {%- assign bt = block.type -%}
              {%- if details_types contains bt -%}{%- continue -%}{%- endif -%}
            {%- endif -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}

              {%- when 'title' -%}
                <div class="product__title-block" {{ block.shopify_attributes }}>
                  {%- assign eyebrow = product.type -%}
                  {%- if collection -%}{%- assign eyebrow = collection.title -%}{%- endif -%}
                  {%- if eyebrow != blank -%}<p class="eyebrow product__eyebrow">{{ eyebrow }}</p>{%- endif -%}
                  <h1 class="product__title">{{ product.title | replace: ' x ', ' × ' | replace: ' × ', ' × ' }}</h1>
                  {%- if product.metafields.custom.kenmerk_kort != blank -%}<p class="product__spec">{{ product.metafields.custom.kenmerk_kort.value }}</p>{%- endif -%}
                  {%- if block.settings.show_keyfacts and kf_after_delivery == false -%}{%- render 'product-keyfacts', product: product, labels: block.settings.keyfacts, class: 'keyfacts--info' -%}{%- endif -%}
                  {%- if is_discontinued -%}<p class="status-label status-label--out">{{ 'product.status_discontinued' | t }}</p>{%- elsif avail_status == 'binnenkort' -%}<p class="status-label status-label--later">{{ 'product.status_coming' | t }}</p>{%- endif -%}
                  {%- render 'rating', product: product, show_count: true -%}
                </div>

              {%- when 'price' -%}
                <div class="product__price-block" {{ block.shopify_attributes }}>
                  <div id="price-{{ section.id }}" data-dynamic="price">
                    {%- if is_config -%}
                      {%- render 'price', product: product, variant: current_variant, size: 'lg', unit: cfg_unit -%}
                    {%- else -%}
                      {%- render 'price', product: product, variant: current_variant, size: 'lg' -%}
                    {%- endif -%}
                    {%- render 'bundle-components', product: product, variant: current_variant, mode: 'savings' -%}
                  </div>
                  {%- if settings.price_display == 'toggle' -%}
                    <vat-toggle class="vat-toggle vat-toggle--mini" role="group" aria-label="{{ 'header.vat_toggle' | t }}">
                      <button type="button" data-vat-set="incl" aria-pressed="true">{{ 'price.incl' | t }}</button>
                      <button type="button" data-vat-set="excl" aria-pressed="false">{{ 'price.excl' | t }}</button>
                    </vat-toggle>
                  {%- endif -%}
                </div>

              {%- when 'variant_picker' -%}
                {%- if product.has_only_default_variant == false or product.metafields.custom.andere_maten != blank -%}
                  {%- render 'product-variant-picker', product: product, block: block, section_id: section.id, is_print: is_print -%}
                {%- endif -%}

              {%- when 'bundle' -%}
                <div class="product__bundle" data-dynamic="bundle" {{ block.shopify_attributes }}>
                  {%- render 'bundle-components', product: product, variant: current_variant -%}
                </div>

              {%- when 'configurator' -%}
                {%- if is_config -%}
                  {%- render 'product-configurator', product: product, block: block, section_id: section.id, form_id: product_form_id, cfg: cfg, cfg_unit: cfg_unit, current_variant: current_variant, is_maatwerk: is_maatwerk -%}
                {%- endif -%}

              {%- when 'included' -%}
                {%- render 'product-included', product: product, block: block -%}

              {%- when 'compare' -%}
                {%- render 'product-compare', product: product, block: block -%}

              {%- when 'staffel' -%}
                {%- render 'product-staffel', product: product, block: block, section_id: section.id, current_variant: current_variant, staffel: staffel, quote_url: quote_url, nudge_url: nudge_url, is_config: is_config, unit: cfg_unit -%}

              {%- when 'bedrukken' -%}
                {%- if is_print -%}
                  {%- render 'product-print', product: product, block: block, section_id: section.id, form_id: product_form_id, print_active: print_active, druk: druk -%}
                {%- endif -%}

              {%- when 'addons' -%}
                {%- render 'product-addons', product: product, block: block, section_id: section.id, current_variant: current_variant, is_config: is_config -%}

              {%- when 'buy_buttons' -%}
                {%- render 'product-buy', product: product, block: block, section_id: section.id, form_id: product_form_id, current_variant: current_variant, is_config: is_config, cfg: cfg, avail_status: avail_status, is_discontinued: is_discontinued, print_active: print_active, druk: druk, is_maatwerk: is_maatwerk -%}

              {%- when 'delivery' -%}
                {%- unless is_discontinued -%}
                  <div class="product__delivery" data-dynamic="delivery" {{ block.shopify_attributes }}>
                    {%- render 'delivery-promise', product: product, variant: current_variant, style: 'full', print_active: print_active -%}
                    {%- render 'product-delivery-pack', product: product, variant: current_variant -%}
                  </div>
                  {%- if kf_labels != blank -%}{%- render 'product-keyfacts', product: product, labels: kf_labels, class: 'keyfacts--info' -%}{%- endif -%}
                {%- endunless -%}

              {%- when 'usps' -%}
                {%- render 'product-usps', product: product, block: block, is_discontinued: is_discontinued, avail_status: avail_status -%}

              {%- when 'b2b' -%}
                {%- if is_discontinued or staffel_quote -%}{%- continue -%}{%- endif -%}
                <div class="product__b2b" {{ block.shopify_attributes }}>
                  {%- render 'icon', icon: 'case' -%}
                  <p>
                    {%- if settings.b2b_nudge_text contains '?' -%}
                      <strong>{{ settings.b2b_nudge_text | split: '?' | first }}?</strong> {{ settings.b2b_nudge_text | split: '?' | last | strip }}
                    {%- else -%}
                      {{ settings.b2b_nudge_text }}
                    {%- endif %}
                    <a class="link" href="{{ nudge_url }}"{% if nudge_url == '#ProductQuote' %} data-open-details{% endif %}>{{ settings.b2b_cta_label }}</a>
                  </p>
                </div>

              {%- when 'text' -%}
                <div class="product__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

              {%- when 'collapsible_tab' -%}
                {%- render 'product-tab', product: product, block: block, current_variant: current_variant -%}

              {%- when 'quote_form' -%}
                {%- unless is_discontinued -%}
                  {%- render 'product-quote', product: product, block: block, section_id: section.id, current_variant: current_variant -%}
                {%- endunless -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- if details_below -%}
      {%- comment -%}
        Details band: description (open) + the other tabs as accordions on the left, under the gallery; 'Wat zit erin',
        specifications and downloads on the right, under the buy column. Specs and downloads are accordions on phones
        and open cards from 990 px (data-open-desktop, variant-picker.js). Tab ids stay deep-linkable.
      {%- endcomment -%}
      {%- capture details_main -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'collapsible_tab' and block.settings.source == 'description' -%}
            {%- render 'product-tab', product: product, block: block, current_variant: current_variant, mode: 'panel', strip_included: strip_inc -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- capture details_side -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'included' -%}
              {%- render 'product-included', product: product, block: block -%}
            {%- when 'compare' -%}
              {%- render 'product-compare', product: product, block: block -%}
            {%- when 'collapsible_tab' -%}
              {%- if block.settings.source == 'specs' or block.settings.source == 'downloads' -%}
                {%- render 'product-tab', product: product, block: block, current_variant: current_variant, mode: 'card' -%}
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- capture details_more -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'collapsible_tab' -%}
              {%- unless block.settings.source == 'description' or block.settings.source == 'specs' or block.settings.source == 'downloads' -%}
                {%- render 'product-tab', product: product, block: block, current_variant: current_variant -%}
              {%- endunless -%}
            {%- when 'quote_form' -%}
              {%- unless is_discontinued -%}
                {%- render 'product-quote', product: product, block: block, section_id: section.id, current_variant: current_variant -%}
              {%- endunless -%}
          {%- endcase -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- assign dm = details_main | strip -%}
      {%- assign ds = details_side | strip -%}
      {%- assign dx = details_more | strip -%}
      {%- if dm != blank or ds != blank or dx != blank -%}
        <div class="pdp-details{% if ds == blank %} pdp-details--single{% endif %}">
          {%- if dm != blank -%}<div class="pdp-details__main">{{ dm }}</div>{%- endif -%}
          {%- if ds != blank -%}<div class="pdp-details__side">{{ ds }}</div>{%- endif -%}
          {%- if dx != blank -%}<div class="pdp-details__more">{{ dx }}</div>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- if section.settings.sticky_bar and is_discontinued == false -%}
    {%- comment -%}
      Sticky buy bar: shows whenever the main buy button is off screen (scrolled past, or still below the fold on a
      phone), never next to it (one buy button per screen, brand v7 4.2). Phones: a full-width bar; from 990 px a
      floating card with thumbnail, title, choice, price and the button.
    {%- endcomment -%}
    <div class="sticky-buy" data-sticky-buy aria-hidden="true">
      <div class="page-width sticky-buy__inner">
        <span class="sticky-buy__media" data-dynamic="sticky-media" aria-hidden="true">
          {%- assign sb_img = current_variant.featured_media.preview_image | default: product.featured_media.preview_image -%}
          {%- if sb_img -%}{{ sb_img | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', widths: '60, 120', sizes: '52px' }}{%- endif -%}
        </span>
        <div class="sticky-buy__info">
          <span class="sticky-buy__title">{{ product.title | replace: ' x ', ' × ' | replace: ' × ', ' × ' }}</span>
          <span class="sticky-buy__variant" data-dynamic="sticky-variant">{% unless product.has_only_default_variant %}{{ current_variant.title | replace: ' x ', ' × ' }}{% endunless %}</span>
          {%- comment -%} the delivery block's stock / lead-time line, so the bar never adds to the cart without it {%- endcomment -%}
          <div class="sticky-buy__stock" data-dynamic="sticky-stock">{%- render 'delivery-promise', product: product, variant: current_variant, style: 'short', print_active: print_active -%}</div>
        </div>
        <div class="sticky-buy__price" data-dynamic="sticky-price">{%- if is_config -%}{%- render 'price', product: product, variant: current_variant, unit: cfg_unit -%}{%- else -%}{%- render 'price', product: product, variant: current_variant -%}{%- endif -%}</div>
        <button type="submit" form="{{ product_form_id }}" class="btn btn--buy sticky-buy__btn" tabindex="-1" data-sticky-add{% unless current_variant.available %} disabled{% endunless %}>{%- render 'icon', icon: 'cart', class: 'icon--sm' -%}<span data-sticky-label>{%- if current_variant.available == false -%}{{ 'product.sold_out' | t }}{%- elsif avail_status == 'pre-order' -%}{{ 'product.pre_order' | t }}{%- else -%}{{ 'product.sticky_buy' | t }}{%- endif -%}</span></button>
      </div>
    </div>
  {%- endif -%}
</product-info>

{% schema %}
{
  "name": "Productinformatie",
  "class": "section-main-product",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Kruimelpad tonen", "default": true },
    { "type": "checkbox", "id": "sticky_bar", "label": "Vaste koopbalk", "default": true, "info": "Verschijnt zodra de koopknop uit beeld is: op mobiel onderaan, op desktop als zwevende balk." },
    { "type": "checkbox", "id": "details_below", "label": "Beschrijving en specificaties onder het product", "default": true, "info": "Uitklapblokken, 'Wat zit erin' en het offerteformulier staan dan in een brede band onder foto en koopknop (desktop: twee kolommen). Uit: alles in de kolom naast de foto." }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "Titel en spec-regel", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_keyfacts", "label": "Kerncijfers tonen", "default": true, "info": "Een strook onder de titel met waarden uit custom.specificaties (bv. oppervlak, capaciteit). Verschijnt bij minstens twee gevonden waarden." },
      { "type": "text", "id": "keyfacts", "label": "Kerncijfers (labels uit de specificaties)", "default": "Oppervlak, Capaciteit, Doorloophoogte, Personen" }
    ] },
    { "type": "price", "name": "Prijs", "limit": 1, "settings": [] },
    { "type": "variant_picker", "name": "Varianten", "limit": 1, "settings": [
      { "type": "page", "id": "size_guide_page", "label": "Standaard maatgids-pagina", "info": "Per product te vervangen met custom.maatgids. De link staat alleen bij de maat-optie." },
      { "type": "text", "id": "size_option_names", "label": "Namen van maat-opties", "default": "Maat, Tafelmaat, Diameter, Afmeting, Formaat" },
      { "type": "checkbox", "id": "size_prices", "label": "Prijs onder elke maat tonen", "default": true }
    ] },
    { "type": "bundle", "name": "Pakketinhoud", "limit": 1, "settings": [ { "type": "paragraph", "content": "Leest custom.componenten (lijst van varianten) en custom.component_aantallen per variant, of op productniveau. Toont de onderdelen en wat je bespaart ten opzichte van de losse prijzen." } ] },
    { "type": "configurator", "name": "Maatwerk-configurator", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Leest custom.configurator (JSON: velden, keuzes, eenheid, min_afname, tolerantie, maatwerk). De variantprijs is de prijs per eenheid (bv. per m²)." },
      { "type": "text", "id": "heading", "label": "Kop", "default": "Jouw maat" }
    ] },
    { "type": "included", "name": "Wat zit erin", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Leest custom.included en custom.excluded (lijsten met tekst)." },
      { "type": "text", "id": "heading", "label": "Kop", "default": "Wat zit erin" }
    ] },
    { "type": "compare", "name": "Uitvoeringen vergelijken", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Toont de producten uit de gekozen collectie met dezelfde custom.vergelijk_groep (bv. Premium en Professional 3 × 3 m), met specregel, gewicht, garantie en prijs." },
      { "type": "collection", "id": "collection", "label": "Zoeken in collectie" },
      { "type": "text", "id": "heading", "label": "Kop", "default": "Welke uitvoering past bij jou?" },
      { "type": "url", "id": "link", "label": "Link naar de uitleg", "info": "Een link naar een artikel dat niet bestaat wordt verborgen." },
      { "type": "text", "id": "link_label", "label": "Linktekst", "default": "Lees het hele verschil" }
    ] },
