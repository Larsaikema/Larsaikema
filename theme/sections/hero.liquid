{{ 'section-hero.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign chip_product = section.settings.product
  # fallback: the first product of a collection, so the chip survives a renamed or missing product handle
  if chip_product == blank and section.settings.product_collection != blank
    assign chip_product = section.settings.product_collection.products.first
  endif
  capture b1_ok
    render 'link-exists', url: section.settings.button_1_link
  endcapture
  capture b2_ok
    render 'link-exists', url: section.settings.button_2_link
  endcapture
  assign chip_blocks = section.blocks | where: 'type', 'chip'
  assign size_blocks = section.blocks | where: 'type', 'size'
  assign is_first = false
  if section.index == 1 and section.location == 'template'
    assign is_first = true
  endif
-%}
<section class="hero color-{{ section.settings.color_scheme }} hero--{{ section.settings.layout }}{% if section.settings.compact %} hero--compact{% endif %}" aria-labelledby="HeroTitle-{{ section.id }}">
  <div class="page-width hero__inner">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow hero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if is_first -%}{%- assign h_tag = 'h1' -%}{%- else -%}{%- assign h_tag = 'h2' -%}{%- endif -%}
      {%- comment -%} *word* in the heading gets the luifelstreep (brand v7 4.2: an underline in the brand colour, never coloured text) {%- endcomment -%}
      <{{ h_tag }} class="h-display hero__title" id="HeroTitle-{{ section.id }}">
        {%- assign hparts = section.settings.heading | split: '*' -%}
        {%- for hp in hparts -%}{%- assign odd = forloop.index0 | modulo: 2 -%}{%- if odd == 1 -%}<span class="accent-line">{{ hp | escape }}</span>{%- else -%}{{ hp | escape }}{%- endif -%}{%- endfor -%}
      </{{ h_tag }}>
      {%- if section.settings.text != blank -%}<div class="hero__text text-lg">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
        <div class="btn-row hero__buttons">
          {%- if section.settings.button_1_label != blank and b1_ok == 'true' -%}<a class="btn" href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}">{{ section.settings.button_1_label }}{%- render 'icon', icon: 'arrow-right', class: 'icon--sm' -%}</a>{%- endif -%}
          {%- if section.settings.button_2_label != blank and b2_ok == 'true' -%}<a class="btn btn--outline" href="{{ section.settings.button_2_link | default: routes.collections_url }}">{{ section.settings.button_2_label }}</a>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.subline != blank -%}<div class="hero__subline">{{ section.settings.subline }}</div>{%- endif -%}
      {%- if chip_blocks.size > 0 -%}
        <ul class="hero__chips" role="list">
          {%- for block in chip_blocks -%}
            <li class="hero__chip" {{ block.shopify_attributes }}>{%- render 'icon', icon: block.settings.icon, class: 'icon--sm' -%}<span>{{ block.settings.text }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        {%- comment -%} Alt describes the image (brand: '[product], [kleur], [standpunt]'), never repeats the heading {%- endcomment -%}
        {%- assign hero_alt = section.settings.image_alt | default: section.settings.image.alt -%}
        {%- render 'image', image: section.settings.image, sizes: '(min-width: 990px) 58vw, 100vw', widths: '480, 640, 800, 1000, 1200, 1500, 1800', priority: is_first, alt: hero_alt, class: 'hero__img' -%}
      {%- else -%}
        {%- render 'fallback-image', key: section.settings.fallback_image, alt: section.settings.image_alt, class: 'hero__img', priority: is_first, placeholder: 'hero-apparel-1' -%}
      {%- endif -%}
      {%- if chip_product != blank -%}
        <a class="hero__product" href="{{ chip_product.url }}">
          <span class="hero__product-text">
            <span class="hero__product-title">{{ section.settings.product_label | default: chip_product.title }}</span>
            {%- if chip_product.metafields.custom.kenmerk_kort != blank -%}<span class="hero__product-spec">{{ chip_product.metafields.custom.kenmerk_kort.value }}</span>{%- endif -%}
          </span>
          <span class="hero__product-price">{%- render 'price', product: chip_product -%}</span>
          <span class="hero__product-go" aria-hidden="true">{%- render 'icon', icon: 'arrow-right', class: 'icon--sm' -%}</span>
        </a>
      {%- endif -%}
    </div>
    {%- comment -%}
      'Kies je maat': size shortcuts straight into the filtered collection (brand promise: maat eerst). Blocks with the same
      group name form one row; a block whose link points at a missing collection or page is left out.
    {%- endcomment -%}
    {%- liquid
      # distinct group names in block order ('-' = no group name)
      assign sz_list = ''
      for block in size_blocks
        assign sz_g = block.settings.group | strip | default: '-'
        assign sz_probe = '§' | append: sz_g | append: '§'
        assign sz_hay = '§' | append: sz_list | append: '§'
        unless sz_hay contains sz_probe
          if sz_list == ''
            assign sz_list = sz_g
          else
            assign sz_list = sz_list | append: '§' | append: sz_g
          endif
        endunless
      endfor
      assign sz_groups = sz_list | split: '§'
    -%}
    {%- capture size_rows -%}
      {%- for sz_group in sz_groups -%}
        {%- capture sz_items -%}
          {%- for block in size_blocks -%}
            {%- assign sz_bg = block.settings.group | strip | default: '-' -%}
            {%- if sz_bg != sz_group or block.settings.label == blank or block.settings.link == blank -%}{%- continue -%}{%- endif -%}
            {%- capture sz_ok -%}{%- render 'link-exists', url: block.settings.link -%}{%- endcapture -%}
            {%- if sz_ok != 'true' -%}{%- continue -%}{%- endif -%}
            <li {{ block.shopify_attributes }}><a class="chip hero__size" href="{{ block.settings.link }}">{%- if sz_group != '-' -%}<span class="visually-hidden">{{ sz_group }} </span>{%- endif -%}{{ block.settings.label }}</a></li>
          {%- endfor -%}
        {%- endcapture -%}
        {%- if sz_items != blank -%}
          <div class="hero__size-group">
            {%- if sz_group != '-' -%}<span class="hero__size-label" id="HeroSizeGroup-{{ section.id }}-{{ forloop.index }}">{{ sz_group }}</span>{%- endif -%}
            <ul class="hero__size-list" role="list"{% if sz_group != '-' %} aria-labelledby="HeroSizeGroup-{{ section.id }}-{{ forloop.index }}"{% endif %}>{{ sz_items }}</ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if size_rows != blank -%}
      <nav class="hero__sizes" aria-labelledby="HeroSizes-{{ section.id }}">
        <p class="hero__sizes-title" id="HeroSizes-{{ section.id }}">{%- render 'icon', icon: 'ruler', class: 'icon--xs' -%}<span>{{ section.settings.sizes_heading | default: 'Snel naar je maat' }}</span></p>
        {{ size_rows }}
      </nav>
    {%- endif -%}
  </div>
  {%- if section.settings.show_flags -%}<div class="divider-flags hero__flags" aria-hidden="true"></div>{%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "max_blocks": 16,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurschema", "default": "scheme-3" },
    {
      "type": "select", "id": "layout", "label": "Indeling",
      "options": [ { "value": "image-right", "label": "Beeld rechts" }, { "value": "image-left", "label": "Beeld links" } ],
      "default": "image-right"
    },
    { "type": "checkbox", "id": "compact", "label": "Compacte hoogte", "default": false },
    { "type": "image_picker", "id": "image", "label": "Beeld", "info": "3D-render of foto, minimaal 1800 px breed. Wordt met voorrang geladen (LCP)." },
    { "type": "select", "id": "fallback_image", "label": "Standaardbeeld", "info": "Meegeleverde 3D-render, zichtbaar zolang er geen beeld gekozen is.", "options": [
        { "value": "none", "label": "Geen (lege plek)" },
        { "value": "scene-hero", "label": "Tent met statafels" },
        { "value": "scene-zakelijk", "label": "Zakelijke opstelling" },
        { "value": "tent-logo", "label": "Partytent met logo" },
        { "value": "tent-front", "label": "Partytent met logo, vooraanzicht" },
        { "value": "rok-logo", "label": "Statafelrok met logo" }
      ], "default": "scene-hero" },
    { "type": "text", "id": "image_alt", "label": "Beschrijving van het beeld (alt-tekst)", "info": "Wat staat erop, bv. 'Rode easy-up partytent met twee statafels, schuin vooraanzicht'. Leeg = de alt-tekst uit Bestanden." },
    { "type": "text", "id": "eyebrow", "label": "Bovenregel" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Uitklappen. Neerzetten. *Feest.*", "info": "Zet één woord tussen *sterretjes* voor de luifelstreep eronder." },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Easy-up tenten, statafels met rokken, verlichting en meubilair. Voor je tuinfeest, je club of je evenement.</p>" },
    { "type": "text", "id": "button_1_label", "label": "Knop 1", "default": "Bekijk partytenten" },
    { "type": "url", "id": "button_1_link", "label": "Link knop 1" },
    { "type": "text", "id": "button_2_label", "label": "Knop 2", "default": "Naar statafels" },
    { "type": "url", "id": "button_2_link", "label": "Link knop 2" },
    { "type": "richtext", "id": "subline", "label": "Regel onder de knoppen", "default": "<p>Voor bedrijf, club of verhuur? <a href=\"/pages/offerte\">Vraag een offerte op maat aan.</a></p>" },
    { "type": "header", "content": "Productchip op het beeld" },
    { "type": "product", "id": "product", "label": "Product", "info": "Toont titel, spec-regel en de echte (vanaf-)prijs uit je catalogus." },
    { "type": "collection", "id": "product_collection", "label": "Of: eerste product uit collectie", "info": "Gebruikt als het product hierboven leeg is of niet (meer) bestaat." },
    { "type": "text", "id": "product_label", "label": "Titel op de chip" },
    { "type": "checkbox", "id": "show_flags", "label": "Vlaggenlijn onder de hero", "default": false },
    { "type": "header", "content": "Snel naar je maat" },
    { "type": "text", "id": "sizes_heading", "label": "Kop boven de maatknoppen", "default": "Snel naar je maat", "info": "Voeg blokken 'Maatknop' toe; blokken met dezelfde groep staan op één regel." }
  ],
  "blocks": [
    {
      "type": "chip", "name": "USP-chip",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icoon", "options": [
          { "value": "check", "label": "Vinkje" }, { "value": "truck", "label": "Levering" }, { "value": "invoice", "label": "Factuur" },
          { "value": "proof", "label": "Drukproef" }, { "value": "chat", "label": "Chat" }, { "value": "clock", "label": "Klok" }, { "value": "flag", "label": "Vlaggetje" } ], "default": "check" },
        { "type": "text", "id": "text", "label": "Tekst", "default": "Snel in huis" }
      ]
    },
    {
      "type": "size", "name": "Maatknop",
      "settings": [
        { "type": "text", "id": "group", "label": "Groep", "default": "Partytent", "info": "Bv. Partytent of Statafel. Blokken met dezelfde groep staan naast elkaar." },
        { "type": "text", "id": "label", "label": "Maat", "default": "3 × 3 m" },
        { "type": "url", "id": "link", "label": "Link", "info": "Bv. een collectie gefilterd op maat: /collections/partytenten?filter.v.option.maat=3+x+3+m" }
      ]
    }
  ],
  "presets": [{ "name": "Hero", "blocks": [{ "type": "chip" }, { "type": "chip" }] }]
}
{% endschema %}
