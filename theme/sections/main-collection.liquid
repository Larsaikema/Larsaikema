{{ 'section-main-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer></script>
{%- liquid
  assign per_page = section.settings.per_page
  assign intro = collection.metafields.custom.intro.value
  assign subs = collection.metafields.custom.subcollections.value
  assign seo = collection.metafields.custom.seo_tekst
  assign active_filters = 0
  for f in collection.filters
    assign active_filters = active_filters | plus: f.active_values.size
    if f.type == 'price_range'
      if f.min_value.value != nil or f.max_value.value != nil
        assign active_filters = active_filters | plus: 1
      endif
    endif
  endfor
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}
<div class="collection-head color-{{ section.settings.color_scheme }}">
  <div class="page-width collection-head__inner">
    {%- render 'breadcrumbs' -%}
    <div class="collection-head__text">
      <h1 class="collection-head__title">{{ collection.title }}</h1>
      {%- if intro != blank -%}
        <p class="collection-head__intro text-lg">{{ intro | newline_to_br }}</p>
      {%- elsif collection.description != blank and section.settings.show_description -%}
        <div class="collection-head__intro rte text-lg">{{ collection.description | strip_html | truncatewords: 40 }}</div>
      {%- endif -%}
      {%- assign kenmerken = collection.metafields.custom.kenmerken.value -%}
      {%- if kenmerken != blank -%}
        <ul class="collection-head__usps" role="list">
          {%- for k in kenmerken -%}<li>{%- render 'icon', icon: 'check', class: 'icon--sm' -%}{{ k }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    {%- comment -%} Sub-collection chips: custom.subcollections, else the children of this collection in the main menu {%- endcomment -%}
    {%- capture sub_chips -%}
      {%- if subs != blank -%}
        {%- for sc in subs -%}<a class="chip" href="{{ sc.url }}">{{ sc.title }}</a>{%- endfor -%}
      {%- else -%}
        {%- for l1 in section.settings.menu.links -%}
          {%- if l1.url == collection.url and l1.links != blank -%}
            {%- for l2 in l1.links -%}<a class="chip" href="{{ l2.url }}">{{ l2.title }}</a>{%- endfor -%}{%- break -%}
          {%- endif -%}
          {%- for l2 in l1.links -%}
            {%- if l2.url == collection.url and l2.links != blank -%}
              {%- for l3 in l2.links -%}<a class="chip" href="{{ l3.url }}">{{ l3.title }}</a>{%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- if sub_chips != blank -%}
      <nav class="collection-head__subs chips chips--scroll" aria-label="{{ 'collection.subcollections' | t }}">{{ sub_chips }}</nav>
    {%- endif -%}
  </div>
</div>

<facet-filters class="page-width collection section section--flush-top" data-section-id="{{ section.id }}" id="Collection-{{ section.id }}">
  <div class="collection__toolbar">
    {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
      <button type="button" class="btn btn--outline btn--sm collection__filter-btn" data-facets-open aria-controls="FilterDrawer-{{ section.id }}" aria-expanded="false">
        {%- render 'icon', icon: 'filter', class: 'icon--sm' -%}<span>{{ 'collection.filter' | t }}</span>{%- if active_filters > 0 -%}<span class="facet__badge" data-active-count>{{ active_filters }}</span>{%- endif -%}
      </button>
    {%- endif -%}
    <p class="collection__count" id="ProductCount-{{ section.id }}" role="status">{{ 'collection.products_count' | t: count: collection.products_count }}</p>
    {%- if section.settings.enable_sorting -%}
      <div class="collection__sort">
        <label for="SortBy-{{ section.id }}">{{ 'collection.sort_label' | t }}</label>
        <select class="select select--sm" id="SortBy-{{ section.id }}" name="sort_by" form="FacetsForm-{{ section.id }}" data-sort>
          {%- for option in collection.sort_options -%}
            {%- assign sort_key = option.value | replace: '-', '_' -%}
            {%- assign sort_label_key = 'collection.sort_options.' | append: sort_key -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ sort_label_key | t | default: option.name }}</option>
          {%- endfor -%}
        </select>
      </div>
    {%- endif -%}
  </div>

  <div class="collection__layout{% unless section.settings.enable_filtering and collection.filters.size > 0 %} collection__layout--full{% endunless %}">
    {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
      <aside class="facets-panel" id="FilterDrawer-{{ section.id }}" aria-label="{{ 'collection.filters' | t }}" data-facets-panel tabindex="-1">
        <div class="facets-panel__head">
          <h2 class="h3">{{ 'collection.filters' | t }}</h2>
          <button type="button" class="icon-btn" data-facets-close aria-label="{{ 'general.close' | t }}">{%- render 'icon', icon: 'close' -%}</button>
        </div>
        <div class="facets-panel__body" data-facets-body>
          {%- render 'facets', results: collection, section_id: section.id, open_count: 4 -%}
        </div>
        <div class="facets-panel__foot">
          <a class="btn btn--outline" href="{{ collection.url }}?sort_by={{ sort_by }}" data-facets-clear>{{ 'collection.clear_all' | t }}</a>
          <button type="button" class="btn" data-facets-close data-show-results>{{ 'collection.show_results' | t: count: collection.products_count }}</button>
        </div>
      </aside>
      <div class="facets-backdrop" data-facets-close hidden></div>
    {%- endif -%}

    <div class="collection__results" id="ProductGridContainer-{{ section.id }}" data-results>
      {%- if active_filters > 0 -%}
        <div class="active-filters" aria-label="{{ 'collection.filter_count' | t: count: active_filters }}">
          {%- for f in collection.filters -%}
            {%- for v in f.active_values -%}
              <a class="chip chip--active active-filters__pill" href="{{ v.url_to_remove }}" data-facet-link aria-label="{{ 'collection.remove_filter' | t: label: v.label | escape }}">{{ f.label }}: {{ v.label }}{%- render 'icon', icon: 'close', class: 'icon--xs' -%}</a>
            {%- endfor -%}
            {%- if f.type == 'price_range' -%}
              {%- if f.min_value.value != nil or f.max_value.value != nil -%}
                {%- assign pmin = f.min_value.value | default: 0 | money_without_trailing_zeros -%}
                {%- assign pmax = f.max_value.value | default: f.range_max | money_without_trailing_zeros -%}
                <a class="chip chip--active active-filters__pill" href="{{ f.url_to_remove }}" data-facet-link>{{ pmin }} – {{ pmax }}{%- render 'icon', icon: 'close', class: 'icon--xs' -%}</a>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <a class="link active-filters__clear" href="{{ collection.url }}?sort_by={{ sort_by }}" data-facet-link>{{ 'collection.clear_all' | t }}</a>
        </div>
      {%- endif -%}

      {%- paginate collection.products by per_page -%}
        {%- if collection.products.size > 0 -%}
          <ul class="grid product-grid" role="list" style="--cols: {{ section.settings.columns }}; --cols-tablet: 3">
            {%- for product in collection.products -%}
              <li>
                {%- assign card_priority = false -%}
                {%- if forloop.index <= 2 -%}{%- assign card_priority = true -%}{%- endif -%}
                {%- render 'product-card', product: product, priority: card_priority, sizes: '(min-width: 1200px) 320px, (min-width: 990px) 30vw, (min-width: 750px) 33vw, 50vw' -%}
              </li>
              {%- if forloop.index == section.settings.promo_position and section.settings.promo_heading != blank and paginate.current_page == 1 -%}
                <li class="product-grid__promo color-scheme-4">
                  <p class="eyebrow">{%- render 'icon', icon: 'case', class: 'icon--xs' -%} {{ section.settings.promo_eyebrow }}</p>
                  <p class="h3">{{ section.settings.promo_heading }}</p>
                  <p class="muted">{{ section.settings.promo_text }}</p>
                  <a class="btn btn--sm" href="{{ section.settings.promo_link | default: settings.quote_page }}">{{ section.settings.promo_label }}</a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- render 'pagination', paginate: paginate -%}
        {%- else -%}
          <div class="empty-state">
            {%- if active_filters > 0 -%}
              <h2 class="h3">{{ 'collection.no_results_title' | t }}</h2>
              <p class="muted">{{ 'collection.no_results_text' | t }}</p>
              <div class="btn-row"><a class="btn" href="{{ collection.url }}" data-facet-link>{{ 'collection.clear_all' | t }}</a></div>
            {%- else -%}
              <p class="muted">{{ 'collection.empty' | t }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</facet-filters>

{%- if seo != blank -%}
  <section class="section seo-text color-scheme-1" aria-labelledby="SeoTitle-{{ section.id }}">
    <div class="page-width page-width--text">
      <details class="seo-text__details">
        <summary class="seo-text__summary"><span class="h3" id="SeoTitle-{{ section.id }}">{{ 'collection.about' | t: title: collection.title }}</span>{%- render 'icon', icon: 'chevron-down' -%}</summary>
        <div class="rte seo-text__body">{{ seo | metafield_tag }}</div>
      </details>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Collectiepagina",
  "class": "section-main-collection",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurschema kop", "default": "scheme-1" },
    { "type": "range", "id": "per_page", "min": 8, "max": 48, "step": 4, "label": "Producten per pagina", "default": 24 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Kolommen desktop", "default": 3 },
    { "type": "checkbox", "id": "show_description", "label": "Collectiebeschrijving tonen als er geen intro is", "default": true },
    { "type": "link_list", "id": "menu", "label": "Menu voor subcategorieën", "default": "main-menu", "info": "Gebruikt als custom.subcollections leeg is." },
    { "type": "checkbox", "id": "enable_filtering", "label": "Filters", "default": true, "info": "Filters stel je in met de app Search & Discovery." },
    { "type": "checkbox", "id": "enable_sorting", "label": "Sorteren", "default": true },
    { "type": "header", "content": "Zakelijk-tegel in het raster" },
    { "type": "range", "id": "promo_position", "min": 0, "max": 12, "step": 1, "label": "Na product nr. (0 = uit)", "default": 5 },
    { "type": "text", "id": "promo_eyebrow", "label": "Bovenregel", "default": "Klapklaar Zakelijk" },
    { "type": "text", "id": "promo_heading", "label": "Kop", "default": "Meer dan 10 nodig?" },
    { "type": "text", "id": "promo_text", "label": "Tekst", "default": "Staffelprijs, prijzen excl. btw en een offerte op maat." },
    { "type": "text", "id": "promo_label", "label": "Knop", "default": "Offerte aanvragen" },
    { "type": "url", "id": "promo_link", "label": "Link" }
  ]
}
{% endschema %}
