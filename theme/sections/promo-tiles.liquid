{%- comment -%}
  Two (or three) promo panels side by side: pakketten (feature home.bundle-promo) and maatwerk such as the
  overkappingzeil op maat (home.maatwerk-teaser). Each panel is a Linnen beeldvlak, so the render (on Linnen) stands
  in it without a frame. The price line is the real lowest price of the chosen collection, or the price of the chosen
  product, incl. and excl. btw (html[data-vat] picks one); nothing is shown when neither is chosen.
{%- endcomment -%}
{{ 'section-promo-tiles.css' | asset_url | stylesheet_tag }}
{%- assign vat_factor = settings.vat_rate | plus: 100 -%}
<section class="section promo-tiles color-{{ section.settings.color_scheme }}"{% if section.settings.heading != blank %} aria-labelledby="Title-{{ section.id }}"{% else %} aria-label="{{ section.blocks.first.settings.heading | escape }}"{% endif %}>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-head"><h2 class="section-head__title" id="Title-{{ section.id }}">{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <ul class="promo-tiles__list" role="list" style="--count: {{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign pr = block.settings.product
          assign promo_url = block.settings.link
          if promo_url == blank and pr != blank
            assign promo_url = pr.url
          endif
          if promo_url == blank and c != blank
            assign promo_url = c.url
          endif
          assign promo_img = block.settings.image
          if promo_img == blank and pr != blank
            assign promo_img = pr.featured_image
          endif
          if promo_img == blank and c != blank
            assign promo_img = c.featured_image | default: c.image
          endif
          assign promo_price = nil
          assign promo_from = false
          if pr != blank
            assign promo_price = pr.price
            assign promo_from = pr.price_varies
          elsif c != blank
            for p in c.products limit: 50
              if promo_price == nil or p.price_min < promo_price
                assign promo_price = p.price_min
              endif
            endfor
            if c.products_count > 1
              assign promo_from = true
            endif
          endif
          if promo_price != nil
            if shop.taxes_included
              assign promo_incl = promo_price
              assign promo_excl = promo_price | times: 100.0 | divided_by: vat_factor | round
            else
              assign promo_excl = promo_price
              assign promo_incl = promo_price | times: vat_factor | divided_by: 100.0 | round
            endif
          endif
        -%}
        <li class="promo" {{ block.shopify_attributes }}>
          <div class="promo__content">
            {%- if block.settings.eyebrow != blank -%}<p class="eyebrow promo__eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
            <h3 class="promo__title">
              {%- if promo_url != blank -%}<a href="{{ promo_url }}" class="promo__link">{{ block.settings.heading }}</a>{%- else -%}{{ block.settings.heading }}{%- endif -%}
            </h3>
            {%- if block.settings.text != blank -%}<p class="promo__text">{{ block.settings.text }}</p>{%- endif -%}
            {%- if promo_price != nil -%}
              {%- liquid
                assign promo_from_t = ''
                if promo_from
                  assign promo_from_t = 'price.from' | t | append: ' '
                endif
                assign promo_unit_t = ''
                if block.settings.unit != blank
                  assign promo_unit_t = 'price.per_unit' | t: unit: block.settings.unit | prepend: ' '
                endif
              -%}
              <p class="promo__price">
                <span class="promo__price-main" data-vat-show="incl">{{ promo_from_t }}<strong>{{ promo_incl | money }}</strong>{{ promo_unit_t }} <span class="promo__vat">{{ 'price.incl' | t }}</span></span>
                <span class="promo__price-main" data-vat-show="excl">{{ promo_from_t }}<strong>{{ promo_excl | money }}</strong>{{ promo_unit_t }} <span class="promo__vat">{{ 'price.excl' | t }}</span></span>
                {%- if settings.price_show_secondary -%}
                  <span class="promo__price-alt" data-vat-show="incl">{{ promo_excl | money }} {{ 'price.excl' | t }}</span>
                  <span class="promo__price-alt" data-vat-show="excl">{{ promo_incl | money }} {{ 'price.incl' | t }}</span>
                {%- endif -%}
              </p>
            {%- endif -%}
            {%- if block.settings.button_label != blank and promo_url != blank -%}
              <span class="btn btn--outline btn--sm promo__btn" aria-hidden="true">{{ block.settings.button_label }}{%- render 'icon', icon: 'arrow-right', class: 'icon--sm' -%}</span>
            {%- endif -%}
          </div>
          <div class="promo__media">
            {%- if promo_img != blank -%}
              {%- render 'image', image: promo_img, sizes: '(min-width: 990px) 340px, 100vw', widths: '360, 480, 640, 800, 1000', alt: '' -%}
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Promotegels",
  "class": "section-promo-tiles",
  "max_blocks": 3,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurschema", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Kop (optioneel)" }
  ],
  "blocks": [
    {
      "type": "promo", "name": "Promotegel",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Bovenregel", "default": "Pakketten" },
        { "type": "text", "id": "heading", "label": "Kop", "default": "Alles voor je feest in één pakket" },
        { "type": "textarea", "id": "text", "label": "Tekst" },
        { "type": "collection", "id": "collection", "label": "Collectie", "info": "Link, beeld en de laagste prijs komen hieruit, tenzij je hieronder een product kiest." },
        { "type": "product", "id": "product", "label": "Of: product", "info": "Link, beeld en prijs van dit product." },
        { "type": "text", "id": "unit", "label": "Prijs per (optioneel)", "info": "Bijvoorbeeld 'm²' bij een zeil op maat." },
        { "type": "image_picker", "id": "image", "label": "Eigen beeld (optioneel)" },
        { "type": "url", "id": "link", "label": "Eigen link (optioneel)" },
        { "type": "text", "id": "button_label", "label": "Knoptekst", "default": "Bekijk de pakketten" }
      ]
    }
  ],
  "presets": [{ "name": "Promotegels", "blocks": [{ "type": "promo" }, { "type": "promo" }] }]
}
{% endschema %}
