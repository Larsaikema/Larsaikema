{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign phone = settings.phone | default: shop.phone
  assign phone_href = phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign email = settings.email | default: shop.email
  assign company = settings.company_name | default: shop.name
  assign socials = 'instagram,facebook,linkedin,youtube,tiktok,pinterest' | split: ','
  assign year = 'now' | date: '%Y'
  assign show_loc = false
  if section.settings.show_localization
    if localization.available_countries.size > 1 or localization.available_languages.size > 1
      assign show_loc = true
    endif
  endif
-%}
<footer class="footer color-{{ section.settings.color_scheme }}">
  {%- if section.settings.show_flags -%}<div class="divider-flags footer__flags" aria-hidden="true"></div>{%- endif -%}
  <div class="page-width footer__top" style="--footer-cols: {{ section.blocks.size | minus: 1 | at_least: 1 }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'brand' -%}
          <div class="footer__brand" {{ block.shopify_attributes }}>
            <a href="{{ routes.root_url }}" class="footer__logo" aria-label="{{ shop.name | escape }}">{%- render 'logo' -%}</a>
            {%- if block.settings.tagline != blank -%}<p class="footer__tagline">{{ block.settings.tagline }}</p>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="footer__text">{{ block.settings.text }}</div>{%- endif -%}
            {%- if section.settings.show_social -%}
              <ul class="footer__social" role="list">
                {%- for s in socials -%}
                  {%- assign key = 'social_' | append: s -%}
                  {%- if settings[key] != blank -%}
                    {%- assign social_label = 'general.social.' | append: s -%}
                    <li><a href="{{ settings[key] }}" class="icon-btn" target="_blank" rel="noopener" aria-label="{{ social_label | t }}">{%- render 'icon', icon: s -%}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- when 'contact' -%}
          <div class="footer__col footer__contact" {{ block.shopify_attributes }}>
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            <ul class="footer__contact-list" role="list">
              {%- if phone != blank -%}<li><a href="tel:{{ phone_href }}">{%- render 'icon', icon: 'phone', class: 'icon--sm' -%}{{ phone }}</a></li>{%- endif -%}
              {%- if settings.whatsapp != blank -%}<li><a href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">{%- render 'icon', icon: 'whatsapp', class: 'icon--sm' -%}{{ 'contact.whatsapp_cta' | t }}</a></li>{%- endif -%}
              {%- if email != blank -%}<li><a href="mailto:{{ email }}">{%- render 'icon', icon: 'mail', class: 'icon--sm' -%}{{ email }}</a></li>{%- endif -%}
            </ul>
            {%- if settings.openingstijden != blank -%}
              <p class="footer__hours"><span class="footer__label">{{ 'general.opening_hours' | t }}</span>{{ settings.openingstijden | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- when 'menu' -%}
          {%- if block.settings.menu != blank -%}
            <nav class="footer__col" aria-labelledby="FooterHeading-{{ block.id }}" {{ block.shopify_attributes }}>
              <details class="footer__details" open>
                <summary class="footer__heading" id="FooterHeading-{{ block.id }}">{{ block.settings.heading | default: block.settings.menu.title }}{%- render 'icon', icon: 'chevron-down', class: 'icon--sm' -%}</summary>
                <ul class="footer__links" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>
            </nav>
          {%- endif -%}
        {%- when 'newsletter' -%}
          <div class="footer__col footer__newsletter" {{ block.shopify_attributes }}>
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            {%- if block.settings.text != blank -%}<p class="footer__text">{{ block.settings.text }}</p>{%- endif -%}
            {%- form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="notice notice--success" role="status">{%- render 'icon', icon: 'check' -%}<span>{{ 'newsletter.success' | t }}</span></p>
              {%- else -%}
                <div class="newsletter-form__row">
                  <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'newsletter.label' | t }}</label>
                  <input class="input" type="email" id="FooterNewsletterEmail" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.label' | t }}"{% if form.errors %} aria-invalid="true" aria-describedby="FooterNewsletterError"{% endif %}>
                  <button type="submit" class="btn">{{ 'newsletter.button' | t }}</button>
                </div>
                {%- if form.errors -%}<p class="field__error" id="FooterNewsletterError">{{ 'forms.error_email' | t }}</p>{%- endif -%}
              {%- endif -%}
            {%- endform -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="footer__bottom">
    <div class="page-width footer__bottom-inner">
      <div class="footer__legal">
        <p class="footer__company">
          {{ 'footer.copyright' | t: year: year, shop: company }}
          {%- if settings.kvk != blank %}<span>{{ 'footer.kvk' | t: number: settings.kvk }}</span>{% endif -%}
          {%- if settings.btw_nummer != blank %}<span>{{ 'footer.btw' | t: number: settings.btw_nummer }}</span>{% endif -%}
          {%- if settings.address != blank %}<span>{{ settings.address | newline_to_br | replace: '<br />', ', ' }}</span>{% endif -%}
        </p>
        {%- if section.settings.legal_menu != blank -%}
          <ul class="footer__legal-links" role="list">
            {%- for link in section.settings.legal_menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      <div class="footer__meta">
        {%- if show_loc -%}
          {%- form 'localization', id: 'FooterLocalization', class: 'footer__localization' -%}
            {%- if localization.available_countries.size > 1 -%}
              <div class="footer__select">
                <label for="FooterCountry">{{ 'footer.country' | t }}</label>
                <select class="select" id="FooterCountry" name="country_code">
                  {%- for country in localization.available_countries -%}
                    <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }}</option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endif -%}
            {%- if localization.available_languages.size > 1 -%}
              <div class="footer__select">
                <label for="FooterLanguage">{{ 'footer.language' | t }}</label>
                <select class="select" id="FooterLanguage" name="language_code">
                  {%- for language in localization.available_languages -%}
                    <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endif -%}
            {%- comment -%} WCAG 3.2.2: changing a select never navigates by itself; the button applies the choice {%- endcomment -%}
            <button type="submit" class="btn btn--sm btn--outline footer__loc-submit">{{ 'footer.update' | t }}</button>
          {%- endform -%}
        {%- endif -%}
        {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
          <ul class="footer__payment" role="list" aria-label="{{ 'footer.payment' | t }}">
            {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>
<script>
  if (matchMedia('(max-width: 749px)').matches) document.querySelectorAll('.footer__details').forEach((d) => d.removeAttribute('open'));
</script>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "class": "section-footer",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurschema", "default": "scheme-5" },
    { "type": "checkbox", "id": "show_flags", "label": "Vlaggenlijn bovenaan", "default": false, "info": "Merkboek: de vlaggenlijn hoort niet op Polder. Alleen gebruiken met een licht kleurschema." },
    { "type": "link_list", "id": "legal_menu", "label": "Juridisch menu", "default": "footer", "info": "Bv. het menu 'footer-juridisch' met voorwaarden, privacy en cookies." },
    { "type": "checkbox", "id": "show_social", "label": "Social media tonen", "default": true },
    { "type": "checkbox", "id": "show_payment", "label": "Betaalmethoden tonen", "default": true },
    { "type": "checkbox", "id": "show_localization", "label": "Land- en taalkeuze tonen", "default": true }
  ],
  "blocks": [
    {
      "type": "brand", "name": "Merk", "limit": 1,
      "settings": [
        { "type": "text", "id": "tagline", "label": "Slogan", "default": "In één klap feestklaar." },
        { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Partytenten, statafels, rokken en alles eromheen. Voor je tuin, je club of je evenement.</p>" }
      ]
    },
    {
      "type": "contact", "name": "Contact", "limit": 1,
      "settings": [ { "type": "text", "id": "heading", "label": "Kop", "default": "Bel of app ons" } ]
    },
    {
      "type": "menu", "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Kop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "newsletter", "name": "Nieuwsbrief", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Kop", "default": "Eerst weten wanneer er actie is?" },
        { "type": "text", "id": "text", "label": "Tekst", "default": "Eén mail als er iets te vieren valt. Afmelden kan altijd." }
      ]
    }
  ]
}
{% endschema %}
