{{ 'section-pages.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign phone = settings.phone | default: shop.phone
  assign phone_href = phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign email = settings.email | default: shop.email
  assign form_id = 'ContactForm-' | append: section.id
-%}
<div class="page-width">
  <header class="page-head">
    {%- render 'breadcrumbs' -%}
    <h1>{{ section.settings.heading | default: page.title }}</h1>
    {%- if page.content != blank -%}<div class="page-head__intro rte text-lg">{{ page.content }}</div>{%- endif -%}
  </header>
  <div class="page-body split">
    <div class="panel">
      <h2 class="panel__title">{{ 'contact.title' | t }}</h2>
      <p class="muted">{{ settings.response_time }}</p>
      {%- form 'contact', id: form_id, class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="notice notice--success" role="status" tabindex="-1" autofocus>{%- render 'icon', icon: 'check' -%}<span><strong>{{ 'forms.contact_success' | t }}</strong></span></div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="notice notice--error" role="alert">{%- render 'icon', icon: 'alert' -%}<span><strong>{{ 'forms.error_heading' | t }}</strong>{% render 'form-errors', form: form %}</span></div>
          {%- endif -%}
          <div class="form-grid form-grid--2">
            <div class="field">
              <label class="field__label" for="CF-name">{{ 'forms.name' | t }} <span class="required" aria-hidden="true">*</span></label>
              <input class="input" id="CF-name" type="text" name="contact[name]" autocomplete="name" required value="{{ form.name }}">
            </div>
            <div class="field">
              <label class="field__label" for="CF-email">{{ 'forms.email' | t }} <span class="required" aria-hidden="true">*</span></label>
              <input class="input" id="CF-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
            </div>
            <div class="field">
              <label class="field__label" for="CF-phone">{{ 'forms.phone' | t }} <span class="muted">({{ 'general.optional' | t }})</span></label>
              <input class="input" id="CF-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
            </div>
            <div class="field">
              <label class="field__label" for="CF-order">{{ 'forms.order_number' | t }} <span class="muted">({{ 'general.optional' | t }})</span></label>
              <input class="input" id="CF-order" type="text" name="contact[Bestelnummer]">
            </div>
            <div class="field field--full">
              <label class="field__label" for="CF-body">{{ 'forms.message' | t }} <span class="required" aria-hidden="true">*</span></label>
              <textarea class="textarea" id="CF-body" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
            </div>
          </div>
          <div class="form-actions"><button type="submit" class="btn">{{ 'forms.send' | t }}</button></div>
          {%- if shop.privacy_policy -%}<p class="form-note">{{ 'forms.privacy_note_html' | t: url: shop.privacy_policy.url }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
    <aside class="panel panel--linnen" aria-labelledby="ContactInfo-{{ section.id }}">
      <h2 class="panel__title" id="ContactInfo-{{ section.id }}">{{ 'contact.info_title' | t }}</h2>
      <ul class="contact-list" role="list">
        {%- if phone != blank -%}<li><a href="tel:{{ phone_href }}">{%- render 'icon', icon: 'phone' -%}{{ phone }}</a></li>{%- endif -%}
        {%- if settings.whatsapp != blank -%}<li><a href="https://wa.me/{{ settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">{%- render 'icon', icon: 'whatsapp' -%}{{ 'contact.whatsapp_cta' | t }}</a></li>{%- endif -%}
        {%- if email != blank -%}<li><a href="mailto:{{ email }}">{%- render 'icon', icon: 'mail' -%}{{ email }}</a></li>{%- endif -%}
      </ul>
      <dl class="info-rows">
        {%- if settings.openingstijden != blank -%}<div><dt>{{ 'general.opening_hours' | t }}</dt><dd>{{ settings.openingstijden | newline_to_br }}</dd></div>{%- endif -%}
        {%- assign addr = settings.address | default: shop.address.summary -%}
        {%- if addr != blank and section.settings.show_address -%}<div><dt>{{ 'general.address' | t }}</dt><dd>{{ addr | newline_to_br }}</dd></div>{%- endif -%}
        {%- if settings.kvk != blank or settings.btw_nummer != blank -%}
          <div><dt>{{ settings.company_name | default: shop.name }}</dt><dd>{% if settings.kvk != blank %}{{ 'footer.kvk' | t: number: settings.kvk }}<br>{% endif %}{% if settings.btw_nummer != blank %}{{ 'footer.btw' | t: number: settings.btw_nummer }}{% endif %}</dd></div>
        {%- endif -%}
      </dl>
      {%- if section.settings.faq_link != blank -%}<p class="form-note"><a class="link" href="{{ section.settings.faq_link }}">{{ section.settings.faq_label }}</a></p>{%- endif -%}
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "Contact",
  "class": "section-page-contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop (standaard de paginatitel)" },
    { "type": "checkbox", "id": "show_address", "label": "Adres tonen", "default": true, "info": "Alleen als je een bezoekadres hebt." },
    { "type": "url", "id": "faq_link", "label": "Link naar veelgestelde vragen" },
    { "type": "text", "id": "faq_label", "label": "Linktekst", "default": "Eerst even de veelgestelde vragen bekijken?" }
  ]
}
{% endschema %}
