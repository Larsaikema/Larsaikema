+// Canvas texture from SVG path data (one-colour print artwork, e.g. the Klapklaar wordmark).
+// d: path data in a viewBox of vb=[w,h]; the artwork is fitted (contain) inside width x height
+// with fractional padding pad; everything else stays transparent (alphaTest in the material).
+export function svgPrintTexture({ d, vb, color = '#ffffff', width = 2048, height = 512, pad = 0.08, align = 'center' } = {}) {
+  const key = `svgprint:${d.length}:${d.slice(0, 40)}:${color}:${width}:${height}:${pad}:${align}`;
+  return cached(key, () => {
+    const c = document.createElement('canvas');
+    c.width = width; c.height = height;
+    const g = c.getContext('2d');
+    g.clearRect(0, 0, width, height);
+    const s = Math.min(width * (1 - 2 * pad) / vb[0], height * (1 - 2 * pad) / vb[1]);
+    const ox = align === 'left' ? width * pad : (width - vb[0] * s) / 2;
+    g.translate(ox, (height - vb[1] * s) / 2); g.scale(s, s);
+    g.fillStyle = color; g.fill(new Path2D(d));
+    const t = new THREE.CanvasTexture(c);
+    t.colorSpace = THREE.SRGBColorSpace; t.anisotropy = maxAniso;
+    t.wrapS = THREE.ClampToEdgeWrapping; t.wrapT = THREE.ClampToEdgeWrapping;
+    return t;
+  });
+}
