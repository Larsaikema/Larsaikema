{
  "$schema_note": "Klapklaar design tokens v4 (2026-10-17). 13 kleuren met één rol, kleurschema’s met hover/actief per schema, reproductiereferenties, Shopify font_picker-handles + fallbacks, radii, spacing, schaduwen, motion, componentstaten, logo- en faviconregels. Contrast en bronnen: brand.md.",
  "color": {
    "klaproos": {
      "value": "#C83812",
      "family": "merk & kopen",
      "role": "Het merkrood, alleen als vlak: de tent in het logo, het Klaproos-dakdoek en de primaire knop (In mijn winkelwagen, Afrekenen). Eén gevulde Klaproos-knop per kolom; nooit op productkaarten in een raster (daar is de Klaproos-tent zelf het rood). Als tekst alleen koppen ≥ 24 px op Zand of Wit."
    },
    "klaproos-donker": {
      "value": "#982A0E",
      "family": "merk & kopen",
      "role": "Alleen de ingedrukte stand (:active) van de primaire knop."
    },
    "zon": {
      "value": "#FFC23A",
      "family": "vlag & voordeel",
      "role": "De vlag: het vlaggetje (digitaal), de tent van het logo op Polder en Inkt, de Actie-badge en het actieprijs-label, altijd met Inkt-tekst. Nooit tekst op licht, nooit een melding of stip."
    },
    "polder": {
      "value": "#154F3E",
      "family": "vertrouwen & klaar",
      "role": "Donkere vlakken (utility-balk, footer), secundaire en Zakelijk-knop, en alles wat ‘klaar’ betekent: Op voorraad (stip), Toegevoegd (knop), succesmelding, de winkelwagen-stip in het favicon."
    },
    "inkt": {
      "value": "#1D2420",
      "family": "tekst",
      "role": "Tekst, koppen, links (onderstreept), omlijnde knop, focusring op licht, hover van de primaire knop op lichte schema’s, badge Met jouw logo."
    },
    "kiezel": {
      "value": "#5D625C",
      "family": "tekst",
      "role": "Secundaire tekst (specs, btw-regel, doorgestreepte van-prijs), randen van invoervelden, uitgeschakelde knop (stippelrand + label)."
    },
    "zand": {
      "value": "#FBF6EC",
      "family": "vlak",
      "role": "Paginaachtergrond; tekst, knop en focusring op Polder en Inkt."
    },
    "duin": {
      "value": "#F2E8D5",
      "family": "vlak",
      "role": "Warm vlak: heroband, chips, geneste kaarten."
    },
    "steen": {
      "value": "#EFEDE8",
      "family": "vlak",
      "role": "Koel, rustig vlak: achtergrond van elke productrender (naadloos met het beeldvlak van de kaart) én van Klapklaar Zakelijk, staffel- en specificatietabellen. Vervangt Linnen en Studio uit v3."
    },
    "wit": {
      "value": "#FFFFFF",
      "family": "vlak",
      "role": "Productkaarten, invoervelden, drawers en meldingen; label op Klaproos- en Polder-knoppen."
    },
    "lijn": {
      "value": "#E4D6BE",
      "family": "vlak",
      "role": "Decoratieve scheidingslijnen en de 1 px rand om meldingen (draagt geen informatie)."
    },
    "bordeaux": {
      "value": "#8A1538",
      "family": "fout",
      "role": "Fouten: kop, icoon en 4 px linkerrand van een foutmelding, tekst en rand van een veld met fout. Nooit een gevuld vlak, nooit een knop."
    },
    "oker": {
      "value": "#865800",
      "family": "wachten",
      "role": "Levertijd en let-op: ‘Leverbaar over 2–3 weken’ (tekst + halve stip), kop, icoon en linkerrand van een let-op-melding."
    }
  },
