{
  "$schema_note": "Klapklaar design tokens v5 (2026-10-17). 14 kleuren met één rol, kleurschema’s met rust/hover/ingedrukt/focus per schema, reproductiereferenties, Shopify font_picker-handles + fallbacks, radii, spacing, randen, schaduwen, motion, componentstaten, logo- en faviconregels. Uitleg: brand.md; maten en bronnen: technisch.md.",
  "color": {
    "klaproos": {
      "value": "#C83812",
      "family": "merk & kopen",
      "role": "Het merkrood, alleen als vlak: de tent in het logo, het Klaproos-dakdoek en de primaire knop (In mijn winkelwagen, Afrekenen). Eén gevulde Klaproos-knop per kolom; nooit op productkaarten in een raster (daar is de Klaproos-tent zelf het rood). Als tekst alleen koppen ≥ 24 px op Zand of Wit."
    },
    "klaproos-donker": {
      "value": "#982A0E",
      "family": "merk & kopen",
      "role": "Hover van de primaire knop (de knop blijft rood als je erop wijst) en, met een inzet-schaduw, de ingedrukte stand."
    },
    "zon": {
      "value": "#FFC23A",
      "family": "voordeel & accent",
      "role": "Actie-badge en actieprijs-label (altijd met Inkt-tekst), de tent van het logo op Polder en Inkt, de vlaggenlijn op Inkt. Nooit tekst op licht, nooit een melding of stip."
    },
    "polder": {
      "value": "#154F3E",
      "family": "vertrouwen & klaar",
      "role": "Donkere vlakken (utility-balk, footer), de Zakelijk-knop, en alles wat ‘klaar’ betekent: Op voorraad (stip), Toegevoegd (knop), succesmelding, de winkelwagen-stip in het favicon."
    },
    "polder-donker": {
      "value": "#0E3A2D",
      "family": "vertrouwen & klaar",
      "role": "Alleen hover en ingedrukt van de Polder-knop (Klapklaar Zakelijk)."
    },
    "inkt": {
      "value": "#1D2420",
      "family": "tekst",
      "role": "Tekst, koppen, links (onderstreept), omlijnde knop, focusring op licht, badge Met jouw logo."
    },
    "kiezel": {
      "value": "#5D625C",
      "family": "tekst",
      "role": "Secundaire tekst (specs, btw-regel, doorgestreepte van-prijs), randen van invoervelden, uitgeschakelde knop (stippelrand + label)."
    },
    "zand": {
      "value": "#FBF6EC",
      "family": "vlak",
      "role": "Paginaachtergrond; tekst, knop en focusring op Polder en Inkt."
    },
    "duin": {
      "value": "#F2E8D5",
      "family": "vlak",
      "role": "Warm vlak: heroband, chips, geneste kaarten."
    },
    "steen": {
      "value": "#EFEDE8",
      "family": "vlak",
      "role": "Koel, rustig vlak: achtergrond van elke productrender en van Klapklaar Zakelijk, staffel- en specificatietabellen. Staat altijd in een Wit kaart of heeft een 1 px Lijn-rand (ligt te dicht bij Zand om los te staan)."
    },
    "wit": {
      "value": "#FFFFFF",
      "family": "vlak",
      "role": "Productkaarten, invoervelden, drawers en meldingen; label op Klaproos- en Polder-knoppen."
    },
    "lijn": {
      "value": "#E4D6BE",
      "family": "vlak",
      "role": "Scheidingslijnen, de 1 px rand om kaarten, beeldvlakken en meldingen (draagt geen informatie)."
    },
    "bordeaux": {
      "value": "#8A1538",
      "family": "fout",
      "role": "Fouten: kop, icoon en 4 px linkerrand van een foutmelding, tekst en rand van een veld met fout. Nooit een gevuld vlak, nooit een knop."
    },
    "oker": {
      "value": "#865800",
      "family": "wachten",
      "role": "Levertijd en let-op: ‘Leverbaar over 2–3 weken’ (tekst + halve stip), kop, icoon en linkerrand van een let-op-melding."
    }
  },
