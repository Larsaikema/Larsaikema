{
  "$schema_note": "Klapklaar design tokens v2 (2026-10-17). Kleuren met rol, Shopify font_picker-handles + fallbacks, radii, spacing, schaduwen, motion. Contrast: zie brand.md.",
  "color": {
    "klaproos": {
      "value": "#BE3A1D",
      "role": "Merkrood. Dak in het logo, primaire knop (In mijn winkelwagen), merktent (Google Shopping-standaardbeeld). Als tekst alleen voor korte nadruk; gewone links zijn Inkt."
    },
    "klaproos-donker": {
      "value": "#9A2F17",
      "role": "Hover/ingedrukt van de primaire knop; rode tekst op Duin/Linnen als nadruk nodig is."
    },
    "zon": {
      "value": "#FFC23A",
      "role": "Accent: dak in het logo op donker, vlaggetje, Actie-badge (met Inkt-tekst), USP-vinkjes, focusring op donker. Nooit tekst of rand op lichte vlakken."
    },
    "polder": {
      "value": "#154F3E",
      "role": "Donkere vlakken (utility-balk, footer), secundaire knop, Op voorraad / Toegevoegd (met icoon), Zakelijk."
    },
    "inkt": {
      "value": "#1D2420",
      "role": "Tekst, koppen, outline-knoppen, links (onderstreept), focusring op licht."
    },
    "zand": {
      "value": "#FBF6EC",
      "role": "Paginaachtergrond (warmer dan wit, zodat witte kaarten loskomen)."
    },
    "duin": {
      "value": "#F2E8D5",
      "role": "Warme vlakken: heroband, chips, geneste kaarten."
    },
    "linnen": {
      "value": "#ECEEE8",
      "role": "Rustig koel vlak voor Zakelijk, offerte, staffels, specificatietabellen."
    },
    "studio": {
      "value": "#EFEDE8",
      "role": "Achtergrond van elke productrender en van het beeldvlak in productkaarten (naadloos)."
    },
    "wit": {
      "value": "#FFFFFF",
      "role": "Productkaarten, invoervelden, drawers."
    },
    "kiezel": {
      "value": "#5D625C",
      "role": "Secundaire tekst (specs, btw-regel, doorgestreepte van-prijs) en randen van invoervelden (>= 3:1)."
    },
    "lijn": {
      "value": "#E4D6BE",
      "role": "Decoratieve scheidingslijnen (geen informatiedragend element)."
    },
    "bordeaux": {
      "value": "#8C1D2B",
      "role": "Fouten: tekst, icoon en linkerrand van foutmeldingen, veldfouten. Nooit als gevuld knopvlak."
    },
    "foutroze": {
      "value": "#FBEAEA",
      "role": "Achtergrond van foutmeldingen."
    },
    "oker": {
      "value": "#865800",
      "role": "Voorraadstatus \"Leverbaar over 2-3 weken\" (tekst), naast een Zon-stip."
    },
    "okerlicht": {
      "value": "#FFF4DA",
      "role": "Achtergrond van let-op-meldingen (levertijd, drukproef nodig)."
    },
    "mos": {
      "value": "#E4EEE8",
      "role": "Achtergrond van succesmeldingen (Polder-tekst)."
    }
  },
