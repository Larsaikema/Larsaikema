{
  "$schema_note": "Klapklaar design tokens v3 (2026-10-17). Kleuren met één rol, reproductiereferenties, Shopify font_picker-handles + fallbacks, radii, spacing, schaduwen, motion, componentstaten. Contrast en bronnen: brand.md.",
  "color": {
    "klaproos": {
      "value": "#C83812",
      "family": "merk & kopen",
      "role": "Het merkrood. Alleen als vlak: dak in het logo, primaire knop (In mijn winkelwagen), het Klaproos-dakdoek. Als tekst alleen in koppen vanaf 24 px op Zand of Wit."
    },
    "klaproos-donker": {
      "value": "#982A0E",
      "family": "merk & kopen",
      "role": "Alleen de ingedrukte stand (:active) van de primaire knop."
    },
    "zon": {
      "value": "#FFC23A",
      "family": "feest & voordeel",
      "role": "De vlag: vlaggetje en dak van het logo op donker, Actie-badge en actieprijs-label (altijd met Inkt-tekst). Verder niets."
    },
    "polder": {
      "value": "#154F3E",
      "family": "vertrouwen",
      "role": "Donkere vlakken (utility-balk, footer), secundaire knop, Op voorraad / Toegevoegd (met icoon), Klapklaar Zakelijk."
    },
    "inkt": {
      "value": "#1D2420",
      "family": "tekst",
      "role": "Tekst, koppen, links (onderstreept), omlijnde knop, focusring op licht en de hover-stand van de primaire knop."
    },
    "kiezel": {
      "value": "#5D625C",
      "family": "tekst",
      "role": "Secundaire tekst (specs, btw-regel, doorgestreepte van-prijs) en randen van invoervelden (>= 3:1)."
    },
    "zand": {
      "value": "#FBF6EC",
      "family": "vlak",
      "role": "Paginaachtergrond (warmer dan wit, zodat witte kaarten loskomen); tekst en focusring op donker."
    },
    "duin": {
      "value": "#F2E8D5",
      "family": "vlak",
      "role": "Warme vlakken: heroband, chips, geneste kaarten."
    },
    "linnen": {
      "value": "#ECEEE8",
      "family": "vlak",
      "role": "Rustig koel vlak voor Zakelijk, offerte, staffels en specificatietabellen."
    },
    "studio": {
      "value": "#EFEDE8",
      "family": "vlak",
      "role": "Achtergrond van elke productrender en van het beeldvlak in productkaarten (naadloos)."
    },
    "wit": {
      "value": "#FFFFFF",
      "family": "vlak",
      "role": "Productkaarten, invoervelden, drawers; tekst op de primaire knop."
    },
    "lijn": {
      "value": "#E4D6BE",
      "family": "vlak",
      "role": "Decoratieve scheidingslijnen (draagt geen informatie)."
    },
    "bordeaux": {
      "value": "#8A1538",
      "family": "fout",
      "role": "Fouten: kop, icoon en linkerrand van foutmeldingen, veldfout-tekst en -rand. Nooit een gevuld vlak, nooit een knop."
    },
    "foutroze": {
      "value": "#FBEAEA",
      "family": "fout",
      "role": "Achtergrond van foutmeldingen."
    },
    "oker": {
      "value": "#865800",
      "family": "wachten",
      "role": "Levertijd en let-op: \"Leverbaar over 2–3 weken\" (tekst + stip), kop van let-op-meldingen."
    },
    "okerlicht": {
      "value": "#FFF4DA",
      "family": "wachten",
      "role": "Achtergrond van let-op-meldingen (drukproef nodig, levertijd)."
    },
    "mos": {
      "value": "#E4EEE8",
      "family": "vertrouwen",
      "role": "Achtergrond van succesmeldingen (Polder-tekst)."
    }
  },
